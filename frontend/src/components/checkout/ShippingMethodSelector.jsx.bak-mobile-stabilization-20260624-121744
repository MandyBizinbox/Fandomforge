import React, { useEffect, useMemo, useState } from "react";
import { http } from "../../lib/api";
import { Truck, CalendarDays, MapPin } from "lucide-react";

function money(value) {
  return Number(value || 0).toFixed(2);
}

function isValidEmail(value) {
  if (!value) return false;
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(value).trim());
}

function hasUsableShippingAddress(address = {}) {
  return Boolean(
    String(address.full_name || "").trim() &&
    isValidEmail(address.email) &&
    String(address.line1 || "").trim() &&
    String(address.city || "").trim() &&
    String(address.postal_code || "").trim() &&
    String(address.country || "ZA").trim()
  );
}

function normalizeApiError(error) {
  const detail = error?.response?.data?.detail;

  if (!detail) return "Could not load shipping methods";
  if (typeof detail === "string") return detail;

  if (Array.isArray(detail)) {
    return detail
      .map((entry) => {
        if (typeof entry === "string") return entry;
        const location = Array.isArray(entry?.loc) ? entry.loc.join(".") : "";
        const message = entry?.msg || "Validation error";
        return location ? `${location}: ${message}` : message;
      })
      .join("; ");
  }

  if (typeof detail === "object") {
    return detail.message || detail.msg || JSON.stringify(detail);
  }

  return "Could not load shipping methods";
}

function slotLabel(slot = {}) {
  const bits = [];
  if (slot.label) bits.push(slot.label);
  const time = [slot.date, [slot.start_time, slot.end_time].filter(Boolean).join("–")].filter(Boolean).join(" · ");
  if (time) bits.push(time);
  return bits.join(" — ") || "Collection slot";
}

function formatGroupDeliveryDate(value) {
  if (!value) return "";
  const parsed = new Date(value);
  if (Number.isNaN(parsed.getTime())) return value;
  return parsed.toLocaleDateString(undefined, { day: "numeric", month: "long", year: "numeric" });
}

function groupDeliveryAddress(method = {}) {
  return [
    method.group_delivery_address_line_1,
    method.group_delivery_suburb,
    method.group_delivery_town,
    method.group_delivery_province,
    method.group_delivery_postal_code,
  ].filter(Boolean).join(", ");
}

export default function ShippingMethodSelector({
  value,
  onChange,
  selectedSlotId = "",
  onSlotChange,
  items = [],
  subtotal = 0,
  shippingAddress = {},
}) {
  const [methods, setMethods] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const addressIsReady = hasUsableShippingAddress(shippingAddress);

  const quotePayload = useMemo(() => ({
    subtotal: Number(subtotal || 0),
    shipping_address: addressIsReady ? {
      full_name: String(shippingAddress.full_name || "").trim(),
      email: String(shippingAddress.email || "").trim(),
      phone: String(shippingAddress.phone || "").trim(),
      line1: String(shippingAddress.line1 || "").trim(),
      line2: String(shippingAddress.line2 || "").trim(),
      city: String(shippingAddress.city || "").trim(),
      state: String(shippingAddress.state || "").trim(),
      postal_code: String(shippingAddress.postal_code || "").trim(),
      country: String(shippingAddress.country || "ZA").trim(),
    } : null,
    items: (items || []).map((item) => ({
      id: item.id,
      product_id: item.product_id,
      product_title: item.product_title,
      band_id: item.band_id,
      creator_id: item.creator_id,
      variation_id: item.variation_id,
      size: item.size,
      color: item.color,
      unit_price: Number(item.unit_price || 0),
      quantity: Number(item.quantity || 1),
      mockup_url: item.mockup_url,
      customization: item.customization || null,
    })),
  }), [items, subtotal, shippingAddress, addressIsReady]);

  useEffect(() => {
    let mounted = true;

    setLoading(true);
    setError("");

    http.post("/orders/shipping-methods/checkout", quotePayload)
      .then((res) => {
        if (!mounted) return;

        const rows = Array.isArray(res.data) ? res.data : [];
        setMethods(rows);

        if (rows.length && (!value || !rows.some((method) => method.key === value))) {
          const first = rows[0];
          const firstSlot = Array.isArray(first.slots) && first.slots.length ? first.slots[0] : null;
          onChange(first.key, first);
          if (onSlotChange) onSlotChange(firstSlot?.id || "", firstSlot);
        }

        if (!rows.length) {
          onChange("", null);
          if (onSlotChange) onSlotChange("", null);
        }
      })
      .catch((err) => {
        if (!mounted) return;

        setMethods([]);
        setError(normalizeApiError(err));
        onChange("", null);
        if (onSlotChange) onSlotChange("", null);
      })
      .finally(() => {
        if (mounted) setLoading(false);
      });

    return () => {
      mounted = false;
    };
  }, [quotePayload, value]);

  const selectedMethod = methods.find((method) => method.key === value);
  const selectedMethodSlots = Array.isArray(selectedMethod?.slots) ? selectedMethod.slots : [];

  useEffect(() => {
    if (selectedMethod?.key !== "creator_bulk_collection") return;
    if (!selectedMethodSlots.length) return;
    if (selectedSlotId && selectedMethodSlots.some((slot) => slot.id === selectedSlotId)) return;

    const firstSlot = selectedMethodSlots[0];
    if (onSlotChange) onSlotChange(firstSlot.id, firstSlot);
  }, [selectedMethod?.key, selectedMethodSlots, selectedSlotId, onSlotChange]);

  return (
    <div className="card space-y-4">
      <div>
        <p className="overline mb-2">Shipping</p>
        <h2 className="font-display text-3xl uppercase">Choose delivery method</h2>
      </div>

      {!addressIsReady && (
        <p className="text-sm text-[var(--ff-muted-text)]">
          Enter your delivery details to confirm available shipping options.
        </p>
      )}

      {loading && (
        <p className="text-sm text-[var(--ff-muted-text)]">Loading shipping options…</p>
      )}

      {error && (
        <p className="text-sm text-[var(--ff-primary)]">{error}</p>
      )}

      {!loading && !error && methods.length === 0 && addressIsReady && (
        <p className="text-sm text-[var(--ff-muted-text)]">
          No shipping methods are currently available.
        </p>
      )}

      <div className="space-y-3">
        {methods.map((method) => {
          const isSelected = value === method.key;
          const slots = Array.isArray(method.slots) ? method.slots : [];

          return (
            <label
              key={method.key}
              className={`block border p-4 cursor-pointer ${
                isSelected
                  ? "border-[var(--ff-primary)] bg-[var(--ff-surface-bg)]"
                  : "border-[var(--ff-card-border)] hover:border-[var(--ff-primary)]"
              }`}
            >
              <div className="flex items-start gap-3">
                <input
                  type="radio"
                  className="mt-1"
                  checked={isSelected}
                  onChange={() => {
                    const firstSlot = slots.length ? slots[0] : null;
                    onChange(method.key, method);
                    if (onSlotChange) onSlotChange(firstSlot?.id || "", firstSlot);
                  }}
                />

                <div className="flex-1 min-w-0">
                  <div className="flex items-center justify-between gap-4">
                    <div className="font-bold flex items-center gap-2">
                      <Truck size={15} className="text-[var(--ff-primary)]" />
                      {method.display_name}
                    </div>

                    <div className="font-display text-xl">
                      {Number(method.amount || 0) === 0
                        ? "Free"
                        : `R ${money(method.amount)}`}
                    </div>
                  </div>

                  <p className="text-sm text-[var(--ff-muted-text)] mt-1">
                    {method.label || method.description}
                  </p>

                  {method.description && method.label !== method.description && (
                    <p className="text-xs text-[var(--ff-muted-text)] mt-1">
                      {method.description}
                    </p>
                  )}

                  {method.key === "group_delivery" && (
                    <div className="mt-4 space-y-2 border border-[var(--ff-card-border)] bg-[var(--ff-surface-bg)] p-3 text-xs text-[var(--ff-muted-text)]">
                      {method.group_delivery_batch_date && (
                        <div className="flex gap-2">
                          <CalendarDays size={14} className="text-[var(--ff-primary)] flex-shrink-0" />
                          <span>Next batch date: <span className="font-bold text-[var(--ff-card-text)]">{formatGroupDeliveryDate(method.group_delivery_batch_date)}</span></span>
                        </div>
                      )}
                      {method.group_delivery_point_name && (
                        <div className="flex gap-2">
                          <MapPin size={14} className="text-[var(--ff-primary)] flex-shrink-0" />
                          <span>Collection point: <span className="font-bold text-[var(--ff-card-text)]">{method.group_delivery_point_name}</span></span>
                        </div>
                      )}
                      {groupDeliveryAddress(method) && (
                        <div>Address: {groupDeliveryAddress(method)}</div>
                      )}
                      {method.group_delivery_customer_instructions && (
                        <div>{method.group_delivery_customer_instructions}</div>
                      )}
                    </div>
                  )}

                  {method.key === "creator_bulk_collection" && (
                    <div className="mt-4 space-y-3 border border-[var(--ff-card-border)] bg-[var(--ff-surface-bg)] p-3">
                      {method.collection_location_name && (
                        <div className="text-xs text-[var(--ff-muted-text)] flex gap-2">
                          <MapPin size={14} className="text-[var(--ff-primary)] flex-shrink-0" />
                          <span>{method.collection_location_name}</span>
                        </div>
                      )}

                      {method.collection_address && (
                        <div className="text-xs text-[var(--ff-muted-text)]">{method.collection_address}</div>
                      )}

                      {isSelected && (
                        <div>
                          <label className="label flex items-center gap-2">
                            <CalendarDays size={14} />
                            Collection slot
                          </label>
                          <select
                            className="input-base"
                            value={selectedSlotId || ""}
                            onChange={(event) => {
                              const slot = slots.find((row) => row.id === event.target.value) || null;
                              if (onSlotChange) onSlotChange(event.target.value, slot);
                            }}
                            required
                          >
                            {slots.map((slot) => (
                              <option key={slot.id} value={slot.id}>
                                {slotLabel(slot)}
                              </option>
                            ))}
                          </select>
                        </div>
                      )}

                      {method.collection_instructions && (
                        <p className="text-xs text-[var(--ff-muted-text)]">{method.collection_instructions}</p>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </label>
          );
        })}
      </div>
    </div>
  );
}
