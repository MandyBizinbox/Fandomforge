    website_url: form.website_url,
    logo_url: form.logo_url || null,
    banner_url: form.banner_url || null,
    profile_image_url: form.profile_image_url || null,
    production_notes: form.production_notes,
    status: form.status,
    user_id: form.user_id || null,
