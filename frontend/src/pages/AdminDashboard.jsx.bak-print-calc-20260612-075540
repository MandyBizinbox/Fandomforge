              {["setup", "views", "areas", "variations", "methods"].map((p) => <button key={p} onClick={() => setActivePanel(p)} className={`px-3 py-2 text-xs uppercase tracking-widest border ${activePanel === p ? "border-[var(--ff-primary)] text-[var(--ff-card-text)]" : "border-[var(--ff-card-border)] text-[var(--ff-muted-text)]"}`}>{p}</button>)}
