function printOptionOutputLabel(option) {
  const parts = [];
  if (option.standard_print_size_key) parts.push(option.standard_print_size_key);
  if (option.width_mm && option.height_mm) parts.push(`${option.width_mm}×${option.height_mm}mm`);
