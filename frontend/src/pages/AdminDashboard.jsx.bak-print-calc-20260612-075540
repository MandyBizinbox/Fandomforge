function PrintAreaCanvas({ screen, areas, selectedAreaId, onSelectArea, onCreateArea, onPatchArea }) {
  const boxRef = useRef(null);
  const [mode, setMode] = useState("select");
  const [drawStart, setDrawStart] = useState(null);
  const [draft, setDraft] = useState(null);
  const [drag, setDrag] = useState(null);

  const pointFromEvent = (e) => {
    const rect = boxRef.current.getBoundingClientRect();
    const x = Math.max(0, Math.min(100, ((e.clientX - rect.left) / rect.width) * 100));
    const y = Math.max(0, Math.min(100, ((e.clientY - rect.top) / rect.height) * 100));
    return { x, y };
  };

  const startDraw = (e) => {
    if (!screen?.image_url || mode !== "draw") return;
    const p = pointFromEvent(e);
    setDrawStart(p);
    setDraft({ x: p.x, y: p.y, width: 0, height: 0 });
  };

  const movePointer = (e) => {
    if (drawStart && mode === "draw") {
      const p = pointFromEvent(e);
      setDraft({ x: Math.min(drawStart.x, p.x), y: Math.min(drawStart.y, p.y), width: Math.abs(p.x - drawStart.x), height: Math.abs(p.y - drawStart.y) });
    }
    if (drag) {
      const p = pointFromEvent(e);
      const dx = p.x - drag.start.x;
      const dy = p.y - drag.start.y;
      const next = { ...drag.area };
      if (drag.kind === "move") {
        next.x = Math.max(0, Math.min(100 - next.width, drag.area.x + dx));
        next.y = Math.max(0, Math.min(100 - next.height, drag.area.y + dy));
      } else {
        const minSize = 2;
        if (drag.kind.includes("e")) next.width = Math.max(minSize, Math.min(100 - next.x, drag.area.width + dx));
        if (drag.kind.includes("s")) next.height = Math.max(minSize, Math.min(100 - next.y, drag.area.height + dy));
        if (drag.kind.includes("w")) { const nx = Math.max(0, Math.min(drag.area.x + drag.area.width - minSize, drag.area.x + dx)); next.width = drag.area.x + drag.area.width - nx; next.x = nx; }
        if (drag.kind.includes("n")) { const ny = Math.max(0, Math.min(drag.area.y + drag.area.height - minSize, drag.area.y + dy)); next.height = drag.area.y + drag.area.height - ny; next.y = ny; }
      }
      onPatchArea(drag.area.id, next);
    }
  };

  const endPointer = () => {
    if (draft && draft.width > 1 && draft.height > 1) {
      onCreateArea({ ...draft, screen_id: screen.id, screen_view: screen.view, name: `Print Area ${areas.length + 1}`, print_size: "A4", width_mm: 210, height_mm: 297, allowed_print_option_ids: [] });
    }
    setDrawStart(null); setDraft(null); setDrag(null); if (mode === "draw") setMode("select");
  };

  return (
    <div className="h-full flex flex-col bg-[var(--ff-card-bg)]">
      <div className="h-14 border-b border-[var(--ff-card-border)] flex items-center justify-between px-4">
        <div><div className="overline">Canvas</div><div className="text-xs text-[var(--ff-muted-text)]">{screen?.name || "No view selected"}</div></div>
        <div className="flex gap-2"><button type="button" onClick={() => setMode("select")} className={`px-3 py-2 text-xs uppercase tracking-widest border ${mode === "select" ? "border-[var(--ff-primary)] text-[var(--ff-card-text)]" : "border-[var(--ff-card-border)] text-[var(--ff-muted-text)]"}`}>Select</button><button type="button" onClick={() => setMode("draw")} className={`px-3 py-2 text-xs uppercase tracking-widest border ${mode === "draw" ? "border-[var(--ff-primary)] text-[var(--ff-card-text)]" : "border-[var(--ff-card-border)] text-[var(--ff-muted-text)]"}`}>Draw Area</button></div>
      </div>
      <div className="flex-1 overflow-auto p-8 flex items-center justify-center">
        {!screen?.image_url ? <div className="text-center text-[var(--ff-muted-text)]"><ImageIcon size={64} className="mx-auto mb-4" /><div className="overline">Upload a product view to start drawing</div></div> : (
          <div ref={boxRef} className="relative max-w-full max-h-full select-none" onMouseDown={startDraw} onMouseMove={movePointer} onMouseUp={endPointer} onMouseLeave={endPointer}>
            <img src={assetUrl(screen.image_url)} alt={screen.name} className="max-w-full max-h-[72vh] object-contain pointer-events-none" />
            {areas.map((area) => {
              const selected = area.id === selectedAreaId;
              return (
                <div key={area.id} onMouseDown={(e) => { e.stopPropagation(); onSelectArea(area.id); setDrag({ kind: "move", start: pointFromEvent(e), area }); }} className={`absolute border-2 ${selected ? "border-[var(--ff-primary)] bg-[var(--ff-primary)]/20" : "border-[#34C759] bg-[#34C759]/10"} cursor-move`} style={{ left: `${area.x}%`, top: `${area.y}%`, width: `${area.width}%`, height: `${area.height}%` }}>
                  <div className="absolute -top-6 left-0 bg-[var(--ff-card-bg)] border border-[var(--ff-card-border)] text-[10px] uppercase tracking-widest px-2 py-1 whitespace-nowrap">{area.name}</div>
                  {selected && ["nw", "ne", "sw", "se"].map((h) => (
                    <span key={h} onMouseDown={(e) => { e.stopPropagation(); setDrag({ kind: h, start: pointFromEvent(e), area }); }} className={`absolute w-3 h-3 bg-white border border-black ${h.includes("n") ? "-top-1.5" : "-bottom-1.5"} ${h.includes("w") ? "-left-1.5" : "-right-1.5"} cursor-${h}-resize`} />
                  ))}
                </div>
              );
            })}
            {draft && <div className="absolute border-2 border-dashed border-[#FFCC00] bg-[var(--ff-surface-bg)]" style={{ left: `${draft.x}%`, top: `${draft.y}%`, width: `${draft.width}%`, height: `${draft.height}%` }} />}
          </div>
        )}
      </div>
    </div>
  );
}

function ProductTemplateStudio() {
  const { id } = useParams();
  const navigate = useNavigate();
  const isNew = !id;
  const [template, setTemplate] = useState(blankTemplate);
  const [categories, setCategories] = useState([]);
  const [attributes, setAttributes] = useState([]);
  const [printOptions, setPrintOptions] = useState([]);
  const [activePanel, setActivePanel] = useState("setup");
  const [activeScreenId, setActiveScreenId] = useState(null);
  const [selectedAreaId, setSelectedAreaId] = useState(null);
  const [saving, setSaving] = useState(false);
  const [uploading, setUploading] = useState(false);

  const activeScreen = useMemo(() => (template.mockup_screens || []).find((s) => s.id === activeScreenId) || (template.mockup_screens || [])[0] || null, [template.mockup_screens, activeScreenId]);
  const screenAreas = useMemo(() => (template.print_areas || []).filter((a) => a.screen_id === activeScreen?.id), [template.print_areas, activeScreen]);
  const selectedArea = useMemo(() => (template.print_areas || []).find((a) => a.id === selectedAreaId) || null, [template.print_areas, selectedAreaId]);

  useEffect(() => {
    http.get("/categories").then((r) => setCategories(r.data)).catch(() => {});
    http.get("/attributes").then((r) => setAttributes(r.data)).catch(() => {});
    http.get("/print-options").then((r) => setPrintOptions(r.data)).catch(() => {});
    if (!isNew) {
      http.get(`/admin/product-templates/${id}`).then((r) => {
        const next = { ...blankTemplate, ...r.data };
        setTemplate(next);
        setActiveScreenId((next.mockup_screens || [])[0]?.id || null);
      }).catch((e) => toast.error(e.response?.data?.detail || "Could not load template"));
    }
  }, [id, isNew]);

  const patch = (updates) => setTemplate((prev) => ({ ...prev, ...updates }));
  const uploadImage = async (file, subdir = "product-templates") => {
    if (!file) return null;
    setUploading(true);
    const data = new FormData();
    data.append("file", file);
    data.append("subdir", subdir);
    try { const r = await http.post("/files/image", data); return r.data.url; }
    catch (e) { toast.error(e.response?.data?.detail || "Upload failed"); return null; }
    finally { setUploading(false); }
  };

  const addScreen = async (file, name = "Front", view = "front") => {
    const url = await uploadImage(file, "product-template-views");
    if (!url) return;
    const screen = { id: newId("screen"), name, view, image_url: url, sort_order: template.mockup_screens.length, is_primary: template.mockup_screens.length === 0 };
    patch({ mockup_screens: [...template.mockup_screens, screen], mockup_url: template.mockup_url || url, product_image_url: template.product_image_url || url, mockup_images: Array.from(new Set([...(template.mockup_images || []), url])) });
    setActiveScreenId(screen.id);
  };

  const createArea = (area) => {
    const next = { id: newId("area"), ...area };
    patch({ print_areas: [...template.print_areas, next] });
    setSelectedAreaId(next.id);
  };
  const patchArea = (areaId, updates) => patch({ print_areas: template.print_areas.map((a) => a.id === areaId ? { ...a, ...updates } : a) });
  const deleteArea = (areaId) => { patch({ print_areas: template.print_areas.filter((a) => a.id !== areaId) }); setSelectedAreaId(null); };

  const generateVariations = () => {
    const selected = attributes.filter((a) => template.attribute_ids.includes(a.id) && a.used_for_variation);
    if (!selected.length) { toast.error("Select at least one variation attribute"); return; }
    const combos = selected.reduce((acc, attr) => acc.flatMap((row) => (attr.values || []).map((v) => ({ ...row, [attr.name]: v }))), [{}]);
    patch({ variations: combos.map((attrs) => ({ id: newId("var"), attributes: attrs, sku: "", supplier_sku: "", cost: Number(template.base_blank_cost || 0), base_blank_cost: Number(template.base_blank_cost || 0), status: "active" })) });
    toast.success(`Generated ${combos.length} variations`);
  };

  const save = async () => {
    if (!template.name.trim()) { toast.error("Template name is required"); return; }
    if (!template.category.trim()) { toast.error("Category is required"); return; }
    setSaving(true);
    const payload = { ...template, base_price: Number(template.base_blank_cost || template.base_price || 0), base_blank_cost: Number(template.base_blank_cost || template.base_price || 0), print_options: printOptions.filter((o) => template.print_option_ids.includes(o.id)).map((o) => ({ id: o.id, print_method: o.print_method, method: o.print_method, print_size: o.print_size, print_cost_max: Number(o.print_cost_max || 0), print_positions: o.print_positions || [] })) };
    try {
      const r = isNew ? await http.post("/admin/product-templates", payload) : await http.patch(`/admin/product-templates/${id}`, payload);
      toast.success("Template saved");
      if (isNew) navigate(`/admin/product-templates/${r.data.id}`);
      else setTemplate({ ...blankTemplate, ...r.data });
    } catch (e) { toast.error(e.response?.data?.detail || "Save failed"); }
    finally { setSaving(false); }
  };

  return (
    <div className="fixed inset-0 bg-[var(--ff-page-bg)] text-[var(--ff-card-text)] z-50 flex flex-col" data-testid="template-studio">
