def _first(value, fallback=None):
    return value if value not in (None, "") else fallback


def _find_by_id(rows, item_id):
    if not item_id:
        return None
    for row in rows or []:
        if row.get("id") == item_id:
            return row
    return None


def _money_round(value) -> float:
    return round(float(value or 0), 2)


def _platform_markup(value, rate: float = 0.10) -> float:
    return _money_round(float(value or 0) * (1 + rate))


def _resolve_marked_price(
    platform_cost: float,
    explicit_creator_price: Optional[float] = None,
    markup_type: Optional[str] = "manual",
    markup_value: Optional[float] = 0,
    default_rate: float = 0.10,
) -> float:
    """
    Resolve the price charged into the creator builder.

    platform_cost:
        The true internal/platform cost.

    explicit_creator_price:
        The actual creator-facing cost, if manually supplied.

    markup_type:
        manual, percentage, or fixed_amount.

    Backwards compatible fallback:
        If no creator price/markup is supplied, apply the old 10% markup.
    """
    platform_cost = float(platform_cost or 0)

    if explicit_creator_price not in (None, ""):
        try:
            creator_price = float(explicit_creator_price or 0)
            if creator_price > 0:
                return _money_round(creator_price)
        except (TypeError, ValueError):
            pass

    try:
        markup_value = float(markup_value or 0)
    except (TypeError, ValueError):
        markup_value = 0

    markup_type = markup_type or "manual"

    if markup_type == "percentage" and markup_value:
        return _money_round(platform_cost * (1 + (markup_value / 100)))

    if markup_type == "fixed_amount" and markup_value:
        return _money_round(platform_cost + markup_value)

    return _platform_markup(platform_cost, default_rate)


def _resolve_blank_costing(variation: Optional[dict] = None, template: Optional[dict] = None) -> dict:
    """
    Resolve blank costing using the new platform/creator split while preserving
    legacy fields.

    Important rule:
    If a variation has its own platform/cost/base_blank_cost, its creator price
    must be calculated from that variation cost unless the variation itself has
    an explicit creator_blank_price.

    This prevents a lower template-level creator price from creating negative
    profit on more expensive variations.
    """
    variation = variation or {}
    template = template or {}

    variation_platform_cost = (
        variation.get("platform_blank_cost")
        or variation.get("base_blank_cost")
        or variation.get("cost")
    )

    template_platform_cost = (
        template.get("platform_blank_cost")
        or template.get("base_blank_cost")
        or template.get("base_price")
    )

    platform_cost = variation_platform_cost or template_platform_cost or 0

    explicit_creator_price = variation.get("creator_blank_price")
    if explicit_creator_price in (None, "", 0) and not variation_platform_cost:
        explicit_creator_price = template.get("creator_blank_price")

    creator_price = _resolve_marked_price(
        platform_cost,
        explicit_creator_price,
        variation.get("platform_blank_markup_type") or template.get("platform_blank_markup_type") or "manual",
        variation.get("platform_blank_markup_value") or template.get("platform_blank_markup_value") or 0,
        default_rate=0.10,
    )

    platform_cost = _money_round(platform_cost)
    creator_price = _money_round(creator_price)
    profit = _money_round(creator_price - platform_cost)
    margin_percent = _money_round((profit / platform_cost) * 100) if platform_cost else 0

    return {
        "platform_blank_cost": platform_cost,
        "creator_blank_price": creator_price,
        "platform_blank_profit": profit,
        "platform_blank_margin_percent": margin_percent,
    }


def _resolve_print_costing(print_option: Optional[dict] = None, artwork_slot: Optional[dict] = None, fallback_print_cost: float = 0) -> dict:
    """
    Resolve print costing using the new platform/creator split while preserving
    legacy print_cost_max / calculated_print_cost fields.

    Supports:
    - fixed / legacy print_cost_max
    - area_fixed_rate using width_mm x height_mm x cost_per_cm2
    - full_sheet / area_from_sheet when sheet dimensions and sheet cost exist
    """
    print_option = print_option or {}
    artwork_slot = artwork_slot or {}

    calculation_type = (
        artwork_slot.get("calculation_type")
        or print_option.get("calculation_type")
        or ""
    )

    width_mm = (
        artwork_slot.get("print_width_mm")
        or artwork_slot.get("width_mm")
        or artwork_slot.get("placement_box_width_mm")
        or print_option.get("width_mm")
        or 0
    )
    height_mm = (
        artwork_slot.get("print_height_mm")
        or artwork_slot.get("height_mm")
        or artwork_slot.get("placement_box_height_mm")
        or print_option.get("height_mm")
        or 0
    )

    try:
        width_mm = float(width_mm or 0)
        height_mm = float(height_mm or 0)
    except (TypeError, ValueError):
        width_mm = 0
        height_mm = 0

    area_cm2 = 0
    if width_mm > 0 and height_mm > 0:
        area_cm2 = (width_mm * height_mm) / 100

    calculated_platform_cost = 0

    if calculation_type == "area_fixed_rate" and area_cm2:
        calculated_platform_cost = area_cm2 * float(print_option.get("cost_per_cm2") or artwork_slot.get("cost_per_cm2") or 0)

    elif calculation_type in ("area_from_sheet", "full_sheet") and area_cm2:
        sheet_width_mm = float(print_option.get("sheet_width_mm") or artwork_slot.get("sheet_width_mm") or 0)
        sheet_height_mm = float(print_option.get("sheet_height_mm") or artwork_slot.get("sheet_height_mm") or 0)
        sheet_cost = float(print_option.get("sheet_cost") or artwork_slot.get("sheet_cost") or 0)
        sheet_area_cm2 = ((sheet_width_mm * sheet_height_mm) / 100) if sheet_width_mm and sheet_height_mm else 0

        if calculation_type == "full_sheet" and sheet_cost:
            calculated_platform_cost = sheet_cost
        elif sheet_area_cm2 and sheet_cost:
            calculated_platform_cost = (area_cm2 / sheet_area_cm2) * sheet_cost

    waste_percentage = float(print_option.get("waste_percentage") or artwork_slot.get("waste_percentage") or 0)
    if calculated_platform_cost and waste_percentage:
        calculated_platform_cost = calculated_platform_cost * (1 + (waste_percentage / 100))

    minimum_print_cost = float(print_option.get("minimum_print_cost") or artwork_slot.get("minimum_print_cost") or 0)
    if calculated_platform_cost and minimum_print_cost:
        calculated_platform_cost = max(calculated_platform_cost, minimum_print_cost)

    platform_cost = (
        artwork_slot.get("platform_print_cost")
        or artwork_slot.get("calculated_print_cost")
        or artwork_slot.get("raw_print_cost")
        or print_option.get("platform_print_cost")
        or calculated_platform_cost
        or print_option.get("print_cost_max")
        or fallback_print_cost
        or 0
    )

    creator_price = _resolve_marked_price(
        platform_cost,
        artwork_slot.get("creator_print_price") or print_option.get("creator_print_price"),
        print_option.get("platform_print_markup_type") or "manual",
        print_option.get("platform_print_markup_value") or 0,
        default_rate=0.10,
    )

    platform_cost = _money_round(platform_cost)
    creator_price = _money_round(creator_price)
    profit = _money_round(creator_price - platform_cost)
    margin_percent = _money_round((profit / platform_cost) * 100) if platform_cost else 0

    return {
        "platform_print_cost": platform_cost,
        "creator_print_price": creator_price,
        "platform_print_profit": profit,
        "platform_print_margin_percent": margin_percent,
        "area_cm2": _money_round(area_cm2),
        "calculation_type": calculation_type,
    }


def _minimum_selling_price_for_cost(production_cost: float, commission_rate: float) -> float:
    rate = float(commission_rate or 0)
    if rate >= 1:
        return _money_round(production_cost)
    return _money_round(float(production_cost or 0) / (1 - rate))


def _platform_costing_breakdown(
    blank_supplier_cost: float,
    platform_print_cost: float,
    commission_rate: float,
    selling_price: float = 0,
    quantity: int = 1,
    creator_blank_price: Optional[float] = None,
    creator_print_price: Optional[float] = None,
) -> dict:
    """
    Backwards-compatible costing breakdown.

    Legacy inputs:
    - blank_supplier_cost
    - platform_print_cost

    New optional inputs:
    - creator_blank_price
    - creator_print_price

    If creator prices are not supplied, the old 10% markup behaviour is used.
    """
    qty = max(int(quantity or 1), 1)

    platform_blank_cost = _money_round(blank_supplier_cost)
    platform_print_cost = _money_round(platform_print_cost)

    blank_payout_unit = _resolve_marked_price(platform_blank_cost, creator_blank_price, default_rate=0.10)
    print_payout_unit = _resolve_marked_price(platform_print_cost, creator_print_price, default_rate=0.10)

    production_unit_cost = _money_round(blank_payout_unit + print_payout_unit)
    platform_unit_cost = _money_round(platform_blank_cost + platform_print_cost)

    blank_profit_unit = _money_round(blank_payout_unit - platform_blank_cost)
    print_profit_unit = _money_round(print_payout_unit - platform_print_cost)

    minimum_selling_price = _minimum_selling_price_for_cost(production_unit_cost, commission_rate)
    retail = float(selling_price or 0)
    commission_unit = _money_round(retail * float(commission_rate or 0))
    creator_profit_unit = _money_round(retail - production_unit_cost - commission_unit)

    estimated_platform_profit_unit = _money_round(blank_profit_unit + print_profit_unit + commission_unit)

    return {
        # Legacy-compatible names
        "blank_supplier_cost": platform_blank_cost,
        "platform_print_cost": platform_print_cost,
        "blank_payout_unit": blank_payout_unit,
        "print_payout_unit": print_payout_unit,

        # New clearer names
        "platform_blank_cost": platform_blank_cost,
        "creator_blank_price": blank_payout_unit,
        "creator_print_price": print_payout_unit,
        "platform_blank_profit_unit": blank_profit_unit,
        "platform_print_profit_unit": print_profit_unit,
        "platform_unit_cost": platform_unit_cost,
        "creator_product_cost": production_unit_cost,
        "estimated_platform_profit_unit": estimated_platform_profit_unit,

        "production_unit_cost": production_unit_cost,
        "minimum_selling_price": minimum_selling_price,
        "commission_rate": float(commission_rate or 0),
        "commission_unit": commission_unit,
        "creator_profit_unit": creator_profit_unit,

        "production_cost": _money_round(production_unit_cost * qty),
        "printer_payout": _money_round(production_unit_cost * qty),
        "platform_commission": _money_round(commission_unit * qty),
        "creator_profit": _money_round(creator_profit_unit * qty),

        "platform_blank_profit": _money_round(blank_profit_unit * qty),
        "platform_print_profit": _money_round(print_profit_unit * qty),
        "estimated_platform_profit": _money_round(estimated_platform_profit_unit * qty),
    }


def _variation_label(variation: dict) -> str:
    attrs = variation.get("attributes") or variation.get("attribute_values") or {}
    if attrs:
        return " / ".join(f"{k}: {v}" for k, v in attrs.items() if str(v).strip())
    parts = [variation.get("size"), variation.get("color"), variation.get("sku")]
    return " / ".join(str(p) for p in parts if p) or "Variation"




AREA_KEY_EQUIVALENTS = {
    "front": {"front", "front_full", "left_chest", "right_chest", "pocket"},
    "front_full": {"front", "front_full"},
    "back": {"back", "back_full"},
    "back_full": {"back", "back_full"},
    "sleeve": {"sleeve", "left_sleeve", "right_sleeve"},
    "left_sleeve": {"sleeve", "left_sleeve", "right_sleeve"},
    "right_sleeve": {"sleeve", "left_sleeve", "right_sleeve"},
    "neck_label": {"neck_label"},
    "pocket": {"pocket", "front"},
}


def _normalised_area_key_from_text(value: str) -> str:
    key = str(value or "").strip().lower().replace(" ", "_").replace("-", "_")

    if "neck" in key and "label" in key:
        return "neck_label"
    if "left" in key and "sleeve" in key:
        return "left_sleeve"
    if "right" in key and "sleeve" in key:
        return "right_sleeve"
    if "sleeve" in key:
        return "sleeve"
    if "back" in key:
        return "back_full" if "full" in key else "back"
    if "front" in key:
        return "front_full" if "full" in key or "a4" in key else "front"
    if "pocket" in key:
        return "pocket"

    return key


def _area_key_for_snapshot_slot_or_area(slot_or_area: dict) -> str:
    row = slot_or_area or {}
    return _normalised_area_key_from_text(
        row.get("area_key")
        or row.get("view_key")
        or row.get("screen_view")
        or row.get("name")
        or row.get("print_size")
        or ""
    )


def _area_keys_equivalent(left: str, right: str) -> bool:
    left_key = _normalised_area_key_from_text(left)
    right_key = _normalised_area_key_from_text(right)

    if not left_key or not right_key:
        return False

    if left_key == right_key:
        return True

    return right_key in AREA_KEY_EQUIVALENTS.get(left_key, {left_key}) or left_key in AREA_KEY_EQUIVALENTS.get(right_key, {right_key})


def _filter_prices_by_area_key(template: dict, prices: list, wanted_area_key: str) -> list:
    if not wanted_area_key:
        return prices

    area_by_id = {
        str(area.get("id")): area
        for area in (template or {}).get("print_areas") or []
        if area.get("id")
    }

    matches = []
    for price in prices or []:
        price_area = area_by_id.get(str(price.get("print_area_id") or ""))
        price_area_key = _area_key_for_snapshot_slot_or_area(price_area or {"area_key": price.get("area_key")})

        if _area_keys_equivalent(wanted_area_key, price_area_key):
            matches.append(price)

    return matches


def _primary_priced_artwork_slot_for_product(product: dict) -> dict:
    """Return the artwork slot that should drive printer pricing.

    Prefer the same slot the product marked as primary/top-level, then any uploaded slot.
    """
    selected_area_id = product.get("selected_print_area_id")
    selected_option_id = product.get("selected_print_option_id")

    slots = []
    for group in product.get("artwork_groups") or []:
        slots.extend(group.get("artworks") or [])
    slots.extend(product.get("artworks") or [])

    seen = set()
    unique_slots = []
    for slot in slots:
        key = slot.get("id") or f"{slot.get('print_area_id')}:{slot.get('print_option_id')}:{slot.get('original_url')}"
        if key in seen:
            continue
        seen.add(key)
        unique_slots.append(slot)

    if selected_area_id and selected_option_id:
        match = next(
            (
                slot for slot in unique_slots
                if slot.get("print_area_id") == selected_area_id
                and slot.get("print_option_id") == selected_option_id
                and slot.get("original_url")
            ),
            None,
        )
        if match:
            return match

    if selected_area_id:
        match = next(
            (
                slot for slot in unique_slots
                if slot.get("print_area_id") == selected_area_id
                and slot.get("print_option_id")
                and slot.get("original_url")
            ),
            None,
        )
        if match:
            return match

    return next((slot for slot in unique_slots if slot.get("print_option_id") and slot.get("original_url")), {}) or {}


