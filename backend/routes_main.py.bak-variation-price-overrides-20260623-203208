        if not plan:
            raise HTTPException(status_code=404, detail="Subscription plan not found")
    data = _apply_plan_defaults_to_subscription({k: v for k, v in data.items() if v is not None}, plan)
    access = _subscription_access_from_status(data.get("status") or "manual", owner_type)
    for key, value in access.items():
        data.setdefault(key, value)
    data.setdefault("current_period_start", utcnow())
    data["updated_at"] = utcnow()

    existing = await db.account_subscriptions.find_one({"owner_type": owner_type, "owner_id": payload.owner_id}, {"_id": 0})
