@admin_router.patch("/artwork-review/{product_id}/approve-all", response_model=Product)
async def admin_approve_all_product_artwork(
    product_id: str,
    request: Request,
    notes: Optional[str] = None,
    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_artwork_review")
    db = request.app.state.db
    product = await db.products.find_one({"id": product_id}, {"_id": 0})
    if not product:
        raise HTTPException(status_code=404, detail="Product not found")

    groups = product.get("artwork_groups") or []
    now = utcnow().isoformat()
    changed = 0
    for group in groups:
        for slot in group.get("artworks") or []:
            if not _artwork_slot_has_file(slot):
                continue
            slot["status"] = "approved"
            slot["reviewed_by_user_id"] = user.id
            slot["reviewed_at"] = now
            slot["review_note"] = notes or "Approved"
            slot["rejection_reason"] = None
            changed += 1

    flat = product.get("artworks") or []
    by_id = {slot.get("id"): slot for group in groups for slot in (group.get("artworks") or []) if slot.get("id")}
    for index, slot in enumerate(flat):
        if slot.get("id") in by_id:
            flat[index] = {**slot, **by_id[slot.get("id")]}

    product["artwork_groups"] = groups
    product["artworks"] = flat
