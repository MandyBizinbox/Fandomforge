@admin_router.post("/payout-batches/{batch_id}/send-paystack", response_model=PayoutBatch)
async def admin_send_payout_batch_paystack(
    batch_id: str,
    request: Request,
    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_payouts")
    db = request.app.state.db
    batch = await db.payout_batches.find_one({"id": batch_id}, {"_id": 0})
    if not batch:
        raise HTTPException(status_code=404, detail="Payout batch not found")
    if batch.get("status") not in ["approved", "processing", "partial", "draft"]:
        raise HTTPException(status_code=400, detail="Batch must be approved before Paystack transfer")

    now = datetime.now(timezone.utc).isoformat()
    items = batch.get("items") or []
    any_failed = False
    any_paid = False

    for item in items:
        if item.get("status") == "paid":
            any_paid = True
            continue
        profile = await db.payout_profiles.find_one({"id": item.get("payout_profile_id")}, {"_id": 0})
        if not profile:
            item["status"] = "failed"
            item["failure_reason"] = "Missing payout profile"
            any_failed = True
            continue

        recipient = profile.get("paystack_recipient_code")
        if not recipient:
            item["status"] = "failed"
            item["failure_reason"] = "Missing Paystack recipient code"
            any_failed = True
            continue

        amount_kobo = int(round(float(item.get("amount") or 0) * 100))
        reference = item.get("provider_reference") or f"MF-PAYOUT-{item['id'][:10].upper()}"
        payload = {
            "source": "balance",
            "amount": amount_kobo,
            "recipient": recipient,
            "reason": f"FandomForge payout {batch.get('title')}",
            "reference": reference,
        }
        try:
            res = await _paystack_request(db, "POST", "/transfer", payload)
            data = res.get("data") or {}
            item["status"] = "processing" if data.get("status") not in ["success", "successful"] else "paid"
            item["provider_reference"] = reference
            item["provider_transfer_code"] = data.get("transfer_code")
            item["metadata"] = {**(item.get("metadata") or {}), "paystack_response": data}
            if item["status"] == "paid":
                any_paid = True
                await db.wallet_transactions.update_many(
                    {"id": {"$in": item.get("wallet_transaction_ids") or []}},
                    {"$set": {"status": "paid", "paid_at": now}},
                )
        except HTTPException as e:
            item["status"] = "failed"
            item["failure_reason"] = str(e.detail)
            any_failed = True

    batch_status = "processing"
    if any_failed and any_paid:
        batch_status = "partial"
    elif any_failed and not any_paid:
        batch_status = "failed"

    patch = {"items": items, "status": batch_status, "updated_at": now}
    await db.payout_batches.update_one({"id": batch_id}, {"$set": patch})
    doc = await db.payout_batches.find_one({"id": batch_id}, {"_id": 0})
    return PayoutBatch(**doc)





