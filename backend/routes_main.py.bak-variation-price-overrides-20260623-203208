async def get_order_for_user_access(db, order_id: str, user: User) -> dict:
    order = await db.orders.find_one({"id": order_id}, {"_id": 0})
    if not order:
        raise HTTPException(status_code=404, detail="Order not found")

    if user.role == "super_admin":
        return order

    if user.role in ("creator", "creator"):
        creator = await get_creator_account_for_user(db, user)
        if any(item.get("band_id") == creator["id"] for item in order.get("items", [])):
            return order

    if user.role == "printer":
        printer = await db.printers.find_one({"user_id": user.id}, {"_id": 0})
        if printer and any(item.get("printer_id") == printer["id"] for item in order.get("items", [])):
            return order

    if order.get("buyer_id") == user.id:
        return order

    raise HTTPException(status_code=403, detail="No access to this order")


async def order_event_query_for_user(db, user: User, order_id: Optional[str] = None) -> Dict:
    q: Dict = {}
    if order_id:
        q["order_id"] = order_id

    if user.role == "super_admin":
        return q

    if user.role in ("creator", "creator"):
        creator = await get_creator_account_for_user(db, user)
        q["band_id"] = creator["id"]
        q["audience"] = {"$in": ["creator", "all"]}
        return q

    if user.role == "printer":
        printer = await db.printers.find_one({"user_id": user.id}, {"_id": 0})
        if not printer:
            raise HTTPException(status_code=404, detail="No printer profile")
        q["printer_id"] = printer["id"]
        q["audience"] = {"$in": ["printer", "all"]}
        return q

    q["actor_user_id"] = user.id
    return q

def validate_user_role(role: str) -> None:
    if role not in ("buyer", "customer", "creator", "creator", "printer", "admin", "manager", "owner", "super_admin"):
        raise HTTPException(status_code=400, detail="Invalid role")


def validate_user_status(status: str) -> None:
    if status not in ("active", "suspended", "pending", "archived"):
        raise HTTPException(status_code=400, detail="Invalid status")


def validate_creator_member_role(role: str) -> None:
    if role not in ("admin", "manager", "products", "orders", "viewer"):
        raise HTTPException(status_code=400, detail="Invalid creator member role")


def validate_creator_member_permissions(permissions: List[str]) -> None:
    allowed_permissions = {
        "manage_members",
        "manage_products",
        "view_orders",
        "manage_orders",
        "manage_settings",
        "view_earnings",
    }

    for permission in permissions:
        if permission not in allowed_permissions:
            raise HTTPException(status_code=400, detail=f"Invalid permission: {permission}")


async def get_creator_account_for_user(
    db,
    user: User,
    permission: Optional[str] = None,
) -> dict:
    """
    Returns the creator account a user can access.

    Owner:
      creators.user_id == user.id

    Team member:
      db.band_members contains an active membership.

    permission examples:
      manage_members
      manage_products
      view_orders
      manage_orders
      manage_settings
      view_earnings
    """
    owner_band = await db.creators.find_one({"user_id": user.id}, {"_id": 0})
    if owner_band:
        return owner_band

    member = await db.band_members.find_one(
        {"user_id": user.id, "status": "active"},
        {"_id": 0},
    )

    if not member:
        raise HTTPException(status_code=404, detail="No creator account access")

    member_role = member.get("role", "viewer")
    permissions = member.get("permissions", [])

    if permission:
        allowed = (
            member_role in ("owner", "admin")
            or permission in permissions
            or "*" in permissions
        )
        if not allowed:
            raise HTTPException(status_code=403, detail="Insufficient creator account permission")

    creator = await db.creators.find_one({"id": member["band_id"]}, {"_id": 0})
    if not creator:
        raise HTTPException(status_code=404, detail="Creator account not found")

    return creator


async def user_can_access_band(
    db,
    user: User,
    band_id: str,
    permission: Optional[str] = None,
) -> bool:
    if user.role == "super_admin":
        return True

    owner = await db.creators.find_one({"id": band_id, "user_id": user.id}, {"_id": 0})
    if owner:
        return True

    member = await db.band_members.find_one(
        {"band_id": band_id, "user_id": user.id, "status": "active"},
        {"_id": 0},
    )

    if not member:
        return False

    if not permission:
        return True

    permissions = member.get("permissions", [])
    return member.get("role") in ("owner", "admin") or permission in permissions or "*" in permissions


async def get_band_for_product_access(
    db,
    user: User,
    product: dict,
    permission: str,
) -> Optional[dict]:
    if user.role == "super_admin":
        return await db.creators.find_one({"id": product["band_id"]}, {"_id": 0})

    allowed = await user_can_access_band(db, user, product["band_id"], permission=permission)
    if not allowed:
        return None

    return await db.creators.find_one({"id": product["band_id"]}, {"_id": 0})


