def _normalize_printer_template_price_payload(data: dict, printer_id: str) -> dict:
    data = dict(data)
    data["printer_id"] = printer_id
    data["blank_price"] = float(data.get("blank_price") or 0)
    data["print_price"] = float(data.get("print_price") or 0)
    data["total_price"] = data["blank_price"] + data["print_price"]
    data["updated_at"] = utcnow().isoformat()
    return data


async def _template_blank_payout_with_markup(db, product_template_id: str) -> float:
    """
    Return the creator-facing blank price for printer/template pricing.

    Backwards compatible:
    - Prefer template.creator_blank_price.
    - Fallback through _resolve_blank_costing().
    - Old behaviour becomes the resolver fallback of platform cost + 10%.
    """
    template = await db.product_templates.find_one({"id": product_template_id}, {"_id": 0})
    if not template:
        raise HTTPException(status_code=400, detail="Product template not found")

    costing = _resolve_blank_costing({}, template)
    return _money_round(costing["creator_blank_price"])


async def _apply_template_blank_markup(db, data: dict) -> dict:
    data = dict(data)
    data["blank_price"] = await _template_blank_payout_with_markup(db, data.get("product_template_id"))
    data["total_price"] = round(float(data.get("blank_price") or 0) + float(data.get("print_price") or 0), 2)
    data["updated_at"] = utcnow()
    return data


async def _validate_printer_template_price(db, data: dict) -> None:
    template = await db.product_templates.find_one({"id": data.get("product_template_id")}, {"_id": 0})
    if not template:
        raise HTTPException(status_code=400, detail="Product template not found")

    print_option = await db.print_options.find_one({"id": data.get("print_option_id")}, {"_id": 0})
    if not print_option:
        # Some older templates have embedded print options. Permit those if present on the selected template.
        embedded = _find_by_id(template.get("print_options") or [], data.get("print_option_id"))
        if not embedded:
            raise HTTPException(status_code=400, detail="Print option not found")
        print_option = embedded

    max_price = float(print_option.get("print_cost_max") or 0)
    if max_price and float(data.get("print_price") or 0) > max_price:
        raise HTTPException(
            status_code=400,
            detail=f"Print price exceeds platform max of R {max_price:.2f} for this method/size",
        )

    print_area_id = data.get("print_area_id")
    if print_area_id:
        area = _find_by_id(template.get("print_areas") or [], print_area_id)
        if not area:
            raise HTTPException(status_code=400, detail="Print area does not exist on this template")

        allowed = area.get("allowed_print_option_ids") or []
        if allowed and data.get("print_option_id") not in allowed:
            raise HTTPException(status_code=400, detail="Print option is not allowed for this print area")


