@payments_router.get("/paystack/callback")
async def paystack_shop_checkout_callback(request: Request, reference: Optional[str] = None, trxref: Optional[str] = None):
    """Static Paystack dashboard callback URL for buyer checkout payments.

    Paystack also receives a per-order callback_url during transaction initialization,
    but dashboard setup screens require a stable URL. This endpoint verifies the
    Paystack reference, updates the matching order payment, and redirects the
    buyer to the correct order confirmation page.
    """
    payment_reference = (reference or trxref or "").strip()
    base = str(request.base_url).rstrip("/")
    if not payment_reference:
        return RedirectResponse(url=f"{base}/checkout?payment=missing_reference", status_code=302)

    db = request.app.state.db
    payment = await db.payments.find_one({
        "provider": "paystack",
        "provider_reference": payment_reference,
        "$or": [{"kind": "order"}, {"order_id": {"$exists": True}}],
    }, {"_id": 0})
    if not payment:
        return RedirectResponse(url=f"{base}/checkout?payment=not_found&reference={payment_reference}", status_code=302)

    status = "pending"
    try:
        gateway = await _get_gateway_config(db, "paystack", masked=False)
        adapter = get_payment_gateway_adapter("paystack")
        result = await adapter.verify_payment(payment_reference, gateway)
        status = result.get("status") or status
        if result.get("paid"):
            await _mark_order_paid_from_payment(db, payment, result)
            status = "paid"
        elif result.get("status") == "failed":
            now = datetime.now(timezone.utc).isoformat()
            await db.payments.update_one({"id": payment["id"]}, {"$set": {"status": "failed", "provider_payload": result, "updated_at": now}})
            if payment.get("order_id"):
                await db.orders.update_one({"id": payment["order_id"]}, {"$set": {"payment_status": "failed", "updated_at": now}})
            status = "failed"
    except Exception as exc:
        logging.exception("Paystack shop callback verification failed for %s", payment_reference)
        status = "verify_error"

    order_id = payment.get("order_id")
    if order_id:
        return RedirectResponse(url=f"{base}/order-confirmation/{order_id}?reference={payment_reference}&payment={status}", status_code=302)
    return RedirectResponse(url=f"{base}/checkout?payment={status}&reference={payment_reference}", status_code=302)

@payments_router.get("/verify/{payment_reference}")
async def verify_payment(payment_reference: str, request: Request):
    db = request.app.state.db
    payment = await db.payments.find_one({"provider_reference": payment_reference}, {"_id": 0})
    if not payment:
        raise HTTPException(status_code=404, detail="Payment not found")

    provider = payment.get("provider")
    if provider == "paystack":
        res = await _paystack_checkout_request(db, "GET", f"/transaction/verify/{payment_reference}")
        data = res.get("data") or {}
        if res.get("status") and data.get("status") == "success":
            order = await _mark_order_paid_from_payment(db, payment, res)
            return {"ok": True, "status": "paid", "order_id": payment.get("order_id"), "order_status": order.get("status") if order else None}
        await db.payments.update_one({"id": payment["id"]}, {"$set": {"status": "failed", "provider_payload": res}})
        return {"ok": False, "status": data.get("status") or "failed", "order_id": payment.get("order_id")}

    if provider:
        try:
            gateway = await _get_gateway_config(db, provider, masked=False)
            adapter = get_payment_gateway_adapter(provider)
            result = await adapter.verify_payment(payment_reference, gateway)
            if result.get("paid"):
                order = await _mark_order_paid_from_payment(db, payment, result)
                return {"ok": True, "status": "paid", "order_id": payment.get("order_id"), "order_status": order.get("status") if order else None}
        except (KeyError, PaymentGatewayError):
            pass

    return {"ok": True, "status": payment.get("status"), "order_id": payment.get("order_id")}


