async def _creator_bulk_collection_quote(db, *, items: Optional[List[dict]] = None) -> Optional[dict]:
    rows = [dict(item or {}) for item in (items or [])]
    if not rows:
        return None

    creator_ids = {str(cid).strip() for cid in (_item_creator_id(item) for item in rows) if cid}
    if len(creator_ids) != 1:
        return None

    creator_id = next(iter(creator_ids))

    creator = await db.bands.find_one({"id": creator_id}, {"_id": 0})
    if not creator:
        creator = await db.creators.find_one({"id": creator_id}, {"_id": 0})
    if not creator:
        return None

    settings = (
        creator.get("bulk_group_collection")
        or creator.get("bulk_collection")
        or creator.get("group_collection")
        or {}
    )

    if not settings.get("enabled"):
        return None

    raw_slots = settings.get("slots") or []
    slots = []
    for slot in raw_slots:
        if not isinstance(slot, dict):
            continue
        if slot.get("enabled") is False:
            continue

        slot_id = str(slot.get("id") or "").strip()
        label = str(slot.get("label") or "").strip()
        date = str(slot.get("date") or "").strip()
        start_time = str(slot.get("start_time") or "").strip()
        end_time = str(slot.get("end_time") or "").strip()

        if not slot_id or not label:
            continue

        slots.append({
            "id": slot_id,
            "label": label,
            "date": date,
            "start_time": start_time,
            "end_time": end_time,
            "cutoff_at": slot.get("cutoff_at"),
            "max_orders": slot.get("max_orders"),
            "enabled": True,
        })

    if not slots:
        return None

    title = settings.get("title") or "Collect in Bulk at Group"

    return {
        "key": "creator_bulk_collection",
        "adapter_key": "creator_bulk_collection",
        "display_name": title,
        "label": title,
        "description": settings.get("description") or "Collect your order at the selected group collection slot.",
        "method_type": "collection",
        "amount": float(settings.get("amount") or 0),
        "sort_order": int(settings.get("sort_order") or 5),
        "tracking_url_template": "",
        "slots": slots,
        "collection_location_name": settings.get("location_name") or "",
        "collection_address": settings.get("address") or "",
        "collection_instructions": settings.get("instructions") or "",
    }


async def _shipping_quotes(db, *, subtotal: float, shipping_address: Optional[dict] = None, items: Optional[List[dict]] = None) -> List[dict]:
    methods = await _get_shipping_methods(db)
    quotes = []

    bulk_collection = await _creator_bulk_collection_quote(db, items=items)
    if bulk_collection:
        quotes.append(bulk_collection)

    for config in methods.values():
        quote = _quote_shipping_method(config, subtotal, shipping_address, items=items)
        if quote:
            quotes.append(quote)

    quotes.sort(key=lambda q: int(q.get("sort_order") or 100))
    return quotes

def _tracking_url_from_template(template: Optional[str], tracking_number: Optional[str]) -> Optional[str]:
    if not template or not tracking_number:
        return None
    return str(template).replace("{tracking_number}", str(tracking_number)).replace("{waybill_number}", str(tracking_number))


async def _shop_paystack_secret_key(db) -> Optional[str]:
    """Return the Paystack key used only for buyer shop checkout orders.

    This must never fall back to owner subscription billing or payout keys.
    """
    settings = await db.settings.find_one({"id": "platform"}, {"_id": 0})
    gateway = ((settings or {}).get("payment_gateways") or {}).get("paystack") or {}
    gateway_secret = ((gateway.get("settings") or {}).get("secret_key") or "").strip()
    if gateway_secret and gateway_secret not in SECRET_PLACEHOLDERS:
        return gateway_secret
    return os.environ.get("PAYSTACK_SHOP_SECRET_KEY") or ""


async def _payout_paystack_secret_key(db) -> Optional[str]:
    """Return the Paystack key used only for platform payout operations.

    Legacy installations stored this on the platform settings document as
    paystack_secret_key. We keep that location for payouts, but no longer allow
    shop checkout or subscription billing to silently reuse it.
    """
    settings = await db.settings.find_one({"id": "platform"}, {"_id": 0})
    secret = (settings or {}).get("paystack_secret_key")
    if secret and str(secret).strip() and str(secret).strip() not in SECRET_PLACEHOLDERS:
        return str(secret).strip()
    return os.environ.get("PAYSTACK_PAYOUT_SECRET_KEY") or os.environ.get("PAYSTACK_SECRET_KEY") or os.environ.get("PAYSTACK_SECRET") or ""


def _mask_platform_settings(doc: Optional[dict]) -> dict:
    data = dict(doc or {})
    data.setdefault("id", "platform")
    data = _normalize_platform_doc(data)
    configured = bool(data.get("paystack_secret_key")) or bool(os.environ.get("PAYSTACK_SECRET_KEY") or os.environ.get("PAYSTACK_SECRET"))
    data["paystack_secret_configured"] = configured
    if data.get("paystack_secret_key"):
        data["paystack_secret_key"] = "********"
    else:
        data["paystack_secret_key"] = None
    gateways = data.get("payment_gateways") or {}
    if isinstance(gateways, dict):
        data["payment_gateways"] = {key: _mask_gateway_config(value) for key, value in gateways.items()}
    return data


async def _paystack_request(db, method: str, path: str, payload: Optional[dict] = None) -> dict:
    secret = await _payout_paystack_secret_key(db)
    if not secret:
        raise HTTPException(status_code=400, detail="Paystack payout secret key is not configured. Add it in Billing & Finance → Wallet / Payouts.")

    url = f"https://api.paystack.co{path}"
    data = None
    headers = {"Authorization": f"Bearer {secret}", "Content-Type": "application/json"}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")

    req = urllib.request.Request(url, data=data, headers=headers, method=method.upper())
    try:
        with urllib.request.urlopen(req, timeout=30) as res:
            body = res.read().decode("utf-8")
            return json.loads(body or "{}")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8")
        try:
            parsed = json.loads(body)
        except Exception:
            parsed = {"message": body}
        raise HTTPException(status_code=400, detail=parsed.get("message") or "Paystack request failed")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Paystack request failed: {e}")


