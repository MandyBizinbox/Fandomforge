@admin_router.post("/subscriptions/{subscription_id}/paystack-checkout")
async def admin_initialize_subscription_paystack_checkout(
    subscription_id: str,
    payload: PaystackSubscriptionCheckoutRequest,
    request: Request,
    user: User = Depends(get_current_user),
):
    _require_owner_user(user)
    db = request.app.state.db
    sub = await db.account_subscriptions.find_one({"id": subscription_id}, {"_id": 0})
    if not sub:
        raise HTTPException(status_code=404, detail="Subscription not found")
    if not sub.get("plan_id"):
        raise HTTPException(status_code=400, detail="Assign a reusable plan before creating a Paystack recurring checkout.")

    plan = await db.subscription_plans.find_one({"id": sub.get("plan_id")}, {"_id": 0})
    if not plan:
        raise HTTPException(status_code=404, detail="Subscription plan not found")
    plan = await _ensure_subscription_plan_synced_with_paystack(db, plan)

    owner_type = _normalise_subscription_owner_type(sub.get("owner_type") or "creator")
    owner = await _get_subscription_owner(db, owner_type, sub.get("owner_id"))
    email = _subscription_owner_email(owner_type, owner)
    if not email:
        raise HTTPException(status_code=400, detail="Subscription owner needs an email address before Paystack billing can start.")

    reference = f"SUB-{new_reference()}"
    amount = _paystack_amount(sub.get("monthly_fee") if sub.get("monthly_fee") is not None else plan.get("monthly_price"))
    if amount <= 0:
        raise HTTPException(status_code=400, detail="Paystack recurring checkout requires a fee greater than zero.")

    callback_url = payload.callback_url or _paystack_subscription_callback_url(request, subscription_id)
    init_payload = {
        "email": email,
        "amount": amount,
        "currency": "ZAR",
        "reference": reference,
        "plan": plan.get("paystack_plan_code"),
        "callback_url": callback_url,
        "metadata": {
            "kind": "subscription",
            "subscription_id": subscription_id,
            "owner_type": owner_type,
            "owner_id": sub.get("owner_id"),
            "plan_id": plan.get("id"),
        },
    }
    res = await _paystack_subscription_request(db, "POST", "/transaction/initialize", init_payload)
    data = res.get("data") or {}
    authorization_url = data.get("authorization_url")
    if not authorization_url:
        raise HTTPException(status_code=400, detail="Paystack did not return a checkout URL.")

    payment = Payment(
        subscription_id=subscription_id,
        user_id=user.id,
        amount=float(amount) / 100,
        provider="paystack",
        provider_reference=reference,
        status="requires_action",
        kind="subscription",
    )
    await db.payments.insert_one(iso_dates(payment.model_dump()))

    updates = {
        "payment_method": "paystack",
        "last_payment_status": "pending_authorization",
        "paystack_plan_code": plan.get("paystack_plan_code"),
        "paystack_plan_name": plan.get("name"),
        "paystack_checkout_url": authorization_url,
        "paystack_reference": reference,
        "paystack_synced_at": utcnow(),
        "updated_at": utcnow(),
    }
    await db.account_subscriptions.update_one({"id": subscription_id}, {"$set": iso_dates(updates)})
    doc = await db.account_subscriptions.find_one({"id": subscription_id}, {"_id": 0})
    return {
        "ok": True,
        "authorization_url": authorization_url,
        "reference": reference,
        "subscription": await _hydrate_subscription(db, doc),
    }


