@payments_router.post("/webhook")
async def payment_webhook(request: Request):
    form = await request.form()
    payload = dict(form) if form else await request.json()
    provider_name = request.query_params.get("provider", "mock")
    provider = get_provider(provider_name)

    if not provider.verify_webhook(payload):
        raise HTTPException(status_code=403, detail="Invalid signature")

    ref = payload.get("m_payment_id") or payload.get("reference")
    db = request.app.state.db
    pay = await db.payments.find_one({"provider_reference": ref}, {"_id": 0})

    if not pay:
        raise HTTPException(status_code=404, detail="Payment not found")

    status = "completed" if (payload.get("payment_status") or "").upper() == "COMPLETE" else "failed"
    now = datetime.now(timezone.utc).isoformat()

    await db.payments.update_one(
        {"id": pay["id"]},
        {"$set": {"status": status, "completed_at": now if status == "completed" else None}},
    )

    if pay.get("order_id") and status == "completed":
        await _mark_order_paid_from_payment(db, pay, payload)

    return {"ok": True}


@payments_router.post("/webhooks/{gateway_key}")
async def gateway_payment_webhook(gateway_key: str, request: Request):
    db = request.app.state.db
    gateway_key = (gateway_key or "").strip().lower()
    raw_body = await request.body()

    if gateway_key != "paystack":
        content_type = (request.headers.get("content-type") or "").lower()
        try:
            if "application/x-www-form-urlencoded" in content_type or gateway_key in {"payfast", "peach"}:
                from urllib.parse import parse_qs
                parsed = parse_qs(raw_body.decode("utf-8") or "", keep_blank_values=True)
                payload = {key: (values[-1] if isinstance(values, list) and values else values) for key, values in parsed.items()}
            else:
                payload = json.loads(raw_body.decode("utf-8") or "{}")
        except Exception:
            raise HTTPException(status_code=400, detail="Invalid payment webhook payload")
        payload["__request_url"] = str(request.url)
        try:
            gateway = await _get_gateway_config(db, gateway_key, masked=False)
            adapter = get_payment_gateway_adapter(gateway_key)
            result = await adapter.handle_webhook(payload, dict(request.headers), gateway, raw_body)
        except KeyError:
            raise HTTPException(status_code=404, detail="Payment gateway not found")
        except PaymentGatewayError as exc:
            raise HTTPException(status_code=403, detail=str(exc))

        reference = result.get("reference")
        provider_payment_id = result.get("payment_id")
        payment = None
        if reference:
            payment = await db.payments.find_one({"provider_reference": reference}, {"_id": 0})
        if not payment and provider_payment_id:
            payment = await db.payments.find_one({"provider_payment_id": provider_payment_id}, {"_id": 0})
        result_order_id = result.get("order_id") or result.get("raw", {}).get("order_id")
        if not payment and result_order_id:
            payment = await db.payments.find_one({"order_id": result_order_id, "provider": gateway_key}, {"_id": 0})

        if not payment:
            return {"ok": True, "processed": False, "status": "payment_not_found"}

        now = datetime.now(timezone.utc).isoformat()
        if result.get("paid"):
            await db.payments.update_one(
                {"id": payment["id"]},
                {"$set": {"status": "completed", "completed_at": now, "provider_payload": payload, "provider_payment_id": provider_payment_id}},
            )
            await _mark_order_paid_from_payment(db, payment, payload)
        elif result.get("status") == "failed":
            await db.payments.update_one(
                {"id": payment["id"]},
                {"$set": {"status": "failed", "completed_at": None, "provider_payload": payload, "provider_payment_id": provider_payment_id}},
            )
            if payment.get("order_id"):
                await db.orders.update_one({"id": payment["order_id"]}, {"$set": {"payment_status": "failed", "provider_payment_id": provider_payment_id, "updated_at": now}})
        else:
            await db.payments.update_one(
                {"id": payment["id"]},
                {"$set": {"provider_payload": payload, "provider_payment_id": provider_payment_id}},
            )

        return {"ok": True, "processed": True, "status": result.get("status"), "event": result.get("event")}

    try:
        payload = json.loads(raw_body.decode("utf-8") or "{}")
    except Exception:
        raise HTTPException(status_code=400, detail="Invalid JSON payload")

    event = payload.get("event")
    data = payload.get("data") or {}
    metadata = data.get("metadata") or {}
    is_subscription_event = bool(metadata.get("kind") == "subscription" or metadata.get("subscription_id") or data.get("subscription_code") or event in ["subscription.create", "subscription.enable", "subscription.disable", "subscription.cancel", "subscription.not_renew", "invoice.payment_failed"])
    if "/platform-billing/" in str(request.url.path):
        is_subscription_event = True

    # Some Paystack charge.success events may not include enough metadata to
    # classify the context before verification. Use the locally-created payment
    # reference to select the correct secret without ever falling back between
    # shop checkout and owner subscription billing.
    context_reference = data.get("reference")
    context_payment = None
    if context_reference:
        context_payment = await db.payments.find_one({"provider_reference": context_reference}, {"_id": 0})
        if context_payment and (context_payment.get("kind") == "subscription" or context_payment.get("subscription_id")):
            is_subscription_event = True

    signature = request.headers.get("x-paystack-signature")
    expected_secret = await (_subscription_billing_webhook_secret(db) if is_subscription_event else _shop_paystack_secret_key(db))
    if not expected_secret:
        detail = "Owner Paystack subscription secret key is not configured." if is_subscription_event else "Shop Paystack checkout secret key is not configured."
        raise HTTPException(status_code=400, detail=detail)
    if not _verify_paystack_signature(expected_secret, raw_body, signature):
        raise HTTPException(status_code=403, detail="Invalid Paystack signature for this Paystack context")

    data = payload.get("data") or {}
    reference = data.get("reference")
    metadata = data.get("metadata") or {}
    subscription_id = metadata.get("subscription_id") or data.get("subscription_id")
    subscription_code = data.get("subscription_code") or data.get("subscription")

    payment = context_payment
    if reference and not payment:
        payment = await db.payments.find_one({"provider_reference": reference}, {"_id": 0})

    if not subscription_id and payment and payment.get("subscription_id"):
        subscription_id = payment.get("subscription_id")

    subscription = None
    if subscription_id:
        subscription = await db.account_subscriptions.find_one({"id": subscription_id}, {"_id": 0})
    if not subscription and subscription_code:
        subscription = await db.account_subscriptions.find_one({"paystack_subscription_code": subscription_code}, {"_id": 0})

    now = datetime.now(timezone.utc).isoformat()

    if event == "charge.success" and data.get("status") == "success":
        if payment:
            await db.payments.update_one(
                {"id": payment["id"]},
                {"$set": {"status": "completed", "completed_at": now, "provider_payload": payload}},
            )
            if payment.get("order_id"):
                await _mark_order_paid_from_payment(db, payment, payload)
        if subscription:
            await _mark_subscription_paid_from_paystack(db, subscription, data, event=event)

    elif event in ["subscription.create", "subscription.enable"] and subscription:
        updates = {
            "status": "active",
            "payment_method": "paystack",
            "paystack_subscription_code": _paystack_subscription_code_from_payload(data, subscription.get("paystack_subscription_code")),
            "paystack_email_token": _paystack_email_token_from_payload(data, subscription.get("paystack_email_token")),
            "paystack_plan_code": _paystack_plan_code_from_payload(data, subscription.get("paystack_plan_code")),
            "paystack_last_event": event,
            "paystack_synced_at": utcnow(),
            "updated_at": utcnow(),
        }
        updates.update(_subscription_access_from_status("active", subscription.get("owner_type") or "creator"))
        await db.account_subscriptions.update_one({"id": subscription["id"]}, {"$set": iso_dates(updates)})
        doc = await db.account_subscriptions.find_one({"id": subscription["id"]}, {"_id": 0})
        await _sync_owner_subscription_status(db, doc)

    elif event in ["invoice.payment_failed", "charge.failed", "subscription.not_renew"]:
        if payment:
            await db.payments.update_one({"id": payment["id"]}, {"$set": {"status": "failed", "completed_at": None, "provider_payload": payload}})
            if payment.get("order_id"):
                await db.orders.update_one({"id": payment["order_id"]}, {"$set": {"payment_status": "failed", "updated_at": now}})
        if subscription:
            await _mark_subscription_failed_from_paystack(db, subscription, event, payload)

    elif event in ["subscription.disable", "subscription.cancel"] and subscription:
        updates = {
            "status": "cancelled",
            "cancelled_at": utcnow(),
            "last_payment_status": "cancelled",
            "paystack_last_event": event,
            "paystack_synced_at": utcnow(),
            "updated_at": utcnow(),
        }
        updates.update(_subscription_access_from_status("cancelled", subscription.get("owner_type") or "creator"))
        await db.account_subscriptions.update_one({"id": subscription["id"]}, {"$set": iso_dates(updates)})
        doc = await db.account_subscriptions.find_one({"id": subscription["id"]}, {"_id": 0})
        await _sync_owner_subscription_status(db, doc)

    return {"ok": True}


