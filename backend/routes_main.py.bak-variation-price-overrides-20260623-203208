print_options_router = APIRouter(prefix="/print-options")


def normalize_print_option_payload(data: dict) -> dict:
    data = dict(data)

    calculation_type = (data.get("calculation_type") or "fixed").strip() or "fixed"
    allowed_calculation_types = {"fixed", "area_from_sheet", "area_fixed_rate", "sheet"}
    if calculation_type not in allowed_calculation_types:
        calculation_type = "fixed"
    data["calculation_type"] = calculation_type

    rule_name = (data.get("rule_name") or data.get("print_method") or "").strip()
    if not rule_name:
        raise HTTPException(status_code=400, detail="Rule name / print method is required")

    method_key = (data.get("method_key") or "").strip()
    if not method_key:
        method_key = slugify(rule_name).replace("-", "_")

    print_method = (data.get("print_method") or rule_name).strip()
    if not print_method:
        print_method = rule_name

    print_size = (data.get("print_size") or "").strip()
    if not print_size:
        if calculation_type == "area_from_sheet":
            print_size = "Dynamic area from sheet"
        elif calculation_type == "area_fixed_rate":
            print_size = "Dynamic area cm²"
        elif calculation_type == "sheet":
            print_size = "Full sheet"
        else:
            print_size = "Fixed price"

    standard_key = (data.get("standard_print_size_key") or "").strip()
    if not standard_key:
        if calculation_type == "area_from_sheet":
            standard_key = "dynamic_area_from_sheet"
        elif calculation_type == "area_fixed_rate":
            standard_key = "dynamic_area_cm2"
        elif calculation_type == "sheet":
            standard_key = "full_sheet"
        else:
            standard_key = "fixed_price"

    data["rule_name"] = rule_name
    data["method_key"] = method_key
    data["print_method"] = print_method
    data["print_size"] = print_size
    data["standard_print_size_key"] = standard_key

    data["print_positions"] = [
        str(position).strip()
        for position in data.get("print_positions", [])
        if str(position).strip()
    ]

    for numeric_key in (
        "print_cost_max",
        "width_mm",
        "height_mm",
        "sheet_width_mm",
        "sheet_height_mm",
        "sheet_cost",
        "cost_per_cm2",
        "minimum_print_cost",
        "waste_percentage",
        "markup_percentage",
    ):
        if numeric_key in data:
            data[numeric_key] = float(data.get(numeric_key) or 0)

    data["dpi"] = int(data.get("dpi") or 300)
    data["fit_mode"] = (data.get("fit_mode") or "contain").strip() or "contain"

    if data["calculation_type"] == "area_from_sheet":
        sheet_area_cm2 = (float(data.get("sheet_width_mm") or 0) / 10) * (float(data.get("sheet_height_mm") or 0) / 10)
        if sheet_area_cm2 > 0 and float(data.get("sheet_cost") or 0) > 0:
            data["cost_per_cm2"] = round(float(data.get("sheet_cost") or 0) / sheet_area_cm2, 6)

    data["pricing_notes"] = (data.get("pricing_notes") or "").strip()
    data["production_notes"] = (data.get("production_notes") or "").strip()

    if not data.get("slug"):
        data["slug"] = slugify(rule_name)

    return data


