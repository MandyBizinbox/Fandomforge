def _gateway_has_secret(config: dict) -> bool:
    settings = config.get("settings") or {}
    for key in SECRET_SETTING_KEYS:
        value = settings.get(key)
        if value and str(value).strip() and str(value).strip() not in ["********", "••••••••"]:
            return True
    return False


def _mask_gateway_config(config: dict) -> dict:
    data = dict(config or {})
    settings = dict(data.get("settings") or {})
    secret_configured = False
    for key in SECRET_SETTING_KEYS:
        value = settings.get(key)
        if value and str(value).strip() and str(value).strip() not in ["********", "••••••••"]:
            settings[key] = "********"
            secret_configured = True
    data["settings"] = settings
    data["secret_configured"] = secret_configured or bool(data.get("secret_configured"))
    return data


def _public_gateway_config(config: dict) -> dict:
    data = _mask_gateway_config(config)
    return {
        "key": data.get("key"),
        "enabled": bool(data.get("enabled")),
        "display_name": data.get("display_name") or data.get("key"),
        "description": data.get("description") or "",
        "mode": data.get("mode") or "test",
