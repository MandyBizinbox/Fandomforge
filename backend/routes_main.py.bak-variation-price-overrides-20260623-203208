def _default_shipping_methods() -> Dict[str, dict]:
    defaults: Dict[str, dict] = {}
    for key, adapter in registered_shipping_method_adapters().items():
        config = adapter.default_config()
        config["key"] = key
        config["adapter_key"] = config.get("adapter_key") or key
        defaults[key] = config
    return defaults


def _shipping_adapter_for_config(config: dict):
    adapter_key = (config.get("adapter_key") or config.get("key") or config.get("method_type") or "manual_shipping").strip()
    try:
        return get_shipping_method_adapter(adapter_key)
    except KeyError:
        # Safe fallback for legacy/unknown configs. This prevents one bad courier
        # entry from breaking checkout entirely.
        return get_shipping_method_adapter("manual_shipping")


def _mask_shipping_method_for_admin(config: dict) -> dict:
    masked = dict(config or {})
    settings = dict(masked.get("settings") or {})
    adapter = _shipping_adapter_for_config(masked)
    for field in adapter.settings_schema or []:
        if field.get("type") == "password" and settings.get(field.get("key")):
            settings[field.get("key")] = "********"
    masked["settings"] = settings
    return masked


def _merge_shipping_config(default: dict, current: dict) -> dict:
    item = {**(default or {}), **(current or {})}
    item["key"] = (default or {}).get("key") or (current or {}).get("key")
    item["adapter_key"] = item.get("adapter_key") or item.get("key")
    item["public_config"] = {**((default or {}).get("public_config") or {}), **((current or {}).get("public_config") or {})}
    item["settings"] = {**((default or {}).get("settings") or {}), **((current or {}).get("settings") or {})}
    adapter = _shipping_adapter_for_config(item)
    return adapter.validate_config(item)


def _quote_shipping_method(config: dict, subtotal: float, address: Optional[dict], items: Optional[List[dict]] = None) -> Optional[dict]:
    adapter = _shipping_adapter_for_config(config)
    return adapter.quote(config=config, subtotal=subtotal, items=items or [], shipping_address=address)


async def _get_shipping_methods(db) -> Dict[str, dict]:
    doc = await _get_platform_settings_doc(db)
    existing = dict(doc.get("shipping_methods") or {})
    defaults = _default_shipping_methods()
    merged: Dict[str, dict] = {}
    for key, default in defaults.items():
        merged[key] = _merge_shipping_config(default, dict(existing.get(key) or {}))

    # Preserve custom/future code-level adapter configs that may exist in DB.
    # If their adapter is not registered anymore they will still be shown as
    # manual fallback in admin, but checkout will not crash.
    for key, current in existing.items():
        if key not in merged:
            current = dict(current or {})
            current["key"] = key
            current["adapter_key"] = current.get("adapter_key") or key
            merged[key] = _merge_shipping_config(current, current)
    return merged


def _item_creator_id(item: dict) -> Optional[str]:
