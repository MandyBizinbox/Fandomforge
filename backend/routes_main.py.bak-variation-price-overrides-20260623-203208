        doc = _default_subscription_billing_settings()
        await db.settings.update_one({"id": "subscription_billing"}, {"$set": iso_dates(doc)}, upsert=True)
    return _mask_subscription_billing_settings(doc) if masked else {**_default_subscription_billing_settings(), **doc}


async def _subscription_billing_secret(db) -> str:
    settings = await _get_subscription_billing_settings(db, masked=False)
    secret = str(settings.get("secret_key") or settings.get("paystack_secret_key") or "").strip()
    if secret and secret not in SECRET_PLACEHOLDERS:
        return secret
    return os.environ.get("PAYSTACK_SUBSCRIPTION_SECRET_KEY") or os.environ.get("PAYSTACK_OWNER_SECRET_KEY") or os.environ.get("PAYSTACK_SECRET_KEY") or os.environ.get("PAYSTACK_SECRET") or ""


async def _subscription_billing_webhook_secret(db) -> str:
    # Paystack signs webhooks with the same secret key as the integration.
    # Keep this helper for route clarity, but do not store a separate webhook secret.
    return await _subscription_billing_secret(db)


async def _paystack_subscription_request(db, method: str, path: str, payload: Optional[dict] = None) -> dict:
    settings = await _get_subscription_billing_settings(db, masked=False)
    if not settings.get("enabled"):
        raise HTTPException(
            status_code=400,
            detail="Owner subscription billing is disabled. Enable it in Admin → Settings → Owner Subscription Billing.",
        )

    secret = await _subscription_billing_secret(db)
    if not secret:
        raise HTTPException(
            status_code=400,
            detail="Owner Paystack subscription secret key is not configured in Admin → Settings → Owner Subscription Billing.",
        )
    if not str(secret).startswith(("sk_test_", "sk_live_")):
        raise HTTPException(
            status_code=400,
            detail="Owner Paystack subscription secret key is invalid. It must start with sk_test_ or sk_live_.",
        )

    url = f"https://api.paystack.co{path}"
    headers = {
        "Authorization": f"Bearer {secret}",
        "Content-Type": "application/json",
        "Accept": "application/json",
        "User-Agent": "FandomForge-FandomForge/1.0 (+https://www.fandomforge.co.za)",
    }

    try:
        response = requests.request(
            method.upper(),
            url,
            headers=headers,
            json=payload if payload is not None else None,
            timeout=30,
        )
        raw_body = response.text or ""
        try:
            parsed = response.json()
        except Exception:
            parsed = {
                "status": False,
                "message": raw_body[:1000] or f"Paystack returned HTTP {response.status_code}",
                "raw_body": raw_body[:2000],
            }

        log_doc = {
            "id": uid(),
            "provider": "paystack",
            "kind": "subscription_billing",
            "method": method.upper(),
            "path": path,
            "status_code": response.status_code,
            "ok": response.status_code < 400 and parsed.get("status") is not False,
            "request_payload": {k: v for k, v in (payload or {}).items() if k not in {"authorization", "secret_key"}},
            "response": parsed,
            "raw_body": raw_body[:2000],
            "created_at": utcnow().isoformat(),
        }
        try:
            await db.payment_provider_logs.insert_one(log_doc)
        except Exception:
            pass

        if response.status_code >= 400 or parsed.get("status") is False:
            message = parsed.get("message") or parsed.get("error") or parsed.get("raw_body") or f"Paystack returned HTTP {response.status_code}"
            code = parsed.get("code")
            meta = parsed.get("meta") or {}
            next_step = meta.get("nextStep") or meta.get("next_step")
            detail_parts = [str(message)]
            if code:
                detail_parts.append(f"code: {code}")
            if next_step:
                detail_parts.append(f"next step: {next_step}")
            raise HTTPException(status_code=400, detail=" | ".join(detail_parts))

        return parsed
    except HTTPException:
        raise
    except requests.RequestException as e:
        raise HTTPException(status_code=400, detail=f"Paystack subscription request failed: {e}")


