def _clean_account_asset_value(value):
    return value if value not in ("", None) else None


def _clean_socials(value):
    return value if isinstance(value, dict) else {}

PRINT_METHOD_ALIASES = {
    "dtf": "dtf",
    "direct to film": "dtf",
    "sublimation": "sublimation",
    "embroidery": "embroidery",
    "vinyl": "vinyl",
    "screen print": "screen_print",
    "screen_print": "screen_print",
    "screen printing": "screen_print",
    "dtg": "dtg",
    "laser": "laser",
    "uv print": "uv_print",
    "uv_print": "uv_print",
}

AREA_TAG_ALIASES = {
    "front": "front",
    "front_full": "front",
    "back": "back",
    "back_full": "back",
    "sleeve": "sleeve",
    "left_sleeve": "sleeve",
    "right_sleeve": "sleeve",
    "neck": "neck_label",
    "neck_label": "neck_label",
    "neck label": "neck_label",
    "pocket": "pocket",
}


def _normalise_key(value: str) -> str:
    return str(value or "").strip().lower().replace("-", "_").replace(" ", "_")


def _normalise_print_method_key(value: str) -> str:
    raw = str(value or "").strip().lower().replace("-", " ").replace("_", " ")
    return PRINT_METHOD_ALIASES.get(raw, _normalise_key(value))


def _normalise_area_tag(value: str) -> str:
    raw = str(value or "").strip().lower().replace("-", " ").replace("_", " ")
    return AREA_TAG_ALIASES.get(raw, _normalise_key(value))


def _clean_string_list(values) -> list:
    out = []
    for value in values or []:
        cleaned = str(value or "").strip()
        if cleaned and cleaned not in out:
            out.append(cleaned)
    return out


def _normalise_printer_capability_fields(data: dict) -> dict:
    data = dict(data or {})

    data["capabilities"] = _clean_string_list(data.get("capabilities") or [])
    data["print_methods"] = list(dict.fromkeys([
        _normalise_print_method_key(value)
        for value in data.get("print_methods") or []
        if str(value or "").strip()
    ]))
    data["area_tags"] = list(dict.fromkeys([
        _normalise_area_tag(value)
        for value in data.get("area_tags") or []
        if str(value or "").strip()
    ]))

    matrix = []
    for row in data.get("capability_matrix") or []:
        if not isinstance(row, dict):
            continue
        method_key = _normalise_print_method_key(row.get("method_key") or row.get("print_method") or row.get("method"))
        area_tag = _normalise_area_tag(row.get("area_tag") or row.get("area_key") or row.get("tag"))
        if not method_key or not area_tag:
            continue

        matrix.append({
            "method_key": method_key,
            "area_tag": area_tag,
            "active": bool(row.get("active", True)),
            "turnaround_time": str(row.get("turnaround_time") or data.get("turnaround_time") or "").strip(),
            "notes": str(row.get("notes") or "").strip(),
        })

    # If no explicit matrix is supplied, build active combinations from methods × area tags.
    if not matrix and data["print_methods"] and data["area_tags"]:
        for method_key in data["print_methods"]:
            for area_tag in data["area_tags"]:
                matrix.append({
                    "method_key": method_key,
                    "area_tag": area_tag,
                    "active": True,
                    "turnaround_time": str(data.get("turnaround_time") or "").strip(),
                    "notes": "",
                })

    # Matrix should also keep print_methods and area_tags complete.
    for row in matrix:
        if row["method_key"] not in data["print_methods"]:
            data["print_methods"].append(row["method_key"])
        if row["area_tag"] not in data["area_tags"]:
            data["area_tags"].append(row["area_tag"])

    unique = {}
    for row in matrix:
        unique[f'{row["method_key"]}::{row["area_tag"]}'] = row
    data["capability_matrix"] = list(unique.values())

    return data




async def _ensure_user_exists(db, user_id: Optional[str]) -> Optional[dict]:
    if not user_id:
        return None
    doc = await db.users.find_one({"id": user_id}, {"_id": 0})
    if not doc:
        raise HTTPException(status_code=400, detail="Linked user not found")
    return doc


def _normalise_account_status(status: Optional[str], fallback: str = "active") -> str:
    value = (status or fallback).strip()
    validate_user_status(value)
    return value


