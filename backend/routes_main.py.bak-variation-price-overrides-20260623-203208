def normalize_template_payload(data: dict) -> dict:
    """Normalize admin product template payloads and keep legacy fields compatible."""
    data = dict(data)

    name = (data.get("name") or "").strip()
    if not name:
        raise HTTPException(status_code=400, detail="Template name is required")

    data["name"] = name
    data["slug"] = slugify(data.get("slug") or name)
    data["product_type_id"] = (data.get("product_type_id") or "").strip()

    if not (data.get("category") or "").strip():
        raise HTTPException(status_code=400, detail="Category is required")

    base_blank_cost = data.get("base_blank_cost")
    base_price = data.get("base_price")

    if base_blank_cost in (None, 0) and base_price not in (None, 0):
        data["base_blank_cost"] = float(base_price)

    if base_price in (None, 0) and data.get("base_blank_cost") not in (None, 0):
        data["base_price"] = float(data["base_blank_cost"])

    for key in ("available_sizes", "available_colors", "mockup_images", "attribute_ids", "print_option_ids"):
        data[key] = [
            str(item).strip() for item in data.get(key, []) if str(item).strip()
        ]

    # Template print rule compatibility:
    # Older records may have selected print rules embedded in print_options
    # or assigned directly on print_areas without also mirroring them into
    # template.print_option_ids. Keep the template-level ID list authoritative
    # by deriving it from all three locations.
    derived_print_option_ids = set(data.get("print_option_ids") or [])

    for option in data.get("print_options") or []:
        if isinstance(option, dict) and option.get("id"):
            derived_print_option_ids.add(str(option.get("id")).strip())

    for area in data.get("print_areas") or []:
        if not isinstance(area, dict):
            continue
        for option_id in area.get("allowed_print_option_ids") or []:
            if str(option_id).strip():
                derived_print_option_ids.add(str(option_id).strip())

    data["print_option_ids"] = sorted(derived_print_option_ids)

    if data.get("product_image_url") and not data.get("mockup_url"):
        data["mockup_url"] = data.get("product_image_url")

    if data.get("mockup_url") and data.get("mockup_url") not in data.get("mockup_images", []):
        data["mockup_images"] = [data["mockup_url"], *data.get("mockup_images", [])]

    def dump_nested(value):
        return value if isinstance(value, dict) else value.model_dump()

    if not isinstance(data.get("selected_attribute_values"), dict):
        data["selected_attribute_values"] = {}

    data["mockup_screens"] = [dump_nested(screen) for screen in data.get("mockup_screens", [])]
    for screen in data["mockup_screens"]:
        if isinstance(screen, dict):
            screen["view_key"] = screen.get("view_key") or screen.get("view") or "front"
            screen["view"] = screen.get("view") or screen.get("view_key") or "front"

    data["variations"] = [dump_nested(variation) for variation in data.get("variations", [])]

    # Phase 1B: keep old blank cost fields compatible with the new
    # platform_blank_cost / creator_blank_price split.
    template_blank_costing = _resolve_blank_costing({}, data)
    data["platform_blank_cost"] = data.get("platform_blank_cost") or template_blank_costing["platform_blank_cost"]
    data["creator_blank_price"] = data.get("creator_blank_price") or template_blank_costing["creator_blank_price"]

    for variation in data["variations"]:
        if isinstance(variation, dict):
            costing = _resolve_blank_costing(variation, data)
            variation["platform_blank_cost"] = variation.get("platform_blank_cost") or costing["platform_blank_cost"]
            variation["creator_blank_price"] = variation.get("creator_blank_price") or costing["creator_blank_price"]
            variation["platform_blank_profit"] = costing["platform_blank_profit"]
            variation["platform_blank_margin_percent"] = costing["platform_blank_margin_percent"]

            # Legacy compatibility for older UI components.
            if not variation.get("base_blank_cost"):
                variation["base_blank_cost"] = costing["platform_blank_cost"]
            if not variation.get("cost"):
                variation["cost"] = costing["platform_blank_cost"]

    data["print_areas"] = [dump_nested(area) for area in data.get("print_areas", [])]
    for area in data["print_areas"]:
        if isinstance(area, dict):
            area["view_key"] = area.get("view_key") or area.get("screen_view") or "front"
            area["screen_view"] = area.get("screen_view") or area.get("view_key") or "front"
            area["area_key"] = area.get("area_key") or "custom"
            area = _normalise_print_area_coordinates(area)
            area["standard_print_size_key"] = area.get("standard_print_size_key") or area.get("print_size") or "custom"
            area["print_size"] = area.get("print_size") or area.get("standard_print_size_key") or "custom"
            area["dpi"] = int(area.get("dpi") or 300)
            area["fit_mode"] = area.get("fit_mode") or "contain"
            area["required"] = bool(area.get("required") or False)
            area["allowed_print_option_ids"] = [
                str(option_id).strip()
                for option_id in area.get("allowed_print_option_ids", [])
                if str(option_id).strip()
            ]

    # Re-derive once more after print areas have been normalised.
    derived_print_option_ids = set(data.get("print_option_ids") or [])
    for area in data["print_areas"]:
        if isinstance(area, dict):
            derived_print_option_ids.update(area.get("allowed_print_option_ids") or [])
    data["print_option_ids"] = sorted(str(option_id).strip() for option_id in derived_print_option_ids if str(option_id).strip())

    data["print_options"] = [dump_nested(option) for option in data.get("print_options", [])]

    for option in data["print_options"]:
        if isinstance(option, dict):
            costing = _resolve_print_costing(option, None, option.get("print_cost_max") or 0)
            option["platform_print_cost"] = option.get("platform_print_cost") or costing["platform_print_cost"]
            option["creator_print_price"] = option.get("creator_print_price") or costing["creator_print_price"]
            option["platform_print_profit"] = costing["platform_print_profit"]
            option["platform_print_margin_percent"] = costing["platform_print_margin_percent"]

            # Legacy compatibility.
            if not option.get("print_cost_max"):
                option["print_cost_max"] = costing["platform_print_cost"]

    # Keep legacy option field names compatible with the new global Print Option CRUD.
    for option in data["print_options"]:
        if option.get("print_method") and not option.get("method"):
            option["method"] = option["print_method"]
        if option.get("method") and not option.get("print_method"):
            option["print_method"] = option["method"]

    return data


def _template_image_for_area(template: dict, print_area: Optional[dict] = None) -> Optional[str]:
    screens = template.get("mockup_screens") or []

