def notification_type_for_event(kind: str) -> str:
    if kind in ("artwork_reviewed",):
        return "artwork"
    if kind in ("order_created", "manual_order_created", "order_status_changed"):
        return "order"
    if kind in ("production_status_changed", "printer_assigned", "tracking_updated"):
        return "production"
    if kind in ("payment_updated",):
        return "payment"
    if kind in ("internal_note",):
        return "note"
    return "system"


def notification_link_for_role(role: str, event: OrderEvent) -> str:
    order_id = event.order_id
    if event.kind == "artwork_reviewed" or (event.metadata or {}).get("link_kind") == "artwork_review":
        if role in ("admin", "super_admin"):
            return "/admin/artwork-review"
        if role in ("creator", "creator"):
            return f"/creator/products/{event.product_id}" if event.product_id else "/creator/products"
    if order_id:
        if role in ("admin", "super_admin"):
            return f"/admin/orders/{order_id}"
        if role in ("creator", "creator"):
            return f"/creator/orders/{order_id}"
        if role == "printer":
            return f"/printer/orders/{order_id}"
    if role in ("admin", "super_admin"):
        return "/admin/activity"
    if role in ("creator", "creator"):
        return "/creator/activity"
    if role == "printer":
        return "/printer/activity"
    return "/account"


async def notification_recipient_users_for_event(db, event: OrderEvent) -> List[dict]:
    recipients: Dict[str, dict] = {}
    audience = set(event.audience or ["admin"])
    if "all" in audience:
        audience.update(["admin", "creator", "printer"])

    if "admin" in audience:
        admins = await db.users.find(
            {"role": {"$in": ["admin", "super_admin"]}, "status": {"$ne": "archived"}},
            {"_id": 0},
        ).to_list(500)
        for admin_user in admins:
            recipients[admin_user["id"]] = admin_user

    if event.band_id and ("creator" in audience or "creator" in audience):
        creator = await db.creators.find_one({"id": event.band_id}, {"_id": 0})
        if creator and creator.get("user_id"):
            owner = await db.users.find_one({"id": creator["user_id"]}, {"_id": 0})
            if owner:
                recipients[owner["id"]] = owner
        members = await db.band_members.find({"band_id": event.band_id, "status": "active"}, {"_id": 0}).to_list(500)
        member_user_ids = [m.get("user_id") for m in members if m.get("user_id")]
        if member_user_ids:
            users = await db.users.find({"id": {"$in": member_user_ids}}, {"_id": 0}).to_list(500)
            for member_user in users:
                recipients[member_user["id"]] = member_user

    if event.printer_id and "printer" in audience:
        printer = await db.printers.find_one({"id": event.printer_id}, {"_id": 0})
        if printer and printer.get("user_id"):
            printer_user = await db.users.find_one({"id": printer["user_id"]}, {"_id": 0})
            if printer_user:
                recipients[printer_user["id"]] = printer_user

    if event.metadata.get("recipient_user_id"):
        direct = await db.users.find_one({"id": event.metadata["recipient_user_id"]}, {"_id": 0})
        if direct:
            recipients[direct["id"]] = direct

    if event.actor_user_id and event.actor_user_id in recipients and len(recipients) > 1:
        recipients.pop(event.actor_user_id, None)

    return list(recipients.values())


async def create_notifications_for_event(db, event: OrderEvent, *, queue_email: bool = True) -> None:
    try:
        recipients = await notification_recipient_users_for_event(db, event)
        if not recipients:
            return

        now = utcnow()
        notification_docs = []
        email_docs = []
        for recipient in recipients:
            role = recipient.get("role") or "buyer"
            notification = Notification(
                recipient_user_id=recipient.get("id"),
                recipient_role=role,
                recipient_email=recipient.get("email"),
                title=event.title,
                message=event.message or "",
                type=notification_type_for_event(event.kind),
                event_kind=event.kind,
                link_url=event.metadata.get("link_url") or notification_link_for_role(role, event),
                related_order_id=event.order_id,
                related_order_number=event.order_number,
                related_order_item_id=event.order_item_id,
                related_product_id=event.product_id,
                related_product_title=event.product_title,
                band_id=event.band_id,
                printer_id=event.printer_id,
                metadata=event.metadata or {},
                created_at=now,
            )
            notification_docs.append(notification_doc(notification))

            if queue_email and recipient.get("email"):
                email = NotificationEmail(
                    notification_id=notification.id,
                    recipient_user_id=recipient.get("id"),
                    recipient_email=recipient["email"],
                    subject=event.title,
                    body=(event.message or event.title),
                    status="queued",
                    created_at=now,
                )
                email_docs.append(notification_email_doc(email))

        if notification_docs:
            await db.notifications.insert_many(notification_docs)
        if email_docs:
            await db.notification_emails.insert_many(email_docs)
    except Exception:
        logging.getLogger("fandomforge.notifications").exception("Failed to create notifications")


async def add_order_event(
