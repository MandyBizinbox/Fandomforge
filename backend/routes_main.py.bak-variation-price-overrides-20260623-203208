        or 0
    )

    commission_rate = float(product.get("commission_rate") or 0.15)
    selling_price = float(product.get("selling_price") or product.get("customer_selling_price") or 0)

    costing = _platform_costing_breakdown(
        blank_supplier_cost,
        platform_print_cost,
        commission_rate,
        selling_price,
        quantity,
        creator_blank_price=creator_blank_price,
        creator_print_price=creator_print_price,
    )

    blank_cost = costing["blank_payout_unit"]
    print_cost = costing["print_payout_unit"]
    production_cost = costing["production_cost"]
    platform_commission = costing["platform_commission"]
    creator_profit = costing["creator_profit"]
    printer_payout = costing["printer_payout"]

    return {
