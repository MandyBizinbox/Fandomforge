    out["metadata"] = metadata
    return out


async def ensure_wallet_transactions_for_order(db, order_doc: dict) -> None:
    """Create idempotent wallet ledger entries from an order's financial item fields."""
    if not order_doc:
        return

    order_id = order_doc.get("id")
    order_number = order_doc.get("order_number")
    if not order_id:
        return

    for item in order_doc.get("items", []) or []:
        order_item_id = item.get("id")
        band_id = item.get("band_id")
        printer_id = item.get("printer_id")

        entries = []
        commission = float(item.get("commission_amount") or 0)
        creator_earning = float(item.get("band_earnings") or 0)
        printer_payout = float(item.get("printer_payout") or 0)

        if commission > 0:
            entries.append(WalletTransaction(
                owner_type="platform",
                owner_id="platform",
                order_id=order_id,
                order_number=order_number,
                order_item_id=order_item_id,
                amount=round(commission, 2),
                type="platform_commission",
                status="available",
                description=f"Platform commission for order {order_number}",
                source_collection="orders",
                source_id=order_id,
            ))

        if band_id and creator_earning > 0:
            entries.append(WalletTransaction(
                owner_type="creator",
                owner_id=band_id,
                order_id=order_id,
                order_number=order_number,
                order_item_id=order_item_id,
                amount=round(creator_earning, 2),
                type="creator_earning",
                status="available",
                description=f"Creator earning for order {order_number}",
                source_collection="orders",
                source_id=order_id,
            ))

        if printer_id and printer_payout > 0:
            entries.append(WalletTransaction(
                owner_type="printer",
                owner_id=printer_id,
                order_id=order_id,
                order_number=order_number,
                order_item_id=order_item_id,
                amount=round(printer_payout, 2),
                type="printer_payout",
                status="available",
                description=f"Printer payout for order {order_number}",
                source_collection="orders",
                source_id=order_id,
            ))

        for entry in entries:
            existing = await db.wallet_transactions.find_one({
                "order_id": entry.order_id,
                "order_item_id": entry.order_item_id,
                "owner_type": entry.owner_type,
                "owner_id": entry.owner_id,
                "type": entry.type,
            })
            if not existing:
                await db.wallet_transactions.insert_one(iso_dates(entry.model_dump()))


async def rebuild_wallet_ledger_from_paid_orders(db) -> int:
    count = 0
    cursor = db.orders.find({"payment_status": "paid"}, {"_id": 0})
    async for order in cursor:
        before = await db.wallet_transactions.count_documents({})
        await ensure_wallet_transactions_for_order(db, order)
        after = await db.wallet_transactions.count_documents({})
        count += max(0, after - before)
    return count




