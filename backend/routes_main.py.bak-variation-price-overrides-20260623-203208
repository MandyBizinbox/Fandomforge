def _normalize_platform_doc(doc: Optional[dict]) -> dict:
    base = PlatformSettings().model_dump()
    if doc:
        base.update(dict(doc))
    base["modules"] = normalize_modules(base.get("modules"))
    if base.get("package_key") not in package_keys():
        base["package_key"] = "full_marketplace"
    return base


async def _get_platform_settings_doc(db) -> dict:
    doc = await db.settings.find_one({"id": "platform"}, {"_id": 0})
    normalized = _normalize_platform_doc(doc)
    if not doc:
        await db.settings.insert_one(normalized)
    elif normalized.get("modules") != doc.get("modules") or normalized.get("package_key") != doc.get("package_key"):
        await db.settings.update_one(
            {"id": "platform"},
            {"$set": {"modules": normalized.get("modules"), "package_key": normalized.get("package_key")}},
            upsert=True,
        )
    return normalized


def _module_enabled(settings: dict, module_key: str) -> bool:
    modules = normalize_modules((settings or {}).get("modules"))
    return bool(modules.get(module_key, False))


async def _require_module(db, module_key: str, label: str = "This module") -> dict:
    settings = await _get_platform_settings_doc(db)
    if not _module_enabled(settings, module_key):
        raise HTTPException(status_code=403, detail=f"{label} is disabled for this platform package")
    return settings


