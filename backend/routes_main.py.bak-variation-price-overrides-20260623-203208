async def _get_payment_gateways(db, mask: bool = True) -> Dict[str, dict]:
    doc = await _get_platform_settings_doc(db)
    existing = dict(doc.get("payment_gateways") or {})
    defaults = _default_payment_gateways()
    merged: Dict[str, dict] = {}
    for key, default in defaults.items():
        current = dict(existing.get(key) or {})
        item = {**default, **current}
        item["key"] = key
        item["public_config"] = {**(default.get("public_config") or {}), **(current.get("public_config") or {})}
        item["settings"] = {**(default.get("settings") or {}), **(current.get("settings") or {})}
        merged[key] = _mask_gateway_config(item) if mask else item
    return merged


