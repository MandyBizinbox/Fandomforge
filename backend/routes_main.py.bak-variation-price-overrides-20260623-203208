@admin_router.post("/orders/{order_id}/auto-assign-printers", response_model=Order)
async def admin_auto_assign_order_printers(
    order_id: str,
    request: Request,
    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_orders")
    db = request.app.state.db
    order = await db.orders.find_one({"id": order_id}, {"_id": 0})

    if not order:
        raise HTTPException(status_code=404, detail="Order not found")

    items = order.get("items", [])
    changed = False

    for index, item in enumerate(items):
        product = await db.products.find_one({"id": item.get("product_id")}, {"_id": 0})
        if not product:
            continue

        template = None
        if product.get("template_id"):
            template = await db.product_templates.find_one({"id": product.get("template_id")}, {"_id": 0})

        price = await _best_printer_price_for_product(db, product, template)
        if not price:
            continue

        qty = max(int(item.get("quantity") or 1), 1)
        unit_payout = float(price.get("total_price") or (float(price.get("blank_price") or 0) + float(price.get("print_price") or 0)))
        items[index]["printer_id"] = price.get("printer_id")
        items[index]["print_cost_unit"] = float(price.get("print_price") or 0)
        items[index]["printer_payout"] = unit_payout * qty

        snapshot = items[index].get("production_snapshot") or {}
        snapshot = _merge_printer_price_into_snapshot(snapshot, price, qty)
        items[index]["production_snapshot"] = snapshot
        changed = True

    if changed:
        await db.orders.update_one(
            {"id": order_id},
            {"$set": {"items": items, "updated_at": utcnow().isoformat()}},
        )

    doc = await db.orders.find_one({"id": order_id}, {"_id": 0})
    return Order(**doc)


