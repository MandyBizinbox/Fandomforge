@public_router.post("/signup/creator")
async def public_creator_signup(payload: CreatorSignupPayload, request: Request):
    db = request.app.state.db
    platform = _public_platform_payload(await _get_platform_settings_doc(db))
    modules = platform.get("modules") or {}
    signup = platform.get("signup") or {}
    if not modules.get("creators_enabled", True) or not signup.get("creator_signup_enabled", True):
        raise HTTPException(status_code=403, detail="Creator signup is currently disabled")

    email = normalize_email(payload.user.email)
    if await db.users.find_one({"email": email}):
        raise HTTPException(status_code=400, detail="Email already registered. Please log in instead.")

    creator_name = (payload.creator_name or "").strip()
    if not creator_name:
        raise HTTPException(status_code=400, detail="Store name is required")

    slug = slugify(payload.slug or creator_name)
    if not slug:
        raise HTTPException(status_code=400, detail="Store URL could not be generated. Please adjust the store name.")
    if await db.creators.find_one({"slug": slug}):
        raise HTTPException(status_code=400, detail="That storefront URL is already taken")

    user = User(email=email, name=payload.user.name, role="creator", status="active")
    user_doc = user.model_dump()
    user_doc["created_at"] = user_doc["created_at"].isoformat()
    user_doc["phone"] = payload.user.phone or ""
    user_doc["password_hash"] = hash_password(payload.user.password)

    creator = Creator(
        name=creator_name,
        slug=slug,
        bio=payload.bio or "",
        logo_url=payload.logo_url or None,
        socials=payload.socials or {},
        user_id=user.id,
        status="pending" if signup.get("require_creator_approval") else "active",
        subscription_status="inactive",
    )
    band_doc = creator.model_dump()
    band_doc["created_at"] = band_doc["created_at"].isoformat()
    band_doc.update({
        "category": payload.category or "",
        "contact_email": payload.contact_email or email,
        "contact_phone": payload.contact_phone or payload.user.phone or "",
    })

    try:
        await db.users.insert_one(user_doc)
        await db.creators.insert_one(band_doc)
        await db.band_members.insert_one(iso_dates(BandUserMembership(band_id=creator.id, user_id=user.id, role="owner", is_primary_owner=True, status="active").model_dump()))
        plan = await _find_signup_plan(db, "creator", payload.plan_id, signup.get("default_creator_plan_id"))
        subscription = await _create_signup_subscription(db, "creator", creator.id, plan, bool(signup.get("require_creator_approval")))
    except Exception as e:
        await db.users.delete_one({"id": user.id})
        await db.creators.delete_one({"id": creator.id})
        await db.band_members.delete_many({"user_id": user.id})
        raise HTTPException(status_code=400, detail=f"User creation failed: {e}")

    checkout_url = None
    billing_error = None
    if plan and float(plan.get("monthly_price") or 0) > 0 and signup.get("allow_paystack_recurring_billing", True):
        try:
            checkout_url = await _signup_paystack_checkout(db, request, subscription, plan, email, payload.callback_url)
        except HTTPException as e:
            billing_error = str(e.detail)
        except Exception as e:
            billing_error = str(e)

        if billing_error:
            failed_access = _subscription_access_from_status("billing_setup_required", "creator")
            await db.account_subscriptions.update_one(
                {"id": subscription.get("id")},
                {"$set": iso_dates({
                    "status": "billing_setup_required",
                    "payment_method": "paystack",
                    "last_payment_status": "billing_setup_failed",
                    "billing_setup_error": billing_error,
                    "updated_at": utcnow(),
                    **failed_access,
                })},
            )
            subscription = await db.account_subscriptions.find_one({"id": subscription.get("id")}, {"_id": 0}) or subscription
            await _sync_owner_subscription_status(db, subscription)

    token = create_token(user.id, user.email, user.role)
    status = "requires_payment" if checkout_url else ("billing_setup_required" if billing_error else ("pending_approval" if creator.status == "pending" else "active"))
    response = {
        "status": status,
        "account_type": "creator",
        "access_token": token,
        "token_type": "bearer",
        "user": clean_user_doc(user_doc),
        "creator": {k: v for k, v in band_doc.items() if k != "_id"},
        "subscription": subscription,
        "checkout_url": checkout_url,
        "authorization_url": checkout_url,
        "redirect_to": checkout_url or "/creator",
    }
    if billing_error:
        response["billing_error"] = billing_error
    return response


