def public_base_url(request: Optional[Request] = None) -> str:
    """Return the public site origin used for customer-facing links."""
    if request is None:
        return (os.environ.get("PUBLIC_APP_URL") or os.environ.get("FRONTEND_URL") or "https://www.fandomforge.co.za").rstrip("/")
    base = str(request.base_url).rstrip("/")
    if base.endswith("/api"):
        base = base[:-4]
    return base


def tracking_url_for_order(request: Optional[Request], order: dict) -> str:
    token = order.get("tracking_token") or ""
    if not token:
        return ""
    return f"{public_base_url(request)}/order-tracking/{token}"


async def ensure_order_tracking_token(db, order: dict) -> dict:
    """Backfill a public tracking token for older orders created before Sprint 8."""
