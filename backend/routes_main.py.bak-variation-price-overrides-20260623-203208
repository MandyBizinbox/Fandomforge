@admin_router.patch("/instance-settings")
async def admin_update_instance_settings(payload: InstanceSettingsUpdate, request: Request, user: User = Depends(get_current_user)):
    _require_manager_permission(user, "manage_platform_branding")
    db = request.app.state.db
    current = await _get_platform_settings_doc(db)
    updates = payload.model_dump(exclude_none=True)
    if not updates:
        raise HTTPException(status_code=400, detail="Nothing to update")
    for key in ["homepage", "signup", "policies"]:
        if key in updates:
            if key == "homepage": updates[key] = _deep_merge((current or {}).get(key) or DEFAULT_HOMEPAGE_SETTINGS, updates[key] or {})
            if key == "signup": updates[key] = _deep_merge((current or {}).get(key) or DEFAULT_SIGNUP_SETTINGS, updates[key] or {})
            if key == "policies": updates[key] = _deep_merge((current or {}).get(key) or DEFAULT_POLICY_SETTINGS, updates[key] or {})
    if "homepage_sections" in updates:
        sections = updates.get("homepage_sections") or []
        if not isinstance(sections, list):
            raise HTTPException(status_code=400, detail="Homepage sections must be a list")
        cleaned_sections = []
        for index, section in enumerate(sections):
            if not isinstance(section, dict):
                continue
            clean = dict(section)
            clean["id"] = clean.get("id") or uid()
            clean["type"] = clean.get("type") or "rich_text"
            clean["enabled"] = bool(clean.get("enabled", True))
            clean["sort_order"] = int(clean.get("sort_order") or ((index + 1) * 10))
            clean["settings"] = clean.get("settings") if isinstance(clean.get("settings"), dict) else {}
            cleaned_sections.append(clean)
        updates["homepage_sections"] = cleaned_sections
    updates["updated_at"] = utcnow()
    await db.settings.update_one({"id": "platform"}, {"$set": iso_dates(updates)}, upsert=True)
    return _public_platform_payload(await _get_platform_settings_doc(db))


