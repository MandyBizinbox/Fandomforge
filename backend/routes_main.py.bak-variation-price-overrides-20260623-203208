def _product_print_option_map(template: dict, global_options: list) -> dict:
    out = {}
    for option in global_options or []:
        if option.get("id"):
            out[str(option.get("id"))] = option
    for option in template.get("print_options") or []:
        if option.get("id"):
            out[str(option.get("id"))] = option
    return out



def _calculate_area_print_cost(slot: dict, area: dict, option: dict) -> dict:
    calculation_type = option.get("calculation_type") or slot.get("calculation_type") or "fixed"

    if calculation_type == "fixed":
        cost = float(option.get("print_cost_max") or slot.get("print_cost_max") or 0)
        return {
            "calculation_type": calculation_type,
            "print_width_mm": float(slot.get("width_mm") or option.get("width_mm") or area.get("width_mm") or 0),
            "print_height_mm": float(slot.get("height_mm") or option.get("height_mm") or area.get("height_mm") or 0),
            "area_cm2": 0,
            "raw_print_cost": round(cost, 2),
            "calculated_print_cost": round(cost, 2),
        }

    placement = slot.get("placement") or {}
    area_width_mm = float(area.get("width_mm") or slot.get("width_mm") or option.get("width_mm") or 0)
    area_height_mm = float(area.get("height_mm") or slot.get("height_mm") or option.get("height_mm") or 0)

    placement_width_pct = float(placement.get("width", placement.get("width_pct", 100)) or 100)
    placement_height_pct = float(placement.get("height", placement.get("height_pct", 100)) or 100)

    print_width_mm = area_width_mm * (placement_width_pct / 100)
    print_height_mm = area_height_mm * (placement_height_pct / 100)
    area_cm2 = (print_width_mm / 10) * (print_height_mm / 10)

    cost_per_cm2 = float(option.get("cost_per_cm2") or slot.get("cost_per_cm2") or 0)

    if calculation_type == "area_from_sheet" and not cost_per_cm2:
        sheet_area_cm2 = (float(option.get("sheet_width_mm") or slot.get("sheet_width_mm") or 0) / 10) * (float(option.get("sheet_height_mm") or slot.get("sheet_height_mm") or 0) / 10)
        sheet_cost = float(option.get("sheet_cost") or slot.get("sheet_cost") or 0)
        cost_per_cm2 = sheet_cost / sheet_area_cm2 if sheet_area_cm2 > 0 else 0

    raw = area_cm2 * cost_per_cm2
    raw *= 1 + (float(option.get("waste_percentage") or slot.get("waste_percentage") or 0) / 100)
    raw *= 1 + (float(option.get("markup_percentage") or slot.get("markup_percentage") or 0) / 100)

    minimum = float(option.get("minimum_print_cost") or slot.get("minimum_print_cost") or 0)
    final = max(raw, minimum)

    return {
        "calculation_type": calculation_type,
        "print_width_mm": round(print_width_mm, 1),
        "print_height_mm": round(print_height_mm, 1),
        "area_cm2": round(area_cm2, 2),
        "raw_print_cost": round(raw, 2),
        "calculated_print_cost": round(final, 2),
    }

def _enrich_and_validate_product_artwork_slots(template: dict, global_print_options: list, groups: list, flat_artworks: list) -> None:
    area_map = _product_template_print_area_map(template)
    option_map = _product_print_option_map(template, global_print_options)

    def enrich(slot: dict) -> None:
        if not slot or not slot.get("print_area_id"):
            return

        area = area_map.get(str(slot.get("print_area_id")))
        if not area:
            raise HTTPException(status_code=400, detail="Artwork slot uses an invalid print area")

        option_id = slot.get("print_option_id")
        if not option_id:
            return

        option = option_map.get(str(option_id))
        if not option:
            raise HTTPException(status_code=400, detail="Artwork slot uses an invalid print option")

        allowed = area.get("allowed_print_option_ids") or template.get("print_option_ids") or []
        if allowed and option.get("id") not in allowed:
            raise HTTPException(status_code=400, detail="Artwork slot print option is not allowed for its print area")

        slot["area_key"] = slot.get("area_key") or area.get("area_key") or area.get("view_key") or area.get("screen_view") or ""
        slot["screen_id"] = slot.get("screen_id") or area.get("screen_id") or ""
        slot["screen_view"] = slot.get("screen_view") or area.get("screen_view") or area.get("view_key") or ""
        slot["print_method"] = option.get("print_method") or slot.get("print_method") or ""
        slot["method_key"] = option.get("method_key") or slot.get("method_key") or ""
        slot["print_size"] = option.get("print_size") or slot.get("print_size") or area.get("print_size") or ""
        slot["print_cost_max"] = float(option.get("print_cost_max") or slot.get("print_cost_max") or 0)
        slot["standard_print_size_key"] = (
            slot.get("standard_print_size_key")
            or area.get("standard_print_size_key")
            or option.get("standard_print_size_key")
            or ""
        )

        # For dynamic print options, option width/height is often 0.
        # Treat 0/None as missing and use the selected print area's real dimensions.
        slot["width_mm"] = (
            slot.get("width_mm")
            or area.get("width_mm")
            or option.get("width_mm")
            or 0
        )
        slot["height_mm"] = (
            slot.get("height_mm")
            or area.get("height_mm")
            or option.get("height_mm")
            or 0
        )

        slot["dpi"] = int(option.get("dpi") or slot.get("dpi") or area.get("dpi") or 300)
        slot["fit_mode"] = option.get("fit_mode") or slot.get("fit_mode") or area.get("fit_mode") or "contain"
        slot["production_notes"] = option.get("production_notes") or slot.get("production_notes") or ""

        costing = _calculate_area_print_cost(slot, area, option)
        slot["calculation_type"] = costing["calculation_type"]
        slot["placement_box_width_mm"] = costing.get("placement_box_width_mm", costing.get("print_width_mm", 0))
        slot["placement_box_height_mm"] = costing.get("placement_box_height_mm", costing.get("print_height_mm", 0))
        slot["artwork_aspect_ratio"] = costing.get("artwork_aspect_ratio", 0)
        slot["print_width_mm"] = costing["print_width_mm"]
        slot["print_height_mm"] = costing["print_height_mm"]
        slot["area_cm2"] = costing["area_cm2"]
        slot["raw_print_cost"] = costing["raw_print_cost"]
        slot["calculated_print_cost"] = costing["calculated_print_cost"]
        slot["print_cost_max"] = costing["calculated_print_cost"]
        slot["cost_per_cm2"] = float(option.get("cost_per_cm2") or slot.get("cost_per_cm2") or 0)
        slot["minimum_print_cost"] = float(option.get("minimum_print_cost") or slot.get("minimum_print_cost") or 0)
        slot["waste_percentage"] = float(option.get("waste_percentage") or slot.get("waste_percentage") or 0)
        slot["markup_percentage"] = float(option.get("markup_percentage") or slot.get("markup_percentage") or 0)

        resolved_print_costing = _resolve_print_costing(option, slot, slot.get("calculated_print_cost") or 0)
        slot["platform_print_cost"] = resolved_print_costing["platform_print_cost"]
        slot["creator_print_price"] = resolved_print_costing["creator_print_price"]
        slot["platform_print_profit"] = resolved_print_costing["platform_print_profit"]
        slot["platform_print_margin_percent"] = resolved_print_costing["platform_print_margin_percent"]

    for group in groups or []:
        for slot in group.get("artworks") or []:
            enrich(slot)

    by_id = {slot.get("id"): slot for group in groups or [] for slot in group.get("artworks") or [] if slot.get("id")}

    for slot in flat_artworks or []:
        if slot.get("id") in by_id:
            slot.update(by_id[slot.get("id")])
        else:
            enrich(slot)


def _normalize_product_artwork_slot(row: dict, index: int = 0) -> dict:
    row = dict(row or {})
    if not row.get("id"):
        row["id"] = uid()
    row["sort_order"] = int(row.get("sort_order") or index)
    placement = row.get("placement") or {}
    if placement and not isinstance(placement, dict):
        placement = placement.model_dump()
    row["placement"] = placement or {
        "screen_id": row.get("screen_id") or "",
        "print_area_id": row.get("print_area_id") or "",
        "x": 0,
        "y": 0,
        "width": 100,
        "height": 100,
        "rotation": 0,
        "scale": 1,
    }
    if not row["placement"].get("print_area_id"):
        row["placement"]["print_area_id"] = row.get("print_area_id") or ""
    if not row["placement"].get("screen_id"):
        row["placement"]["screen_id"] = row.get("screen_id") or ""
    return row


def _normalize_product_artwork_groups(groups: list, fallback_artworks: list, is_admin: bool = False) -> tuple[list, list]:
    """Normalise grouped artwork and return (groups, flattened_artworks)."""
    normalised_groups = []
    flattened = []

    for group_index, group in enumerate(groups or []):
        row = group if isinstance(group, dict) else group.model_dump()
        row = dict(row or {})
        if not row.get("id"):
            row["id"] = uid()
        row["label"] = row.get("label") or "Artwork group"
        row["scope_type"] = row.get("scope_type") or "custom"
        row["variation_ids"] = [str(v) for v in row.get("variation_ids") or [] if str(v).strip()]
        row["sort_order"] = int(row.get("sort_order") or group_index)
        row["artworks"] = [
            _normalize_product_artwork_slot(item if isinstance(item, dict) else item.model_dump(), item_index)
            for item_index, item in enumerate(row.get("artworks") or [])
            if (item if isinstance(item, dict) else item.model_dump()).get("print_area_id")
        ]
        primary_mockup = row.get("primary_mockup_image_url") or next((a.get("mockup_image_url") for a in row["artworks"] if a.get("mockup_image_url")), None)
        row["primary_mockup_image_url"] = primary_mockup
        normalised_groups.append(row)
        flattened.extend(row["artworks"])

    if not normalised_groups and fallback_artworks:
        fallback = [
            _normalize_product_artwork_slot(item if isinstance(item, dict) else item.model_dump(), item_index)
            for item_index, item in enumerate(fallback_artworks or [])
            if (item if isinstance(item, dict) else item.model_dump()).get("print_area_id")
        ]
        if fallback:
            normalised_groups.append({
                "id": "default-all",
                "label": "Default artwork",
                "scope_type": "all",
                "attribute_key": None,
                "attribute_value": None,
                "variation_ids": [],
                "inherits_from": None,
                "artworks": fallback,
                "primary_mockup_image_url": next((a.get("mockup_image_url") for a in fallback if a.get("mockup_image_url")), None),
                "sort_order": 0,
            })
            flattened.extend(fallback)

    return normalised_groups, flattened


def _resolve_artwork_group_for_variation(product: dict, variation_id: str, variation_attrs: dict) -> dict:
    groups = product.get("artwork_groups") or []
    if not groups:
        return {}

    # 1. exact variation/custom match
    for group in groups:
        if group.get("scope_type") in ("variation", "custom") and variation_id in (group.get("variation_ids") or []):
            return group

    # 2. attribute-level match, e.g. Colour = Red
    for group in groups:
        key = group.get("attribute_key")
        value = group.get("attribute_value")
        if group.get("scope_type") == "attribute" and key and value and str(variation_attrs.get(key, "")).lower() == str(value).lower():
            return group

    # 3. group with all scope
    for group in groups:
        if group.get("scope_type") == "all":
            return group

    return groups[0]


ARTWORK_REVIEW_STATUSES = {"pending_review", "approved", "rejected"}

def _artwork_slot_has_file(slot: dict) -> bool:
    return bool((slot or {}).get("original_url"))

def _product_artwork_slots(product_or_data: dict) -> list:
    """Return all uploaded artwork slots from grouped and flat product data."""
    seen = set()
    out = []
    for group in (product_or_data or {}).get("artwork_groups") or []:
        for slot in group.get("artworks") or []:
            if not _artwork_slot_has_file(slot):
                continue
            key = slot.get("id") or f"{group.get('id')}:{slot.get('print_area_id')}:{slot.get('original_url')}"
            if key in seen:
                continue
            seen.add(key)
            out.append(slot)
    for slot in (product_or_data or {}).get("artworks") or []:
        if not _artwork_slot_has_file(slot):
            continue
        key = slot.get("id") or f"flat:{slot.get('print_area_id')}:{slot.get('original_url')}"
        if key in seen:
            continue
        seen.add(key)
        out.append(slot)
    return out

def _derive_artwork_review_status(product_or_data: dict) -> str:
    slots = _product_artwork_slots(product_or_data)
    if not slots:
        return "not_required"
    statuses = [(slot.get("status") or "pending_review") for slot in slots]
    if any(status == "rejected" for status in statuses):
        return "rejected"
    if any(status != "approved" for status in statuses):
        return "pending_review"
    return "approved"

def _ensure_artwork_review_defaults(groups: list, flat_artworks: list, is_admin: bool = False) -> None:
    """Mutates artwork status defaults in grouped and flat artwork slots."""
    by_id = {}
    for group in groups or []:
        for slot in group.get("artworks") or []:
            if not _artwork_slot_has_file(slot):
                continue
            if not slot.get("status") or (is_admin and slot.get("status") == "pending_review"):
                slot["status"] = "approved" if is_admin else "pending_review"
            if slot.get("id"):
                by_id[slot["id"]] = slot
    for slot in flat_artworks or []:
        if not _artwork_slot_has_file(slot):
            continue
        if slot.get("id") in by_id:
            slot.update(by_id[slot["id"]])
        elif not slot.get("status") or (is_admin and slot.get("status") == "pending_review"):
            slot["status"] = "approved" if is_admin else "pending_review"

def _artwork_review_counts(product_or_data: dict) -> dict:
    slots = _product_artwork_slots(product_or_data)
    return {
        "total": len(slots),
        "pending_review": sum(1 for slot in slots if (slot.get("status") or "pending_review") == "pending_review"),
        "approved": sum(1 for slot in slots if slot.get("status") == "approved"),
        "rejected": sum(1 for slot in slots if slot.get("status") == "rejected"),
    }


async def normalize_template_product_payload(db, data: dict, creator: dict, user: User, allow_admin_publish: bool = False) -> dict:
    """
    Normalizes sellable creator/admin products created from admin product templates.
    Keeps old product fields populated so Shop/ProductCard/Cart continue to work.
    """
    data = dict(data)
    template_id = data.get("template_id")

    if not template_id:
        if "variations" in data:
            data["variations"] = [v if isinstance(v, dict) else v.model_dump() for v in data.get("variations") or []]
        return data

    template = await db.product_templates.find_one({"id": template_id}, {"_id": 0})
    if not template:
        raise HTTPException(status_code=400, detail="Product template not found")

    if template.get("status") == "archived":
        raise HTTPException(status_code=400, detail="Archived templates cannot be used")

    selected_variation_ids = [str(v) for v in data.get("selected_template_variation_ids") or [] if str(v).strip()]
    template_variations = template.get("variations") or []

    if not selected_variation_ids and template_variations:
        selected_variation_ids = [v.get("id") for v in template_variations if v.get("status", "active") == "active"]

    selected_variations = [v for v in template_variations if v.get("id") in selected_variation_ids]
    if template_variations and not selected_variations:
        raise HTTPException(status_code=400, detail="Select at least one valid template variation")

    print_area_id = data.get("selected_print_area_id")
    print_area = None
    if print_area_id:
        print_area = next((a for a in template.get("print_areas") or [] if a.get("id") == print_area_id), None)
        if not print_area:
            raise HTTPException(status_code=400, detail="Selected print area is not valid for this template")

    global_print_options = await db.print_options.find({}, {"_id": 0}).to_list(500)
    print_option = _find_print_option_from_template_or_global(template, data.get("selected_print_option_id"), global_print_options)

    if data.get("selected_print_option_id") and not print_option:
        raise HTTPException(status_code=400, detail="Selected print option is not valid")

    if print_area and print_option:
        allowed = print_area.get("allowed_print_option_ids") or template.get("print_option_ids") or []
        if allowed and print_option.get("id") not in allowed:
            raise HTTPException(status_code=400, detail="Selected print method is not allowed for this print area")

    blank_costings = [_resolve_blank_costing(variation, template) for variation in selected_variations]
    if blank_costings:
        selected_blank_costing = max(blank_costings, key=lambda row: row["creator_blank_price"])
    else:
        selected_blank_costing = _resolve_blank_costing({}, template)

    blank_cost = selected_blank_costing["platform_blank_cost"]
    creator_blank_price = selected_blank_costing["creator_blank_price"]
    # Artwork can now exist in groups, with different print options per group/area.
    artwork_groups_input = data.get("artwork_groups") or []
    is_admin_user = user.role in ("super_admin", "admin")
    artwork_groups, grouped_flat_artworks = _normalize_product_artwork_groups(artwork_groups_input, data.get("artworks") or [], is_admin_user)
    _enrich_and_validate_product_artwork_slots(template, global_print_options, artwork_groups, grouped_flat_artworks)
    _ensure_artwork_review_defaults(artwork_groups, grouped_flat_artworks, is_admin=is_admin_user)

    calculated_slot_costings = [
        _resolve_print_costing(None, row, row.get("calculated_print_cost") or row.get("print_cost_max") or 0)
        for row in grouped_flat_artworks
        if row.get("print_option_id") and row.get("original_url")
    ]

    if calculated_slot_costings:
        platform_print_cost = round(sum(row["platform_print_cost"] for row in calculated_slot_costings), 2)
        creator_print_price = round(sum(row["creator_print_price"] for row in calculated_slot_costings), 2)
    else:
        fallback_print = float((print_option or {}).get("print_cost_max") or data.get("print_cost") or 0)
        print_costing = _resolve_print_costing(print_option, None, fallback_print)
        platform_print_cost = print_costing["platform_print_cost"]
        creator_print_price = print_costing["creator_print_price"]

    print_cost = creator_print_price

    retail = float(data.get("selling_price") or 0)
    commission_rate = float(data.get("commission_rate") or creator.get("commission_rate") or 0.15)
    costing = _platform_costing_breakdown(
        blank_cost,
        platform_print_cost,
        commission_rate,
        retail,
        quantity=1,
        creator_blank_price=creator_blank_price,
        creator_print_price=creator_print_price,
    )
    commission = costing["commission_unit"]
    production_cost = costing["production_unit_cost"]
    creator_profit = costing["creator_profit_unit"]

    normalized_artworks = grouped_flat_artworks

    mockup = (
        data.get("primary_mockup_image_url")
        or data.get("mockup_image_url")
        or next((row.get("mockup_image_url") for row in normalized_artworks if row.get("mockup_image_url")), None)
        or _template_image_for_area(template, print_area)
    )
    mockups = data.get("mockup_images") or []
    for artwork_row in normalized_artworks:
        image = artwork_row.get("mockup_image_url")
        if image and image not in mockups:
            mockups.append(image)
    if mockup and mockup not in mockups:
        mockups = [mockup, *mockups]

    data["artwork_review_status"] = _derive_artwork_review_status({**data, "artwork_groups": artwork_groups, "artworks": normalized_artworks})

    data.update({
        "category": data.get("category") or template.get("category") or "",
        "attribute_ids": data.get("attribute_ids") or template.get("attribute_ids") or [],
        "selected_template_variation_ids": selected_variation_ids,
        "variations": [_template_variation_to_product_variation(v) for v in selected_variations] or data.get("variations") or [],
        "print_cost": print_cost,
        "mockup_image_url": mockup,
        "primary_mockup_image_url": mockup,
        "mockup_images": mockups,
        "artworks": normalized_artworks,
        "artwork_groups": artwork_groups,
        "estimated_blank_cost": costing["blank_payout_unit"],
        "estimated_print_cost": costing["print_payout_unit"],
        "estimated_total_cost": costing["production_unit_cost"],

        "platform_blank_cost": costing["platform_blank_cost"],
        "creator_blank_price": costing["creator_blank_price"],
        "platform_print_cost": costing["platform_print_cost"],
        "creator_print_price": costing["creator_print_price"],
        "creator_product_cost": costing["creator_product_cost"],
        "customer_selling_price": retail,
        "platform_blank_profit": costing["platform_blank_profit"],
        "platform_print_profit": costing["platform_print_profit"],
        "estimated_platform_profit": costing["estimated_platform_profit"],

        "commission_rate": commission_rate,
        "estimated_commission": commission,
        "estimated_creator_profit": creator_profit,
        "costing_breakdown": {
            "blank_supplier_cost": costing["blank_supplier_cost"],
            "platform_blank_cost": costing["platform_blank_cost"],
            "creator_blank_price": costing["creator_blank_price"],
            "platform_print_cost": costing["platform_print_cost"],
            "creator_print_price": costing["creator_print_price"],
            "platform_blank_profit": costing["platform_blank_profit"],
            "platform_print_profit": costing["platform_print_profit"],
            "estimated_platform_profit": costing["estimated_platform_profit"],
            "blank_markup_rate": 0.10,
            "print_markup_rate": 0.10,
            "blank_payout_unit": costing["blank_payout_unit"],
            "print_payout_unit": costing["print_payout_unit"],
            "production_unit_cost": costing["production_unit_cost"],
            "minimum_selling_price": costing["minimum_selling_price"],
        },
        "artwork_review_status": data.get("artwork_review_status") or "not_required",
    })

    if data.get("published") and not allow_admin_publish:
        review_status = data.get("artwork_review_status") or _derive_artwork_review_status(data)
        if review_status == "not_required":
            raise HTTPException(status_code=400, detail="Artwork is required before publishing")
        if review_status != "approved":
            raise HTTPException(status_code=400, detail="Artwork must be approved before publishing")
        if creator_profit < 0:
            raise HTTPException(status_code=400, detail="Selling price is below the minimum profitable price")

    artwork = data.get("artwork") or {}

    if "placement" in data and data["placement"] and not isinstance(data["placement"], dict):
        data["placement"] = data["placement"].model_dump()

    if "artwork" in data and data["artwork"] and not isinstance(data["artwork"], dict):
        data["artwork"] = data["artwork"].model_dump()

    if "artworks" in data:
        data["artworks"] = [row if isinstance(row, dict) else row.model_dump() for row in data.get("artworks") or []]

    if "artwork_groups" in data:
        data["artwork_groups"] = [row if isinstance(row, dict) else row.model_dump() for row in data.get("artwork_groups") or []]

    # Keep legacy single-artwork fields populated from the first artwork slot for older screens/order logic.
    if data.get("artworks") and not (data.get("artwork") or {}).get("original_url"):
        first_artwork = next((row for row in data["artworks"] if row.get("original_url")), data["artworks"][0])
        data["artwork"] = {
            "original_url": first_artwork.get("original_url"),
            "file_name": first_artwork.get("file_name"),
            "mime_type": first_artwork.get("mime_type"),
            "status": first_artwork.get("status"),
            "notes": first_artwork.get("notes"),
        }
        data["placement"] = first_artwork.get("placement") or data.get("placement") or {}
        data["selected_print_area_id"] = data.get("selected_print_area_id") or first_artwork.get("print_area_id")
        data["selected_print_option_id"] = data.get("selected_print_option_id") or first_artwork.get("print_option_id")

    return data


