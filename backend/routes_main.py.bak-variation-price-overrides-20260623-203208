    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_subscriptions")
    db = request.app.state.db
    owner_type = _normalise_subscription_owner_type(payload.owner_type)
    owner = await _get_subscription_owner(db, owner_type, payload.owner_id)
    if not owner:
        raise HTTPException(status_code=404, detail="Subscription owner not found")
    if owner_type == "creator":
        await _require_module(db, "creator_subscriptions_enabled", "Creator subscriptions")
    if owner_type == "printer":
        await _require_module(db, "printer_subscriptions_enabled", "Printer subscriptions")

    data = payload.model_dump()
    data["owner_type"] = owner_type
    plan = None
    if data.get("plan_id"):
