async def _find_signup_plan(db, audience: str, plan_id: Optional[str], fallback_plan_id: Optional[str] = None) -> Optional[dict]:
    query_audience = {"$in": [audience, "both"]}
    if plan_id:
        plan = await db.subscription_plans.find_one({"id": plan_id, "status": "active", "audience": query_audience}, {"_id": 0})
        if not plan:
            raise HTTPException(status_code=400, detail="Selected subscription plan is not available")
        return plan
    if fallback_plan_id:
        plan = await db.subscription_plans.find_one({"id": fallback_plan_id, "status": "active", "audience": query_audience}, {"_id": 0})
        if plan:
            return plan
    return await db.subscription_plans.find_one({"status": "active", "audience": query_audience}, {"_id": 0}, sort=[("sort_order", 1), ("monthly_price", 1)])


async def _create_signup_subscription(db, owner_type: str, owner_id: str, plan: Optional[dict], require_approval: bool) -> dict:
    status = "manual" if require_approval else "active"
    payment_method = "manual"
    monthly_fee = 0
    billing_cycle = "monthly"
    trial_ends_at = None
    next_billing_date = None
    access = _subscription_access_from_status(status, owner_type)

    if plan:
        monthly_fee = float(plan.get("monthly_price") or 0)
        billing_cycle = plan.get("billing_cycle") or "monthly"
        if int(plan.get("trial_days") or 0) > 0:
            status = "trial"
            trial_ends_at = utcnow() + timedelta(days=int(plan.get("trial_days") or 0))
            next_billing_date = trial_ends_at
        elif monthly_fee <= 0 and not require_approval:
            status = "free"
            payment_method = "free"
        elif require_approval:
            status = "manual"
        else:
            status = "active"
        access = {
            "can_publish_products": bool(plan.get("allow_product_publishing", True)),
            "can_receive_jobs": bool(plan.get("allow_job_assignment", True)),
            "storefront_visible": bool(plan.get("storefront_visible", True)),
            "checkout_enabled": bool(plan.get("checkout_enabled", True)),
        }
    sub = AccountSubscription(
        owner_type=owner_type,
        owner_id=owner_id,
        plan_id=plan.get("id") if plan else None,
        status=status,
        payment_method=payment_method,
        monthly_fee=monthly_fee,
        billing_cycle=billing_cycle,
        trial_ends_at=trial_ends_at,
        next_billing_date=next_billing_date,
        max_products=(plan.get("limits") or {}).get("max_products") if plan else None,
        max_jobs_per_month=(plan.get("limits") or {}).get("max_jobs_per_month") if plan else None,
        **access,
    )
    await db.account_subscriptions.insert_one(iso_dates(sub.model_dump()))
    return sub.model_dump()


async def _signup_paystack_checkout(db, request: Request, subscription: dict, plan: dict, email: str, callback_url: Optional[str] = None) -> Optional[str]:
    if not plan or float(plan.get("monthly_price") or 0) <= 0:
        return None
    billing = await _get_subscription_billing_settings(db, masked=False)
    if not billing.get("enabled"):
        return None
    plan = await _ensure_subscription_plan_synced_with_paystack(db, plan)
    reference = f"SUB-{new_reference()}"
    amount = _paystack_amount(subscription.get("monthly_fee") or plan.get("monthly_price") or 0)
    init_payload = {
        "email": email,
        "amount": amount,
        "currency": billing.get("currency") or "ZAR",
        "reference": reference,
        "plan": plan.get("paystack_plan_code"),
        "channels": ["card"],
        "callback_url": callback_url or _paystack_subscription_callback_url(request, subscription.get("id")),
        "metadata": {"kind": "subscription", "subscription_id": subscription.get("id"), "owner_type": subscription.get("owner_type"), "owner_id": subscription.get("owner_id"), "plan_id": plan.get("id")},
    }
    res = await _paystack_subscription_request(db, "POST", "/transaction/initialize", init_payload)
    authorization_url = (res.get("data") or {}).get("authorization_url")
    if not authorization_url:
        raise HTTPException(status_code=400, detail="Paystack did not return a checkout URL")
    payment = Payment(subscription_id=subscription.get("id"), amount=float(amount) / 100, provider="paystack", provider_reference=reference, status="requires_action", kind="subscription")
    await db.payments.insert_one(iso_dates(payment.model_dump()))
    await db.account_subscriptions.update_one(
        {"id": subscription.get("id")},
        {
            "$set": iso_dates({
                "payment_method": "paystack",
                "last_payment_status": "pending_authorization",
                "paystack_plan_code": plan.get("paystack_plan_code"),
                "paystack_plan_name": plan.get("name"),
                "paystack_checkout_url": authorization_url,
                "paystack_reference": reference,
                "paystack_synced_at": utcnow(),
                "updated_at": utcnow(),
            })
        },
    )
    return authorization_url


