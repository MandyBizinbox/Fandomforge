async def notification_query_for_user(db, user: User) -> Dict:
    if user.role in ("admin", "super_admin"):
        return {"recipient_user_id": user.id}
    return {"recipient_user_id": user.id}


async def list_notifications_for_user(db, user: User, unread: bool = False, limit: int = 100) -> dict:
    q = await notification_query_for_user(db, user)
    if unread:
        q["read"] = False
    notifications = await db.notifications.find(q, {"_id": 0}).sort("created_at", -1).to_list(min(max(limit, 1), 300))
    unread_count = await db.notifications.count_documents({"recipient_user_id": user.id, "read": False})
    return {"items": [Notification(**row) for row in notifications], "unread_count": unread_count}


async def mark_notification_for_user(db, user: User, notification_id: str, read: bool = True) -> Notification:
    existing = await db.notifications.find_one({"id": notification_id, "recipient_user_id": user.id}, {"_id": 0})
    if not existing:
        raise HTTPException(status_code=404, detail="Notification not found")
    updates = {"read": read, "read_at": utcnow().isoformat() if read else None}
    await db.notifications.update_one({"id": notification_id, "recipient_user_id": user.id}, {"$set": updates})
    doc = await db.notifications.find_one({"id": notification_id, "recipient_user_id": user.id}, {"_id": 0})
    return Notification(**doc)


async def mark_all_notifications_for_user(db, user: User) -> dict:
    now = utcnow().isoformat()
    result = await db.notifications.update_many(
        {"recipient_user_id": user.id, "read": False},
        {"$set": {"read": True, "read_at": now}},
    )
    return {"updated": result.modified_count}


