        current["enabled"] = bool(payload.enabled)
    if payload.display_name is not None:
        current["display_name"] = payload.display_name.strip() or current.get("display_name") or gateway_key
    if payload.description is not None:
        current["description"] = payload.description
    if payload.mode is not None:
        current["mode"] = payload.mode
    if payload.sort_order is not None:
        current["sort_order"] = int(payload.sort_order)
    if payload.public_config is not None:
        current["public_config"] = {**(current.get("public_config") or {}), **payload.public_config}
    if payload.settings is not None:
        settings = dict(current.get("settings") or {})
        for key, value in payload.settings.items():
            if key in SECRET_SETTING_KEYS and str(value).strip() in ["********", "••••••••", ""]:
                continue
            settings[key] = value
        for key in payload.clear_secret_fields or []:
            if key in settings:
                settings[key] = ""
        current["settings"] = settings

    try:
        adapter = get_payment_gateway_adapter(gateway_key)
        adapter.validate_config(current)
    except KeyError:
        pass
    except PaymentGatewayError as exc:
        raise HTTPException(status_code=400, detail=str(exc))

