    order: Optional[dict] = None,
    order_id: Optional[str] = None,
    order_item: Optional[dict] = None,
    actor: Optional[User] = None,
    kind: str = "system",
    title: str,
    message: str = "",
    audience: Optional[List[str]] = None,
    metadata: Optional[dict] = None,
):
