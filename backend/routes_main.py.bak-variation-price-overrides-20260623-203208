def _quick_product_slugify(value: str) -> str:
    import re
    value = str(value or "").strip().lower()
    value = re.sub(r"[^a-z0-9]+", "-", value)
    value = re.sub(r"-+", "-", value).strip("-")
    return value or f"product-{uid()[:8]}"


def _quick_product_sizes(value: str) -> List[str]:
    rows = [row.strip() for row in str(value or "").split(",") if row.strip()]
    return rows or ["One Size"]


async def _quick_product_unique_slug(db, base_slug: str) -> str:
    slug = base_slug
    counter = 2
    while await db.products.find_one({"slug": slug}, {"_id": 1}):
        slug = f"{base_slug}-{counter}"
        counter += 1
    return slug


