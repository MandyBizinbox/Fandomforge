SUBSCRIPTION_ACTIVE_STATUSES = {"trial", "active", "free", "manual"}
SUBSCRIPTION_RESTRICTED_STATUSES = {"past_due", "suspended", "cancelled"}


def _clean_subscription_features(value: Any) -> List[str]:
    if isinstance(value, list):
        return [str(v).strip() for v in value if str(v).strip()]
    if isinstance(value, str):
        return [v.strip() for v in value.split("\n") if v.strip()]
    return []


def _subscription_access_from_status(status: str, owner_type: str = "creator") -> Dict[str, bool]:
    if status in {"billing_setup_required", "requires_payment"}:
        return {
            "can_publish_products": False,
            "can_receive_jobs": False if owner_type == "printer" else True,
            "storefront_visible": False if owner_type in {"creator", "creator"} else True,
            "checkout_enabled": False,
        }
    if status in {"suspended", "cancelled"}:
        return {
            "can_publish_products": False,
            "can_receive_jobs": False,
            "storefront_visible": False if owner_type in {"creator", "creator"} else True,
            "checkout_enabled": False if owner_type in {"creator", "creator"} else True,
        }
    if status == "past_due":
        return {
            "can_publish_products": False,
            "can_receive_jobs": True,
            "storefront_visible": True,
            "checkout_enabled": False if owner_type in {"creator", "creator"} else True,
        }
    return {
        "can_publish_products": True,
        "can_receive_jobs": True,
        "storefront_visible": True,
        "checkout_enabled": True,
    }


def _apply_plan_defaults_to_subscription(payload: Dict[str, Any], plan: Optional[dict]) -> Dict[str, Any]:
    if not plan:
        return payload
    merged = dict(payload)
    merged.setdefault("monthly_fee", float(plan.get("monthly_price") or 0))
    merged.setdefault("billing_cycle", plan.get("billing_cycle") or "monthly")
    limits = plan.get("limits") or {}
    if merged.get("owner_type") in {"creator", "creator"}:
        if merged.get("max_products") is None and limits.get("max_products") not in [None, ""]:
            try:
                merged["max_products"] = int(limits.get("max_products"))
            except (TypeError, ValueError):
                pass
    if merged.get("owner_type") == "printer":
        if merged.get("max_jobs_per_month") is None and limits.get("max_jobs_per_month") not in [None, ""]:
            try:
                merged["max_jobs_per_month"] = int(limits.get("max_jobs_per_month"))
            except (TypeError, ValueError):
                pass
    for key in ["allow_product_publishing", "allow_job_assignment", "storefront_visible", "checkout_enabled"]:
        if key in plan:
            if key == "allow_product_publishing":
                merged.setdefault("can_publish_products", bool(plan.get(key)))
            elif key == "allow_job_assignment":
                merged.setdefault("can_receive_jobs", bool(plan.get(key)))
            else:
                merged.setdefault(key, bool(plan.get(key)))
    return merged


async def _get_subscription_owner(db, owner_type: str, owner_id: str) -> Optional[dict]:
