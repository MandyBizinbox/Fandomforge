@orders_router.patch("/{order_id}/status", response_model=Order)
async def update_order_status(
    order_id: str,
    payload: OrderStatusUpdate,
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db

    order = await db.orders.find_one({"id": order_id}, {"_id": 0})
    if not order:
        raise HTTPException(status_code=404, detail="Not found")

    updates = {"updated_at": datetime.now(timezone.utc).isoformat()}

    if payload.status:
        if user.role not in ("super_admin", "printer"):
            raise HTTPException(status_code=403, detail="Insufficient permission")
        updates["status"] = payload.status

    if payload.item_id and (payload.item_production_status or payload.tracking_number or payload.courier_name or payload.tracking_url or payload.waybill_number):
        items = order["items"]

        for i, item in enumerate(items):
            if item["id"] == payload.item_id:
                if user.role == "printer":
                    pr = await db.printers.find_one({"user_id": user.id}, {"_id": 0})
                    if not pr or pr["id"] != item.get("printer_id"):
                        raise HTTPException(status_code=403, detail="Not assigned")

                if payload.item_production_status:
                    items[i]["production_status"] = payload.item_production_status

                if payload.tracking_number:
                    items[i]["tracking_number"] = payload.tracking_number
                    if not payload.tracking_url:
                        generated_url = _tracking_url_from_template(order.get("shipping_tracking_url_template"), payload.tracking_number)
                        if generated_url:
                            items[i]["tracking_url"] = generated_url
                if payload.courier_name:
                    items[i]["courier_name"] = payload.courier_name
                if payload.tracking_url:
                    items[i]["tracking_url"] = payload.tracking_url
                if payload.waybill_number:
                    items[i]["waybill_number"] = payload.waybill_number
                if payload.item_production_status == "shipped" and not items[i].get("dispatched_at"):
                    items[i]["dispatched_at"] = datetime.now(timezone.utc).isoformat()

                break

        updates["items"] = items

    if payload.tracking_number or payload.courier_name or payload.tracking_url or payload.waybill_number:
        if payload.tracking_number:
            updates["tracking_number"] = payload.tracking_number
            if not payload.tracking_url:
                generated_url = _tracking_url_from_template(order.get("shipping_tracking_url_template"), payload.tracking_number)
                if generated_url:
                    updates["tracking_url"] = generated_url
        if payload.courier_name:
            updates["courier_name"] = payload.courier_name
        if payload.tracking_url:
            updates["tracking_url"] = payload.tracking_url
        if payload.waybill_number:
            updates["waybill_number"] = payload.waybill_number
        if payload.status == "shipped":
            updates["shipped_at"] = datetime.now(timezone.utc).isoformat()

    await db.orders.update_one({"id": order_id}, {"$set": updates})
    doc = await db.orders.find_one({"id": order_id}, {"_id": 0})

    if payload.status:
        await add_order_event(
            db,
            order=doc,
            actor=user,
            kind="order_status_changed",
            title="Order status updated",
            message=f"Order status changed to {payload.status.replace('_', ' ')}.",
            audience=["admin", "creator", "printer", "all"],
            metadata={"status": payload.status},
        )

    if payload.item_id and (payload.item_production_status or payload.tracking_number or payload.courier_name or payload.tracking_url or payload.waybill_number):
        changed_item = next((item for item in doc.get("items", []) if item.get("id") == payload.item_id), None)
        if changed_item:
            if payload.item_production_status:
                await add_order_event(
                    db,
                    order=doc,
                    order_item=changed_item,
                    actor=user,
                    kind="production_status_changed",
                    title="Production status updated",
                    message=f"{changed_item.get('product_title', 'Item')} moved to {payload.item_production_status.replace('_', ' ')}.",
                    audience=["admin", "creator", "printer", "all"],
                    metadata={"production_status": payload.item_production_status},
                )
            if payload.tracking_number:
                await add_order_event(
                    db,
                    order=doc,
                    order_item=changed_item,
                    actor=user,
                    kind="tracking_updated",
                    title="Tracking updated",
                    message=f"Tracking number added: {payload.tracking_number}",
                    audience=["admin", "creator", "printer", "all"],
                    metadata={
                        "tracking_number": payload.tracking_number,
                        "courier_name": payload.courier_name,
                        "tracking_url": payload.tracking_url or doc.get("tracking_url"),
                        "waybill_number": payload.waybill_number,
                    },
                )

    doc = await ensure_order_tracking_token(db, doc)
    customer_link = tracking_url_for_order(request, doc)

    if payload.status:
        await queue_customer_order_email(
            db,
            order=doc,
            subject=f"Order {doc.get('order_number')} update",
            body=f"Your order {doc.get('order_number')} status is now: {customer_order_status_label(payload.status)}. Track it here: {customer_link}",
        )

    if payload.tracking_number:
        await queue_customer_order_email(
            db,
            order=doc,
            subject=f"Tracking added for order {doc.get('order_number')}",
            body=f"Tracking number {payload.tracking_number} has been added to your order {doc.get('order_number')}. Track it here: {customer_link}",
        )

    return Order(**doc)


