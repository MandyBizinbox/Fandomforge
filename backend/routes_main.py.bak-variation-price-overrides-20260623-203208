def _template_lookup_maps(template: Optional[dict]) -> tuple[dict, dict, dict]:
    template = template or {}
    areas = {str(area.get("id")): area for area in template.get("print_areas") or [] if area.get("id")}
    screens = {str(screen.get("id")): screen for screen in template.get("mockup_screens") or [] if screen.get("id")}
    template_options = {str(option.get("id")): option for option in template.get("print_options") or [] if option.get("id")}
    return areas, screens, template_options


def _format_print_option_label(option: Optional[dict]) -> str:
    if not option:
        return "Unassigned"
    method = option.get("print_method") or option.get("method") or "Print"
    size = option.get("print_size") or ""
    cost = option.get("print_cost_max")
    label = f"{method} {size}".strip()
    if cost not in (None, ""):
        label = f"{label} · max R {float(cost):.2f}"
    return label


async def _build_artwork_review_rows(db, status: Optional[str] = None, product_id: Optional[str] = None) -> list:
    product_query: Dict[str, Any] = {}
    if product_id:
        product_query["id"] = product_id

    products = await db.products.find(product_query, {"_id": 0}).sort("updated_at", -1).to_list(1000)
    band_ids = list({p.get("band_id") for p in products if p.get("band_id")})
    template_ids = list({p.get("template_id") for p in products if p.get("template_id")})

    creators = await db.creators.find({"id": {"$in": band_ids}}, {"_id": 0}).to_list(1000) if band_ids else []
    templates = await db.product_templates.find({"id": {"$in": template_ids}}, {"_id": 0}).to_list(1000) if template_ids else []
    print_options = await db.print_options.find({}, {"_id": 0}).to_list(1000)

    bands_by_id = {b.get("id"): b for b in creators}
    templates_by_id = {t.get("id"): t for t in templates}
    global_options_by_id = {str(o.get("id")): o for o in print_options if o.get("id")}

    rows = []
    for product in products:
        template = templates_by_id.get(product.get("template_id"), {})
        areas_by_id, screens_by_id, template_options_by_id = _template_lookup_maps(template)
        creator = bands_by_id.get(product.get("band_id"), {})
        groups = product.get("artwork_groups") or []

        for group in groups:
            for slot in group.get("artworks") or []:
                if not _artwork_slot_has_file(slot):
                    continue
                slot_status = slot.get("status") or "pending_review"
                if status and status != "all" and slot_status != status:
                    continue

                area = areas_by_id.get(str(slot.get("print_area_id")), {})
                screen = screens_by_id.get(str(slot.get("screen_id")), {})
                option = template_options_by_id.get(str(slot.get("print_option_id"))) or global_options_by_id.get(str(slot.get("print_option_id")))

                rows.append({
                    "product_id": product.get("id"),
                    "product_title": product.get("title"),
                    "product_published": product.get("published", False),
                    "product_artwork_review_status": product.get("artwork_review_status") or _derive_artwork_review_status(product),
                    "band_id": product.get("band_id"),
                    "band_name": creator.get("name") or "Unknown creator",
                    "template_id": product.get("template_id"),
                    "template_name": template.get("name") or "Unknown template",
                    "group_id": group.get("id"),
                    "group_label": group.get("label") or "Artwork group",
                    "group_scope_type": group.get("scope_type"),
                    "group_attribute_key": group.get("attribute_key"),
                    "group_attribute_value": group.get("attribute_value"),
                    "variation_ids": group.get("variation_ids") or [],
                    "artwork_id": slot.get("id"),
                    "artwork_status": slot_status,
                    "file_url": slot.get("original_url"),
                    "file_name": slot.get("file_name"),
                    "mime_type": slot.get("mime_type"),
                    "mockup_image_url": slot.get("mockup_image_url"),
                    "print_area_id": slot.get("print_area_id"),
                    "print_area_name": area.get("name") or slot.get("print_area_id") or "Print area",
                    "print_area_size": area.get("print_size"),
                    "screen_id": slot.get("screen_id"),
                    "screen_name": screen.get("name") or slot.get("screen_view") or area.get("screen_view"),
                    "screen_view": slot.get("screen_view") or area.get("screen_view"),
                    "print_option_id": slot.get("print_option_id"),
                    "print_option_label": _format_print_option_label(option),
                    "placement": slot.get("placement") or {},
                    "notes": slot.get("notes"),
                    "review_note": slot.get("review_note"),
                    "rejection_reason": slot.get("rejection_reason"),
                    "reviewed_by_user_id": slot.get("reviewed_by_user_id"),
                    "reviewed_at": slot.get("reviewed_at"),
                    "updated_at": product.get("updated_at"),
                })

    return rows


def _update_product_artwork_slot_status(product: dict, group_id: str, artwork_id: str, reviewer: User, status: str, notes: Optional[str]) -> dict:
    if status not in ARTWORK_REVIEW_STATUSES:
        raise HTTPException(status_code=400, detail="Invalid artwork review status")

    groups = product.get("artwork_groups") or []
    flat = product.get("artworks") or []
    found = False
    now = utcnow().isoformat()

    for group in groups:
        if group.get("id") != group_id:
            continue
        for slot in group.get("artworks") or []:
            if slot.get("id") != artwork_id:
                continue
            found = True
            slot["status"] = status
            slot["reviewed_by_user_id"] = reviewer.id
            slot["reviewed_at"] = now
            slot["review_note"] = notes or ""
            if status == "rejected":
                slot["rejection_reason"] = notes or "Artwork rejected"
            elif status == "approved":
                slot["rejection_reason"] = None
            break

    if not found:
        raise HTTPException(status_code=404, detail="Artwork slot not found")

    # Keep legacy flattened artwork list in sync.
    by_id = {}
    for group in groups:
        for slot in group.get("artworks") or []:
            if slot.get("id"):
                by_id[slot["id"]] = slot
    for index, slot in enumerate(flat):
        if slot.get("id") in by_id:
            flat[index] = {**slot, **by_id[slot["id"]]}

    product["artwork_groups"] = groups
    product["artworks"] = flat
    product["artwork_review_status"] = _derive_artwork_review_status(product)
    product["artwork_review_notes"] = notes or product.get("artwork_review_notes")
    product["updated_at"] = now

    if product["artwork_review_status"] == "rejected":
        product["published"] = False

    if product.get("artwork") and isinstance(product["artwork"], dict):
        # Sync old single-artwork field when it points at the same file.
        for slot in _product_artwork_slots(product):
            if slot.get("original_url") == product["artwork"].get("original_url"):
                product["artwork"]["status"] = slot.get("status")
                product["artwork"]["notes"] = slot.get("review_note") or slot.get("notes")
                break

    return product



@admin_router.post("/product-templates/duplicate/{template_id}", response_model=ProductTemplate)
async def admin_duplicate_product_template_safe(
    template_id: str,
    request: Request,
    user: User = Depends(require_role("admin", "super_admin", "manager")),
):
    db = request.app.state.db
    original = await db.product_templates.find_one({"id": template_id}, {"_id": 0})
    if not original:
        raise HTTPException(status_code=404, detail="Product template not found")

    copied = dict(original)
    copied.pop("_id", None)

    new_template_id = uid()
    original_name = original.get("name") or "Product Template"
    original_slug = original.get("slug") or original_name.lower().strip().replace(" ", "-")

    copied["id"] = new_template_id
    copied["name"] = f"{original_name} Copy"
    copied["slug"] = f"{original_slug}-copy-{new_template_id[:6]}"
    copied["status"] = "draft"
    copied["created_by"] = user.id

    from datetime import datetime, timezone
    timestamp = datetime.now(timezone.utc).isoformat()

    copied["created_at"] = timestamp
    copied["updated_at"] = timestamp

    screen_id_map = {}
    new_screens = []
    for screen in copied.get("mockup_screens") or []:
        row = dict(screen)
        old_id = str(row.get("id") or "")
        row["id"] = uid()
        if old_id:
            screen_id_map[old_id] = row["id"]
        new_screens.append(row)
    copied["mockup_screens"] = new_screens

    area_id_map = {}
    new_areas = []
    for area in copied.get("print_areas") or []:
        row = dict(area)
        old_id = str(row.get("id") or "")
        row["id"] = uid()

        old_screen_id = str(row.get("screen_id") or "")
        if old_screen_id and old_screen_id in screen_id_map:
            row["screen_id"] = screen_id_map[old_screen_id]

        if old_id:
            area_id_map[old_id] = row["id"]

        new_areas.append(row)
    copied["print_areas"] = new_areas

    new_variations = []
    for variation in copied.get("variations") or []:
        row = dict(variation)
        row["id"] = uid()

        overrides = row.get("mockup_screen_overrides") or {}
        if isinstance(overrides, dict):
            remapped = {}
            for key, value in overrides.items():
                remapped_key = screen_id_map.get(str(key), key)
                remapped[remapped_key] = value
            row["mockup_screen_overrides"] = remapped

        new_variations.append(row)
    copied["variations"] = new_variations

    await db.product_templates.insert_one(copied)
    return copied


