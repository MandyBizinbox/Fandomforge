def _build_production_snapshot(product: dict, template: Optional[dict], product_variation: Optional[dict], quantity: int) -> dict:
    template = template or {}
    product_variation = product_variation or {}

    selected_template_variation_ids = product.get("selected_template_variation_ids") or []
    template_variations = template.get("variations") or []
    selected_template_variation = None

    # Prefer the actual customer-selected product variation.
    # Older products may store many selected_template_variation_ids, so using
    # the first selected template variation can snapshot the wrong size/colour.
    if product_variation.get("attribute_values"):
        attrs = product_variation.get("attribute_values") or {}
        for row in template_variations:
            if (row.get("attributes") or {}) == attrs:
                selected_template_variation = row
                break

    if not selected_template_variation and product_variation.get("id"):
        selected_template_variation = _find_by_id(template_variations, product_variation.get("id"))

    if not selected_template_variation and selected_template_variation_ids:
        selected_template_variation = _find_by_id(template_variations, selected_template_variation_ids[0])

    if not selected_template_variation:
        selected_template_variation = product_variation

    artworks = product.get("artworks") or []
    artwork_group = _resolve_artwork_group_for_variation(
        product,
        selected_template_variation.get("id") or product_variation.get("id"),
        selected_template_variation.get("attributes") or product_variation.get("attribute_values") or {},
    )
    group_artworks = artwork_group.get("artworks") or []

    primary_artwork = next((row for row in group_artworks if row.get("print_area_id") == product.get("selected_print_area_id") and row.get("original_url")), None)
    if not primary_artwork:
        primary_artwork = next((row for row in group_artworks if row.get("original_url")), None)
    if not primary_artwork:
        primary_artwork = next((row for row in artworks if row.get("print_area_id") == product.get("selected_print_area_id") and row.get("original_url")), None)
    if not primary_artwork:
        primary_artwork = next((row for row in artworks if row.get("original_url")), None)

