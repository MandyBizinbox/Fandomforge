    method_key: str,
    payload: ShippingMethodUpdate,
    request: Request,
    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_shipping")
    db = request.app.state.db
    methods = await _get_shipping_methods(db)
    if method_key not in methods:
        raise HTTPException(status_code=404, detail="Shipping method not found")

    current = dict(methods[method_key])
    if payload.adapter_key is not None:
        try:
            get_shipping_method_adapter(payload.adapter_key)
        except KeyError:
            raise HTTPException(status_code=400, detail="Unknown shipping adapter")
        current["adapter_key"] = payload.adapter_key

    for field in ["enabled", "display_name", "description", "method_type", "sort_order", "rate", "free_shipping_threshold", "zones", "public_config"]:
        value = getattr(payload, field, None)
        if value is not None:
            if field == "rate":
                current[field] = float(value)
            elif field == "free_shipping_threshold":
                current[field] = None if value in (None, "") else float(value)
            elif field == "sort_order":
                current[field] = int(value)
            elif field == "public_config":
                current[field] = {**(current.get(field) or {}), **value}
            else:
                current[field] = value

    if payload.settings is not None:
        adapter = _shipping_adapter_for_config(current)
        password_keys = {field.get("key") for field in (adapter.settings_schema or []) if field.get("type") == "password"}
        settings = dict(current.get("settings") or {})
        for key, value in payload.settings.items():
            if key in password_keys and str(value).strip() in ["********", "••••••••", ""]:
                continue
            settings[key] = value
        current["settings"] = settings

    adapter = _shipping_adapter_for_config(current)
    current = adapter.validate_config(current)
    methods[method_key] = current
    await db.settings.update_one({"id": "platform"}, {"$set": {"shipping_methods": methods}}, upsert=True)
    return ShippingMethodConfig(**_mask_shipping_method_for_admin(current))


