def _mask_subscription_billing_settings(doc: Optional[dict]) -> dict:
    data = {**_default_subscription_billing_settings(), **(doc or {})}
    secret_configured = bool(str(data.get("secret_key") or "").strip()) or bool(os.environ.get("PAYSTACK_SUBSCRIPTION_SECRET_KEY"))
    data["secret_configured"] = secret_configured
    if data.get("secret_key"):
        data["secret_key"] = "********"
    data.pop("webhook_secret", None)
    data["webhook_secret_configured"] = data["secret_configured"]
    return data


