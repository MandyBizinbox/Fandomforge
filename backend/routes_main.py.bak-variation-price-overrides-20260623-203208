    return owner.get("contact_email") or ""


def _normalise_subscription_owner_type(owner_type: str) -> str:
    return "creator" if owner_type == "creator" else owner_type


async def _hydrate_subscription(db, doc: dict) -> dict:
    if not doc:
        return doc
    row = dict(doc)
    owner_type = _normalise_subscription_owner_type(row.get("owner_type") or "creator")
    owner = await _get_subscription_owner(db, owner_type, row.get("owner_id"))
    plan = None
    if row.get("plan_id"):
        plan = await db.subscription_plans.find_one({"id": row.get("plan_id")}, {"_id": 0})
    row["owner_type"] = owner_type
    row["owner_name"] = _subscription_owner_name(owner_type, owner)
    row["owner_email"] = _subscription_owner_email(owner_type, owner)
    row["plan_name"] = (plan or {}).get("name") or "Manual / Custom"
    row["plan_description"] = (plan or {}).get("description") or ""
    row["plan_currency"] = row.get("currency") or (plan or {}).get("currency") or "ZAR"
    row["paystack_plan_code"] = row.get("paystack_plan_code") or (plan or {}).get("paystack_plan_code")
    row["paystack_plan_name"] = row.get("paystack_plan_name") or (plan or {}).get("name") or row.get("plan_name")
    return row


async def _sync_owner_subscription_status(db, sub: dict) -> None:
    owner_type = _normalise_subscription_owner_type(sub.get("owner_type") or "creator")
    status = sub.get("status") or "manual"
    if owner_type in {"creator", "creator"}:
        mapped = "active" if status in SUBSCRIPTION_ACTIVE_STATUSES else ("past_due" if status == "past_due" else "inactive")
        await db.creators.update_one(
            {"id": sub.get("owner_id")},
            {"$set": {
                "subscription_status": mapped,
                "monthly_fee": float(sub.get("monthly_fee") or 0),
            }},
        )
    elif owner_type == "printer":
        if status in {"suspended", "cancelled"}:
            await db.printers.update_one({"id": sub.get("owner_id")}, {"$set": {"status": "suspended"}})
        elif status in SUBSCRIPTION_ACTIVE_STATUSES:
            await db.printers.update_one({"id": sub.get("owner_id"), "status": {"$in": ["pending", "suspended"]}}, {"$set": {"status": "active"}})


