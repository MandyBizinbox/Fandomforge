    return gateway


def _gateway_secret(config: dict, key: str = "secret_key") -> str:
    value = (config.get("settings") or {}).get(key) or ""
    value = str(value).strip()
    if value in ["********", "••••••••"]:
        return ""
    return value


async def _paystack_checkout_request(db, method: str, path: str, payload: Optional[dict] = None) -> dict:
    config = await _get_gateway_config(db, "paystack", masked=False)
    secret = _gateway_secret(config, "secret_key") or await _shop_paystack_secret_key(db)
    if not secret:
        raise HTTPException(status_code=400, detail="Paystack shop checkout secret key is not configured in Shop Settings → Checkout Payment Methods.")
    url = f"https://api.paystack.co{path}"
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Authorization": f"Bearer {secret}", "Content-Type": "application/json"},
        method=method.upper(),
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as res:
            return json.loads(res.read().decode("utf-8") or "{}")
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8")
        try:
            parsed = json.loads(body)
        except Exception:
            parsed = {"message": body}
        raise HTTPException(status_code=400, detail=parsed.get("message") or "Paystack request failed")
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Paystack request failed: {e}")


