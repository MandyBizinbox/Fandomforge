def _normalise_province(value: str) -> str:
    raw = str(value or "").strip().lower().replace("_", " ").replace("-", " ")
    raw = " ".join(raw.split())
    return PROVINCE_ALIASES.get(raw, raw.replace(" ", "_"))


def _delivery_province_from_shipping_address(shipping_address: Optional[dict]) -> str:
    address = shipping_address or {}
    return _normalise_province(
        address.get("state")
        or address.get("province")
        or address.get("region")
        or ""
    )


def _printer_province_key(printer: dict) -> str:
    return _normalise_province(
        printer.get("province")
        or printer.get("state")
        or printer.get("location")
        or ""
    )


def _capability_matrix_matches(printer: dict, method_key: str, area_key: str) -> bool:
    wanted_method = _normalise_print_method_key(method_key)
    wanted_area = _normalise_area_tag(area_key)

    for row in printer.get("capability_matrix") or []:
        if not row or row.get("active") is False:
            continue

        row_method = _normalise_print_method_key(row.get("method_key") or row.get("print_method") or row.get("method"))
        row_area = _normalise_area_tag(row.get("area_tag") or row.get("area_key") or row.get("tag"))

        if row_method == wanted_method and _area_keys_equivalent(wanted_area, row_area):
            return True

    # Compatibility fallback for existing printers where matrix is not populated yet.
    methods = [_normalise_print_method_key(value) for value in (printer.get("print_methods") or [])]
    areas = [_normalise_area_tag(value) for value in (printer.get("area_tags") or [])]

    if wanted_method in methods and not areas:
        return True

    return wanted_method in methods and any(_area_keys_equivalent(wanted_area, area) for area in areas)


async def _printer_active_workload_count(db, printer_id: str) -> int:
    active_statuses = [
        "paid",
        "awaiting_artwork_review",
        "sent_to_printer",
        "in_production",
        "ready_for_dispatch",
    ]

    return await db.orders.count_documents({
        "status": {"$in": active_statuses},
        "items": {
            "$elemMatch": {
                "printer_id": printer_id,
                "production_status": {"$in": ["pending", "accepted", "in_production", "ready"]},
            }
        },
    })


async def _best_capable_printer_for_product(
    db,
    product: dict,
    template: Optional[dict] = None,
    shipping_address: Optional[dict] = None,
) -> Optional[dict]:
    """Assign by capability first, then province, then workload.

    Rule:
    1. Printer must be active and match artwork method + area.
    2. Same province as delivery wins.
    3. If multiple remain, lowest active workload wins.
    4. If no same-province capable printer exists, use any capable active printer.
    """
    primary_slot = _primary_priced_artwork_slot_for_product(product)

    method_key = (
        primary_slot.get("method_key")
        or primary_slot.get("print_method")
        or ""
    )
    area_key = _area_key_for_snapshot_slot_or_area(primary_slot)

    if not area_key:
        area_id = primary_slot.get("print_area_id") or product.get("selected_print_area_id")
        if area_id and template:
            template_area = _find_by_id((template or {}).get("print_areas") or [], area_id) or {}
            area_key = _area_key_for_snapshot_slot_or_area(template_area)

    if not method_key:
        return None

    delivery_province = _delivery_province_from_shipping_address(shipping_address)

    printers = await db.printers.find(
        {"status": "active"},
        {"_id": 0},
    ).to_list(1000)

    capable = [
        printer for printer in printers
        if _capability_matrix_matches(printer, method_key, area_key)
    ]

    if not capable:
        return None

    same_province = [
        printer for printer in capable
        if delivery_province and _printer_province_key(printer) == delivery_province
    ]

    candidate_pool = same_province or capable

    ranked = []
    for printer in candidate_pool:
        workload = await _printer_active_workload_count(db, printer.get("id"))
        same_province_rank = 0 if delivery_province and _printer_province_key(printer) == delivery_province else 1
        ranked.append((same_province_rank, workload, printer.get("company_name") or "", printer))

    ranked.sort(key=lambda row: (row[0], row[1], row[2]))
    return ranked[0][3] if ranked else None


async def _best_printer_price_for_product(db, product: dict, template: Optional[dict] = None) -> Optional[dict]:
    """Return the lowest active printer price matching this product's template/area/method.

    Priority:
      1. Product assigned printer with exact template + artwork area + artwork print option
      2. Product assigned printer with template + artwork print option, any area
      3. Any printer with exact template + artwork area + artwork print option
      4. Any printer with template + artwork print option, any area
    """
    template_id = product.get("template_id")
    primary_slot = _primary_priced_artwork_slot_for_product(product)

    print_option_id = (
        primary_slot.get("print_option_id")
        or product.get("selected_print_option_id")
    )
    print_area_id = (
        primary_slot.get("print_area_id")
        or product.get("selected_print_area_id")
    )
    print_area_key = _area_key_for_snapshot_slot_or_area(primary_slot)

    if not print_area_key and print_area_id and template:
        template_area = _find_by_id((template or {}).get("print_areas") or [], print_area_id) or {}
        print_area_key = _area_key_for_snapshot_slot_or_area(template_area)

    if not template_id or not print_option_id:
        return None

    base_query = {
        "product_template_id": template_id,
        "print_option_id": print_option_id,
        "status": "active",
    }

    assigned_printer_id = product.get("assigned_printer_id")
    if assigned_printer_id:
        assigned_query = {**base_query, "printer_id": assigned_printer_id}
        if print_area_id:
            assigned_exact = await db.printer_template_prices.find_one({**assigned_query, "print_area_id": print_area_id}, {"_id": 0})
            if assigned_exact:
                return assigned_exact

        if print_area_key:
            assigned_candidates = await db.printer_template_prices.find(assigned_query, {"_id": 0}).to_list(500)
            assigned_key_matches = _filter_prices_by_area_key(template or {}, assigned_candidates, print_area_key)
            if assigned_key_matches:
                assigned_key_matches.sort(key=lambda row: float(row.get("total_price") or (float(row.get("blank_price") or 0) + float(row.get("print_price") or 0))))
                return assigned_key_matches[0]

        assigned_any = await db.printer_template_prices.find_one({
            **assigned_query,
            "$or": [
                {"print_area_id": {"$exists": False}},
                {"print_area_id": None},
                {"print_area_id": ""},
            ],
        }, {"_id": 0})
        if assigned_any:
            return assigned_any

        assigned_fallback = await db.printer_template_prices.find_one(assigned_query, {"_id": 0})
        if assigned_fallback:
            return assigned_fallback

    docs = []
    if print_area_id:
        docs = await db.printer_template_prices.find({**base_query, "print_area_id": print_area_id}, {"_id": 0}).to_list(500)

    if not docs and print_area_key:
        area_key_candidates = await db.printer_template_prices.find(base_query, {"_id": 0}).to_list(500)
        docs = _filter_prices_by_area_key(template or {}, area_key_candidates, print_area_key)

    if not docs:
        docs = await db.printer_template_prices.find({
            **base_query,
            "$or": [
                {"print_area_id": {"$exists": False}},
                {"print_area_id": None},
                {"print_area_id": ""},
            ],
        }, {"_id": 0}).to_list(500)

    if not docs:
        docs = await db.printer_template_prices.find(base_query, {"_id": 0}).to_list(500)

    if not docs:
        return None

    docs.sort(key=lambda row: float(row.get("total_price") or (float(row.get("blank_price") or 0) + float(row.get("print_price") or 0))))
    return docs[0]


def _merge_printer_price_into_snapshot(snapshot: dict, printer_price: Optional[dict], quantity: int) -> dict:
    if not printer_price:
        return snapshot

    qty = max(quantity, 1)
    blank_price = float(printer_price.get("blank_price") or 0)
    print_price = float(printer_price.get("print_price") or 0)
    total_unit = float(printer_price.get("total_price") or (blank_price + print_price))

    variation = dict(snapshot.get("variation") or {})
    variation["blank_cost"] = blank_price or variation.get("blank_cost") or 0

    print_option = dict(snapshot.get("print_option") or {})
    print_option["printer_price_id"] = printer_price.get("id")
    print_option["printer_print_price"] = print_price

    snapshot["variation"] = variation
    snapshot["print_option"] = print_option
    snapshot["printer_price_id"] = printer_price.get("id")
    snapshot["production_cost"] = total_unit * qty
    snapshot["printer_payout"] = total_unit * qty
    snapshot["printer_production_notes"] = printer_price.get("production_notes")
    return snapshot


