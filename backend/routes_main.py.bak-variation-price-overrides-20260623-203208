async def _finalize_paid_manual_order(db, order: Order, order_items: List[OrderItem], user_id: Optional[str] = None) -> None:
    now = datetime.now(timezone.utc).isoformat()

    await db.orders.update_one(
        {"id": order.id},
        {"$set": {"payment_status": "paid", "status": "sent_to_printer", "updated_at": now}},
    )

    for item in order_items:
        await db.commissions.insert_one(iso_dates(Commission(
            order_id=order.id,
            order_item_id=item.id,
            band_id=item.band_id,
            amount=item.commission_amount,
            rate=item.commission_rate,
        ).model_dump()))

        if item.printer_id:
            await db.payouts.insert_one(iso_dates(Payout(
                printer_id=item.printer_id,
                order_id=order.id,
                order_item_id=item.id,
                amount=item.printer_payout,
            ).model_dump()))

    refreshed_order = await db.orders.find_one({"id": order.id}, {"_id": 0})
    if refreshed_order:
        await ensure_wallet_transactions_for_order(db, refreshed_order)

    pay = Payment(
        order_id=order.id,
        user_id=user_id,
        amount=order.total,
        provider="manual",
        provider_reference=new_reference(),
        status="completed",
        kind="order",
    )

    pdoc = iso_dates(pay.model_dump())
    pdoc["completed_at"] = now
    await db.payments.insert_one(pdoc)


async def _manual_order_cart_items_for_products(db, lines: List[ManualOrderCreateItem], allowed_band_id: Optional[str] = None) -> List[CartItem]:
    if not lines:
        raise HTTPException(status_code=400, detail="At least one item required")

    cart_items: List[CartItem] = []

    for line in lines:
        if line.quantity < 1:
            raise HTTPException(status_code=400, detail="Quantity must be at least 1")

        product = await db.products.find_one({"id": line.product_id}, {"_id": 0})
        if not product:
            raise HTTPException(status_code=400, detail=f"Product not found: {line.product_id}")

        if allowed_band_id and product.get("band_id") != allowed_band_id:
            raise HTTPException(status_code=403, detail="You can only create manual orders for your own products")

        variation = next((v for v in product.get("variations", []) if v.get("id") == line.variation_id), None)
        if not variation:
            raise HTTPException(status_code=400, detail=f"Variation not found for product: {product.get('title')}")

        attrs = variation.get("attribute_values") or {}
        cart_items.append(CartItem(
            product_id=product["id"],
            product_title=product["title"],
            band_id=product["band_id"],
            variation_id=variation["id"],
            size=variation.get("size") or attrs.get("Size") or attrs.get("size") or "",
            color=variation.get("color") or attrs.get("Colour") or attrs.get("Color") or attrs.get("colour") or attrs.get("color") or "",
            unit_price=float(product.get("selling_price") or 0),
            quantity=line.quantity,
            mockup_url=(product.get("mockup_images") or [None])[0],
        ))

    return cart_items


async def _create_manual_order_document(db, payload: ManualOrderCreate, user_id: Optional[str] = None, allowed_band_id: Optional[str] = None) -> Order:
    cart_items = await _manual_order_cart_items_for_products(db, payload.items, allowed_band_id=allowed_band_id)
    order_items, subtotal = await _build_order_items(db, cart_items)

    order = Order(
        buyer_id=None,
        buyer_email=payload.shipping_address.email,
        items=order_items,
        subtotal=subtotal,
        total=subtotal,
        shipping_address=payload.shipping_address,
        payment_provider="manual",
        status="pending_payment",
    )

    doc = order.model_dump()
    doc["created_at"] = doc["created_at"].isoformat()
    doc["updated_at"] = doc["updated_at"].isoformat()

    if selected_collection_slot:
        doc["collection_slot_id"] = selected_collection_slot.get("id")
        doc["collection_slot"] = selected_collection_slot
        doc["collection_location_name"] = selected_shipping.get("collection_location_name") or ""
        doc["collection_address"] = selected_shipping.get("collection_address") or ""
        doc["collection_instructions"] = selected_shipping.get("collection_instructions") or ""
    await db.orders.insert_one(doc)
    await add_order_event(
        db,
        order=doc,
        order_id=order.id,
        actor=None,
        kind="manual_order_created",
        title="Manual order created",
        message=f"Manual order {order.order_number} was created.",
        audience=["admin", "creator", "printer", "all"],
        metadata={"source": "manual", "total": order.total},
    )
    await queue_customer_order_email(
        db,
        order=doc,
        subject=f"Order {order.order_number} received",
        body=f"Your order {order.order_number} has been created. You will receive status updates as it moves through production.",
    )

    if payload.mark_paid:
        await _finalize_paid_manual_order(db, order, order_items, user_id=user_id)

    saved = await db.orders.find_one({"id": order.id}, {"_id": 0})
    return Order(**saved)


async def _build_order_items(db, items: List[CartItem], shipping_address: Optional[dict] = None) -> tuple[List[OrderItem], float]:
    out: List[OrderItem] = []
    subtotal = 0.0
    settings_doc = await db.settings.find_one({"id": "platform"}, {"_id": 0})
    default_rate = (settings_doc or {}).get("default_commission_rate", 0.15)

    for ci in items:
        product = await db.products.find_one({"id": ci.product_id}, {"_id": 0})
        if not product:
            raise HTTPException(status_code=400, detail=f"Product not found: {ci.product_id}")

        creator = await db.creators.find_one({"id": product["band_id"]}, {"_id": 0})
        rate = (creator or {}).get("commission_rate", default_rate)

        unit_price = float(product["selling_price"])
        product_variation = None
        for v in product.get("variations", []) or []:
            if v.get("id") == ci.variation_id:
                product_variation = v
                if v.get("price_override") is not None:
                    unit_price = float(v["price_override"])
                break

        template = None
        if product.get("template_id"):
            template = await db.product_templates.find_one({"id": product.get("template_id")}, {"_id": 0})

        # Phase 3.8B: assignment is capability-controlled.
        # Pricing/payout remains platform-controlled.
        capable_printer = await _best_capable_printer_for_product(
            db,
            product,
            template,
            shipping_address,
        )

        printer_price = None  # legacy pricing is no longer used for payout or assignment
        assigned_printer_id = (
            product.get("assigned_printer_id")
            or (capable_printer or {}).get("id")
        )

        # Simple/manual products do not have template artwork slots, so the
        # capability matcher cannot infer a printer. For launch safety, route
        # them to the first active/default printer instead of leaving the order
        # unassigned.
        is_simple_manual_product = (
            product.get("product_mode") == "simple_manual"
            or product.get("production_mode") == "manual_no_template"
            or product.get("quick_product") is True
        )
        if is_simple_manual_product and not assigned_printer_id:
            default_printer = await db.printers.find_one({"status": "active"}, {"_id": 0})
            if default_printer:
                capable_printer = default_printer
                assigned_printer_id = default_printer.get("id")

        template_variation = None
        if template:
            template_variation = _find_by_id((template or {}).get("variations") or [], ci.variation_id)

        blank_costing = _resolve_blank_costing(
            template_variation or product_variation,
            template,
        )

        platform_blank_cost = float(
            product.get("platform_blank_cost")
            or blank_costing["platform_blank_cost"]
            or product.get("estimated_blank_supplier_cost")
            or product.get("blank_supplier_cost")
            or 0
        )
        creator_blank_price = float(
            product.get("creator_blank_price")
            or blank_costing["creator_blank_price"]
            or 0
        )

        primary_slot = _primary_priced_artwork_slot_for_product(product)
        primary_print_option = {}
        if template:
            primary_print_option = _snapshot_print_option_from_artwork_or_product(product, template, primary_slot)

        print_costing = _resolve_print_costing(
            primary_print_option,
            primary_slot,
            primary_slot.get("calculated_print_cost")
            or primary_slot.get("print_cost_max")
            or product.get("platform_print_cost")
            or product.get("print_cost")
            or 0,
        )

        platform_print_cost = float(
            product.get("platform_print_cost")
            or print_costing["platform_print_cost"]
            or 0
        )
        creator_print_price = float(
            product.get("creator_print_price")
            or print_costing["creator_print_price"]
            or 0
        )

        costing = _platform_costing_breakdown(
            platform_blank_cost,
            platform_print_cost,
            rate,
            unit_price,
            ci.quantity,
            creator_blank_price=creator_blank_price,
            creator_print_price=creator_print_price,
        )

        print_cost = costing["print_payout_unit"]
        production_unit_cost = costing["production_unit_cost"]
        commission_amount = costing["commission_unit"]
        band_earnings = costing["creator_profit_unit"]
        printer_payout = costing["production_unit_cost"]

        production_snapshot = _build_production_snapshot(product, template, product_variation, ci.quantity)
        production_snapshot["costing_model"] = "platform_controlled_v2"
        production_snapshot["costing_breakdown"] = {
            "blank_supplier_cost": costing["blank_supplier_cost"],
            "platform_blank_cost": costing["platform_blank_cost"],
            "creator_blank_price": costing["creator_blank_price"],
            "platform_print_cost": costing["platform_print_cost"],
            "creator_print_price": costing["creator_print_price"],
            "platform_blank_profit": costing["platform_blank_profit"],
            "platform_print_profit": costing["platform_print_profit"],
            "estimated_platform_profit": costing["estimated_platform_profit"],
            "creator_product_cost": costing["creator_product_cost"],
            "blank_markup_rate": 0.10,
            "print_markup_rate": 0.10,
            "blank_payout_unit": costing["blank_payout_unit"],
            "print_payout_unit": costing["print_payout_unit"],
            "production_unit_cost": costing["production_unit_cost"],
            "minimum_selling_price": costing["minimum_selling_price"],
        }
        production_snapshot["production_cost"] = costing["production_cost"]
        production_snapshot["printer_payout"] = costing["printer_payout"]
        production_snapshot["platform_commission"] = costing["platform_commission"]
        production_snapshot["creator_profit"] = costing["creator_profit"]
        production_snapshot["platform_blank_profit"] = costing["platform_blank_profit"]
        production_snapshot["platform_print_profit"] = costing["platform_print_profit"]
        production_snapshot["estimated_platform_profit"] = costing["estimated_platform_profit"]
        production_snapshot["creator_product_cost"] = costing["creator_product_cost"]
        production_snapshot["assignment_model"] = "capability_province_v1"
        if capable_printer:
            production_snapshot["assigned_printer"] = {
                "id": capable_printer.get("id"),
                "company_name": capable_printer.get("company_name"),
                "city": capable_printer.get("city"),
                "province": capable_printer.get("province"),
                "province_key": _printer_province_key(capable_printer),
            }
            production_snapshot["delivery_province_key"] = _delivery_province_from_shipping_address(shipping_address)
        if printer_price:
            production_snapshot["printer_price_id_legacy_assignment"] = printer_price.get("id")

        artwork_file_url = (production_snapshot.get("artwork") or {}).get("url")

        oi = OrderItem(
            product_id=product["id"],
            product_title=product["title"],
            band_id=product["band_id"],
            printer_id=assigned_printer_id,
            variation_id=ci.variation_id,
            size=ci.size,
            color=ci.color,
            quantity=ci.quantity,
            unit_price=unit_price,
            print_cost_unit=print_cost,
            commission_rate=rate,
            commission_amount=commission_amount * ci.quantity,
            band_earnings=band_earnings * ci.quantity,
            printer_payout=printer_payout * ci.quantity,
            customization=ci.customization,
            artwork_file_url=artwork_file_url,
            production_snapshot=production_snapshot,
        )

        if not oi.artwork_file_url:
            art = await db.artworks.find_one(
                {"product_id": product["id"], "status": "approved"},
                {"_id": 0},
            )
            if art:
                oi.artwork_file_url = art["file_url"]
                if oi.production_snapshot:
                    oi.production_snapshot.artwork["url"] = art["file_url"]
                    oi.production_snapshot.artwork["file_name"] = art.get("file_name")
                    oi.production_snapshot.artwork["status"] = art.get("status")

        subtotal += unit_price * ci.quantity
        out.append(oi)

    return out, round(subtotal, 2)


@orders_router.post("/checkout", response_model=dict)
async def checkout(
    payload: CheckoutRequest,
    request: Request,
    user: User = Depends(optional_user),
):
    db = request.app.state.db

    if not payload.items:
        raise HTTPException(status_code=400, detail="Cart is empty")

    shipping_address_data = payload.shipping_address.model_dump() if hasattr(payload.shipping_address, "model_dump") else payload.shipping_address
    order_items, subtotal = await _build_order_items(db, payload.items, shipping_address_data)
    shipping_quotes = await _shipping_quotes(db, subtotal=subtotal, shipping_address=payload.shipping_address.model_dump(), items=[item.model_dump() if hasattr(item, "model_dump") else dict(item) for item in (payload.items or [])])
    selected_shipping_key = (payload.shipping_method_key or (shipping_quotes[0]["key"] if shipping_quotes else "manual_shipping")).strip()
    selected_shipping = next((q for q in shipping_quotes if q.get("key") == selected_shipping_key), None)
    if not selected_shipping:
        raise HTTPException(status_code=400, detail="Selected shipping method is not available for this address/order")

    selected_collection_slot = None
    if selected_shipping.get("key") == "creator_bulk_collection":
        collection_slot_id = str(getattr(payload, "collection_slot_id", "") or "").strip()
        if not collection_slot_id:
            raise HTTPException(status_code=400, detail="Choose a collection slot for group collection")

        for slot in selected_shipping.get("slots") or []:
            if str(slot.get("id") or "") == collection_slot_id and slot.get("enabled") is not False:
                selected_collection_slot = slot
                break

        if not selected_collection_slot:
            raise HTTPException(status_code=400, detail="Selected collection slot is not available")

    shipping_total = float(selected_shipping.get("amount") or 0)
    order_total = round(float(subtotal or 0) + shipping_total, 2)

    order = Order(
        buyer_id=user.id if user else None,
        buyer_email=payload.shipping_address.email,
        items=order_items,
        subtotal=subtotal,
        shipping_total=shipping_total,
        total=order_total,
        shipping_method_key=selected_shipping.get("key"),
        shipping_adapter_key=selected_shipping.get("adapter_key"),
        shipping_method_name=selected_shipping.get("display_name"),
        shipping_method_type=selected_shipping.get("method_type"),
        shipping_tracking_url_template=selected_shipping.get("tracking_url_template"),
        shipping_address=payload.shipping_address,
        payment_provider=payload.payment_provider,
    )

    doc = order.model_dump()
    doc["created_at"] = doc["created_at"].isoformat()
    doc["updated_at"] = doc["updated_at"].isoformat()
    await db.orders.insert_one(doc)
    await add_order_event(
        db,
        order=doc,
        actor=user,
        kind="order_created",
        title="Order created",
        message=f"Order {order.order_number} was created through checkout.",
        audience=["admin", "creator", "printer", "all"],
        metadata={"source": "checkout", "total": order.total},
    )
    await queue_customer_order_email(
        db,
        order=doc,
        subject=f"Order {order.order_number} received",
        body=f"Your order {order.order_number} has been received. Track it here: {tracking_url_for_order(request, doc)}",
    )

    gateway_key = (payload.payment_provider or "manual_eft").strip()
    gateway = await _get_gateway_config(db, gateway_key, masked=False)
    if not gateway.get("enabled"):
        raise HTTPException(status_code=400, detail="Selected payment method is not enabled")

    ref = new_reference()
    base = str(request.base_url).rstrip("/")
    tracking_url = tracking_url_for_order(request, doc)

    payment_status = "pending"
    payment_url = f"{base}/order-confirmation/{order.id}"
    payment_action = "manual"
    gateway_response: Dict[str, Any] = {}
    provider_payment_id = None

    adapter_order = {
        **doc,
        "id": order.id,
        "order_number": order.order_number,
        "buyer_email": order.buyer_email,
        "total": order.total,
        "subtotal": order.subtotal,
        "shipping_total": order.shipping_total,
        "tracking_token": doc.get("tracking_token"),
    }
    callback_url = f"{base}/order-confirmation/{order.id}?reference={ref}"
    urls = {
        "reference": ref,
        "return_url": callback_url,
        "success_url": callback_url,
        "cancel_url": f"{base}/checkout",
        "failure_url": f"{base}/order-confirmation/{order.id}?reference={ref}&payment=failed",
        "webhook_url": f"{base}/api/payments/webhooks/{gateway_key}",
    }

    try:
        adapter = get_payment_gateway_adapter(gateway_key)
    except KeyError:
        if gateway_key == "mock":
            provider = get_provider("mock")
            init = provider.initiate(
                amount=order.total,
                description=f"FandomForge Order {order.order_number}",
                reference=ref,
                return_url=callback_url,
                cancel_url=f"{base}/cart",
                notify_url=f"{base}/api/payments/webhook?provider=mock",
                email=order.buyer_email,
            )
            payment_url = init["payment_url"]
            gateway_response = init
            payment_action = "mock"
        else:
            raise HTTPException(status_code=400, detail="Payment gateway is not implemented yet")
    else:
        try:
            init = await adapter.initialize_payment(adapter_order, gateway, urls)
        except PaymentGatewayError as exc:
            raise HTTPException(status_code=400, detail=str(exc))
        ref = init.get("reference") or ref
        payment_url = init.get("payment_url") or payment_url
        payment_action = init.get("payment_action") or ("redirect" if init.get("hosted_checkout") else "manual")
        provider_payment_id = init.get("payment_id")
        gateway_response = init.get("manual_payment_details") or init.get("raw") or init

    payment = Payment(
        order_id=order.id,
        user_id=user.id if user else None,
        amount=order.total,
        provider=gateway_key,
        provider_reference=ref,
        status=payment_status,
        kind="order",
    )

    payment_doc = iso_dates(payment.model_dump())
    payment_doc["gateway_response"] = gateway_response
    payment_doc["provider_payment_id"] = provider_payment_id
    await db.payments.insert_one(payment_doc)
    await db.orders.update_one(
        {"id": order.id},
        {"$set": {
            "payment_id": payment.id,
            "payment_provider": gateway_key,
            "payment_reference": ref,
            "provider_payment_id": provider_payment_id,
        }},
    )

    return {
        "order_id": order.id,
        "order_number": order.order_number,
        "tracking_token": doc.get("tracking_token"),
        "tracking_url": tracking_url,
        "payment_url": payment_url,
        "payment_action": payment_action,
        "gateway": _public_gateway_config(gateway),
        "provider": gateway_key,
        "reference": ref,
        "total": order.total,
        "manual_payment_details": gateway_response if gateway_key == "manual_eft" else None,
    }


