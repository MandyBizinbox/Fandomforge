@admin_router.patch("/payment-gateways/{gateway_key}", response_model=PaymentGatewayConfig)
async def admin_update_payment_gateway(
    gateway_key: str,
    payload: PaymentGatewayUpdate,
    request: Request,
    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_shop_payment_gateways")
    db = request.app.state.db
    gateways = await _get_payment_gateways(db, mask=False)
    if gateway_key not in gateways:
        raise HTTPException(status_code=404, detail="Payment gateway not found")

    current = gateways[gateway_key]
