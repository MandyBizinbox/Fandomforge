@admin_router.post("/payout-batches", response_model=PayoutBatch)
async def admin_create_payout_batch(
    payload: PayoutBatchCreate,
    request: Request,
    user: User = Depends(get_current_user),
):
    _require_manager_permission(user, "manage_payouts")
    db = request.app.state.db
    await rebuild_wallet_ledger_from_paid_orders(db)

    query: Dict[str, Any] = {"status": "available", "owner_type": {"$in": ["creator", "printer"]}}
    if payload.owner_type:
        query["owner_type"] = payload.owner_type

    ledger = await db.wallet_transactions.find(query, {"_id": 0}).to_list(10000)
    grouped: Dict[str, dict] = {}
    for row in ledger:
        amount = float(row.get("amount") or 0)
        if amount <= 0:
            continue
        key = f"{row.get('owner_type')}::{row.get('owner_id')}"
        bucket = grouped.setdefault(key, {
            "owner_type": row.get("owner_type"),
            "owner_id": row.get("owner_id"),
            "amount": 0.0,
            "wallet_transaction_ids": [],
        })
        bucket["amount"] += amount
        bucket["wallet_transaction_ids"].append(row["id"])

    items: List[PayoutBatchItem] = []
    for bucket in grouped.values():
        amount = round(bucket["amount"], 2)
        if amount < payload.min_amount:
            continue
        profile = await _profile_for_owner(db, bucket["owner_type"], bucket["owner_id"])
        provider = payload.provider
        if profile and profile.get("provider"):
            provider = profile["provider"]
        owner_name = await _owner_display_name(db, bucket["owner_type"], bucket["owner_id"])
        items.append(PayoutBatchItem(
            owner_type=bucket["owner_type"],
            owner_id=bucket["owner_id"],
            payout_profile_id=profile.get("id") if profile else None,
            provider=provider,
            amount=amount,
            wallet_transaction_ids=bucket["wallet_transaction_ids"],
            metadata={
                "owner_label": _public_owner_label(bucket["owner_type"], bucket["owner_id"]),
                "owner_name": owner_name,
            },
        ))

    title = payload.title or f"Weekly payout batch {datetime.now(timezone.utc).date().isoformat()}"
    batch = PayoutBatch(
        title=title,
        provider=payload.provider,
        items=items,
        total_amount=round(sum(i.amount for i in items), 2),
        created_by_user_id=user.id,
    )
    doc = iso_dates(batch.model_dump())
    await db.payout_batches.insert_one(doc)

    for item in items:
        await db.wallet_transactions.update_many(
            {"id": {"$in": item.wallet_transaction_ids}},
            {"$set": {"status": "in_batch", "payout_batch_id": batch.id, "payout_batch_item_id": item.id}},
        )

    return PayoutBatch(**doc)


