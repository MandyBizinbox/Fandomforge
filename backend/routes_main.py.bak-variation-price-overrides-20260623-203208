async def _mark_order_paid_from_payment(db, payment: dict, provider_payload: Optional[dict] = None) -> Optional[dict]:
    if not payment or not payment.get("order_id"):
        return None
    order = await db.orders.find_one({"id": payment["order_id"]}, {"_id": 0})
    if not order:
        return None
    if order.get("payment_status") == "paid":
        return order
    now = datetime.now(timezone.utc).isoformat()
    await db.payments.update_one(
        {"id": payment["id"]},
        {"$set": {"status": "completed", "completed_at": now, "provider_payload": provider_payload or {}}},
    )
    await db.orders.update_one(
        {"id": order["id"]},
        {"$set": {
            "payment_status": "paid",
            "status": "sent_to_printer",
            "payment_reference": payment.get("provider_reference"),
            "provider_payment_id": payment.get("provider_payment_id"),
            "updated_at": now,
        }},
    )
    refreshed = await db.orders.find_one({"id": order["id"]}, {"_id": 0})
    if refreshed:
        await ensure_wallet_transactions_for_order(db, refreshed)
        await add_order_event(
            db,
            order=refreshed,
            actor=None,
            kind="payment_updated",
            title="Payment confirmed",
            message=f"Payment for order {refreshed.get('order_number')} was confirmed.",
            audience=["admin", "creator", "printer", "buyer", "all"],
            metadata={"provider": payment.get("provider"), "reference": payment.get("provider_reference")},
        )
        await queue_customer_order_email(
            db,
            order=refreshed,
            subject=f"Payment confirmed for {refreshed.get('order_number')}",
            body=f"Payment for your order {refreshed.get('order_number')} has been confirmed. Track it here: {tracking_url_for_order(None, refreshed)}",
        )
    return refreshed


async def _payment_summary_for_order(db, order: dict) -> Optional[dict]:
    if not order:
        return None
    payment = None
    payment_id = order.get("payment_id")
    if payment_id:
        payment = await db.payments.find_one({"id": payment_id}, {"_id": 0})
    if not payment:
        payment = await db.payments.find_one({"order_id": order.get("id")}, {"_id": 0}, sort=[("created_at", -1)])
    if not payment:
        return None
    return {
        "id": payment.get("id"),
        "kind": payment.get("kind"),
        "provider": payment.get("provider") or order.get("payment_provider"),
        "status": payment.get("status"),
        "amount": payment.get("amount"),
        "currency": payment.get("currency") or "ZAR",
        "reference": payment.get("provider_reference"),
        "provider_payment_id": payment.get("provider_payment_id"),
        "created_at": payment.get("created_at"),
        "completed_at": payment.get("completed_at"),
    }


async def _attach_order_payment_summary(db, order: dict) -> dict:
    if not order:
        return order
    summary = await _payment_summary_for_order(db, order)
    if summary:
        order = dict(order)
        order["payment_details"] = summary
        order["payment_reference"] = summary.get("reference") or order.get("payment_reference")
        order["provider_payment_id"] = summary.get("provider_payment_id") or order.get("provider_payment_id")
    return order


