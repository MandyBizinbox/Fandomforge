    try:
        return await _admin_create_quick_product_impl(payload, request, user)
    except HTTPException:
        raise
    except Exception as exc:
        print("QUICK_PRODUCT_500_DEBUG:", repr(exc))
        traceback.print_exc()
        raise


async def _admin_create_quick_product_impl(
    payload: QuickProductCreate,
    request: Request,
    user: User,
):
    if getattr(user, "role", "") != "super_admin":
        raise HTTPException(status_code=403, detail="Only super admins can create quick products")

    db = request.app.state.db

    creator_id = str(payload.creator_id or "").strip()
    creator = await db.creators.find_one({"id": creator_id}, {"_id": 0})
    if not creator:
        raise HTTPException(status_code=404, detail="Creator/store not found")

    name = str(payload.name or "").strip()
    if not name:
        raise HTTPException(status_code=400, detail="Product name is required")

    image_url = str(payload.image_url or "").strip()
    if not image_url:
        raise HTTPException(status_code=400, detail="Product image URL is required")

    price = round(float(payload.price or 0), 2)
    if price <= 0:
        raise HTTPException(status_code=400, detail="Price must be greater than zero")

    platform_cost = round(float(payload.platform_cost or 0), 2)
    creator_cost = round(float(payload.creator_cost or platform_cost or 0), 2)
    stock_status = str(payload.stock_status or "made_to_order").strip() or "made_to_order"
    stock_quantity = max(int(payload.stock_quantity or 0), 0) or 999

    commission_rate = 0.15
    commission_amount = round(price * commission_rate, 2)
    platform_blank_profit = round(creator_cost - platform_cost, 2)
