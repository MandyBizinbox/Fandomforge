def slugify(s: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9\s-]", "", s.lower()).strip()
    s = re.sub(r"[\s-]+", "-", s)
    return s or uid()[:8]


def iso_dates(doc: dict) -> dict:
    out = dict(doc)
    for k, v in list(out.items()):
        if isinstance(v, datetime):
            out[k] = v.isoformat()
    return out


def clean_user_doc(doc: dict) -> dict:
    out = dict(doc or {})
    out.pop("_id", None)
    out.pop("password_hash", None)
    return out


def normalize_email(email: str) -> str:
    return (email or "").strip().lower()


OWNER_ROLES = {"super_admin", "owner"}
ADMINISH_ROLES = {"super_admin", "owner", "admin", "manager"}


def _is_owner_user(user: User) -> bool:
    return user.role in OWNER_ROLES


def _manager_permissions(user: User) -> Dict[str, bool]:
    try:
        base = ManagerPermissions().model_dump()
    except Exception:
        base = {}
    supplied = getattr(user, "manager_permissions", None) or {}
    base.update({k: bool(v) for k, v in supplied.items()})
    return base


def _require_adminish_user(user: User) -> None:
    if user.role not in ADMINISH_ROLES:
        raise HTTPException(status_code=403, detail="Requires owner, admin or manager access")


def _require_manager_permission(user: User, permission: str) -> None:
    if _is_owner_user(user) or user.role == "admin":
        return
    if user.role != "manager":
        raise HTTPException(status_code=403, detail="Requires manager access")
    if not _manager_permissions(user).get(permission):
        raise HTTPException(status_code=403, detail=f"Manager permission required: {permission}")




def _require_owner_user(user: User) -> None:
    if not _is_owner_user(user):
        raise HTTPException(status_code=403, detail="Owner access required")


def _require_admin_or_manager_permission(user: User, permission: str) -> None:
    _require_manager_permission(user, permission)


def _require_adminish_or_owner(user: User) -> None:
    _require_adminish_user(user)

def _normalize_manager_permissions(value: Optional[Dict[str, bool]]) -> Dict[str, bool]:
    base = ManagerPermissions().model_dump()
    if value:
        for key in base:
            if key in value:
                base[key] = bool(value[key])
    return base


def _clean_admin_user(doc: Optional[dict]) -> dict:
    out = clean_user_doc(doc or {})

    # FandomForge compatibility:
    # Older MerchForge/OrderHub data used role="band".
    # The current FandomForge User model expects role="creator".
    # Normalize this at response level so legacy records do not crash admin user lists.
    if out.get("role") == "band":
        out["role"] = "creator"

    if out.get("role") == "manager":
        out["manager_permissions"] = _normalize_manager_permissions(out.get("manager_permissions") or {})
    else:
        out.setdefault("manager_permissions", {})
    return out



