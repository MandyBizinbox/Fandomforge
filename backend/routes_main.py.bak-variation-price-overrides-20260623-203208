PAYSTACK_INTERVAL_MAP = {
    "monthly": "monthly",
    "quarterly": "quarterly",
    "annual": "annually",
    "manual": "monthly",
}


def _paystack_amount(value: Any) -> int:
    return int(round(float(value or 0) * 100))


def _subscription_period_end_from_cycle(cycle: str, start: Optional[datetime] = None) -> datetime:
    current = start or utcnow()
    days = 30
    if cycle == "quarterly":
        days = 90
    elif cycle == "annual":
        days = 365
    return current + timedelta(days=days)


def _paystack_subscription_callback_url(request: Request, subscription_id: str) -> str:
    base = str(request.base_url).rstrip("/")
    return f"{base}/admin?tab=settings&settingsTab=subscriptions&subscription_id={subscription_id}"


def _verify_paystack_signature(secret: str, raw_body: bytes, signature: Optional[str]) -> bool:
    if not secret or not signature:
        return False
    digest = hmac.new(secret.encode("utf-8"), raw_body, hashlib.sha512).hexdigest()
    return hmac.compare_digest(digest, signature)


async def _ensure_subscription_plan_synced_with_paystack(db, plan: dict) -> dict:
    if not plan:
        raise HTTPException(status_code=404, detail="Subscription plan not found")
    if float(plan.get("monthly_price") or 0) <= 0:
        raise HTTPException(status_code=400, detail="Paystack recurring plans require a price greater than zero.")

    existing_code = (plan.get("paystack_plan_code") or "").strip()
    if existing_code:
        return plan

    interval = PAYSTACK_INTERVAL_MAP.get(plan.get("billing_cycle") or "monthly", "monthly")
    payload = {
        "name": plan.get("name") or "Subscription Plan",
        "description": plan.get("description") or plan.get("name") or "Subscription Plan",
        "amount": _paystack_amount(plan.get("monthly_price") or 0),
        "interval": interval,
        "currency": "ZAR",
    }
    res = await _paystack_subscription_request(db, "POST", "/plan", payload)
    data = res.get("data") or {}
    plan_code = data.get("plan_code")
    if not plan_code:
        raise HTTPException(status_code=400, detail="Paystack did not return a plan code.")

    updates = {
        "paystack_plan_code": plan_code,
        "paystack_plan_synced_at": utcnow(),
        "paystack_plan_sync_status": "synced",
        "paystack_plan_sync_message": res.get("message") or "Synced with Paystack",
        "updated_at": utcnow(),
    }
    await db.subscription_plans.update_one({"id": plan["id"]}, {"$set": iso_dates(updates)})
    updated = await db.subscription_plans.find_one({"id": plan["id"]}, {"_id": 0})
    return updated or {**plan, **updates}


def _paystack_plan_code_from_payload(data: dict, fallback: Optional[str] = None) -> Optional[str]:
    plan = data.get("plan")
    if isinstance(plan, dict):
        return plan.get("plan_code") or plan.get("code") or fallback
    if isinstance(plan, str):
        return plan or fallback
    return data.get("plan_code") or fallback


def _paystack_subscription_code_from_payload(data: dict, fallback: Optional[str] = None) -> Optional[str]:
    subscription = data.get("subscription")
    if isinstance(subscription, dict):
        return subscription.get("subscription_code") or subscription.get("code") or fallback
    if isinstance(subscription, str):
        return subscription or fallback
    return data.get("subscription_code") or data.get("subscription_id") or fallback


def _paystack_email_token_from_payload(data: dict, fallback: Optional[str] = None) -> Optional[str]:
    subscription = data.get("subscription")
    if isinstance(subscription, dict):
        return subscription.get("email_token") or fallback
    return data.get("email_token") or fallback


async def _mark_subscription_paid_from_paystack(db, subscription: dict, data: dict, event: str = "charge.success") -> dict:
    now = utcnow()
    cycle = subscription.get("billing_cycle") or "monthly"
    next_billing = _subscription_period_end_from_cycle(cycle, now)
    authorization = data.get("authorization") or {}
    customer = data.get("customer") or {}
    plan = data.get("plan") or {}
    updates = {
        "status": "active",
        "payment_method": "paystack",
        "last_payment_status": "paid",
        "last_payment_at": now,
        "current_period_start": now,
        "next_billing_date": next_billing,
        "paystack_customer_code": customer.get("customer_code") or subscription.get("paystack_customer_code"),
        "paystack_authorization_code": authorization.get("authorization_code") or subscription.get("paystack_authorization_code"),
        "paystack_plan_code": _paystack_plan_code_from_payload(data, subscription.get("paystack_plan_code")),
        "paystack_subscription_code": _paystack_subscription_code_from_payload(data, subscription.get("paystack_subscription_code")),
        "paystack_email_token": _paystack_email_token_from_payload(data, subscription.get("paystack_email_token")),
        "paystack_last_event": event,
        "paystack_synced_at": now,
        "updated_at": now,
    }
    access = _subscription_access_from_status("active", subscription.get("owner_type") or "creator")
    updates.update(access)
    await db.account_subscriptions.update_one({"id": subscription["id"]}, {"$set": iso_dates(updates)})
    doc = await db.account_subscriptions.find_one({"id": subscription["id"]}, {"_id": 0})
    await _sync_owner_subscription_status(db, doc)
    return doc


async def _mark_subscription_failed_from_paystack(db, subscription: dict, event: str, payload: dict) -> dict:
    updates = {
        "status": "past_due",
        "last_payment_status": "failed",
        "paystack_last_event": event,
        "paystack_synced_at": utcnow(),
        "updated_at": utcnow(),
    }
    access = _subscription_access_from_status("past_due", subscription.get("owner_type") or "creator")
    updates.update(access)
    await db.account_subscriptions.update_one({"id": subscription["id"]}, {"$set": iso_dates(updates)})
    doc = await db.account_subscriptions.find_one({"id": subscription["id"]}, {"_id": 0})
    await _sync_owner_subscription_status(db, doc)
    return doc


