def customer_order_timeline(order: dict) -> List[dict]:
    status = order.get("status") or "pending_payment"
    status_order = [
        "pending_payment",
        "paid",
        "sent_to_printer",
        "in_production",
        "ready_for_dispatch",
        "shipped",
        "completed",
    ]
    current_index = status_order.index(status) if status in status_order else 1
    if status in ("cancelled", "refunded"):
        current_index = -1

    steps = [
        {"key": "pending_payment", "label": "Order placed", "description": "We received your order details."},
        {"key": "paid", "label": "Payment received", "description": "Your order is confirmed."},
        {"key": "sent_to_printer", "label": "Sent to production", "description": "The production team has the artwork and product details."},
        {"key": "in_production", "label": "Being made", "description": "Your item is currently in production."},
        {"key": "ready_for_dispatch", "label": "Ready for dispatch", "description": "Your order is being prepared for collection/courier."},
        {"key": "shipped", "label": "On the way", "description": "Your order has been dispatched."},
        {"key": "completed", "label": "Completed", "description": "Your order has been completed."},
    ]

    for idx, step in enumerate(steps):
        step["complete"] = current_index >= idx
        step["current"] = current_index == idx

    if status in ("cancelled", "refunded"):
        steps.append({
            "key": status,
            "label": customer_order_status_label(status),
            "description": "This order is no longer active.",
            "complete": True,
            "current": True,
        })

    return steps


def order_item_customer_image(item: dict) -> str:
    design = ((item.get("customization") or {}).get("design_json") or {})
    snapshot = item.get("production_snapshot") or {}
    return (
        (item.get("customization") or {}).get("preview_image")
        or item.get("mockup_url")
        or item.get("mockup_image_url")
        or item.get("primary_mockup_image_url")
        or snapshot.get("mockup_image_url")
        or snapshot.get("primary_mockup_image_url")
        or ((snapshot.get("artwork") or {}).get("mockup_image_url"))
        or ((design.get("mockup_images") or [""])[0] if isinstance(design.get("mockup_images"), list) and design.get("mockup_images") else "")
        or ((item.get("mockup_images") or [""])[0] if isinstance(item.get("mockup_images"), list) and item.get("mockup_images") else "")
        or ""
    )


def order_item_customer_variation_label(item: dict) -> str:
    design = ((item.get("customization") or {}).get("design_json") or {})
    if design.get("variation_label"):
        return design["variation_label"]
    snapshot = item.get("production_snapshot") or {}
    variation = snapshot.get("variation") or {}
    if variation.get("label"):
        return variation["label"]
    attrs = variation.get("attributes") or design.get("attribute_values") or item.get("attribute_values") or {}
    attr_label = " / ".join([f"{k}: {v}" for k, v in attrs.items() if str(v).strip()])
    if attr_label:
        return attr_label
    return " / ".join([part for part in [item.get("size"), item.get("color")] if part]) or "Selected variation"


