    user: User = Depends(get_current_user),
):
    db = request.app.state.db
    creator = await get_creator_account_for_user(db, user)

    orders = await db.orders.find(
        {"items.band_id": creator["id"], "payment_status": "paid"},
        {"_id": 0},
    ).to_list(10000)

    total_sales = 0.0
    total_earnings = 0.0
    total_commission = 0.0
    order_count = 0

    for o in orders:
        for item in o["items"]:
            if item["band_id"] == creator["id"]:
                total_sales += item["unit_price"] * item["quantity"]
                total_earnings += item["band_earnings"]
                total_commission += item["commission_amount"]
        order_count += 1

    product_count = await db.products.count_documents({"band_id": creator["id"]})

    return {
        "total_sales": round(total_sales, 2),
        "total_earnings": round(total_earnings, 2),
        "total_commission": round(total_commission, 2),
        "order_count": order_count,
        "product_count": product_count,
        "subscription_status": creator.get("subscription_status"),
    }


