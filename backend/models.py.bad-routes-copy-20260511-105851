@bands_router.get("/me/users")
async def list_creator_users(
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db
    band = await get_creator_account_for_user(db, user, permission="manage_members")

    owner_doc = await db.users.find_one({"id": band["user_id"]}, {"_id": 0})
    members = await db.band_members.find({"band_id": band["id"]}, {"_id": 0}).to_list(500)

    user_ids = [m["user_id"] for m in members]
    user_docs = await db.users.find({"id": {"$in": user_ids}}, {"_id": 0}).to_list(500)
    users_by_id = {u["id"]: clean_user_doc(u) for u in user_docs}

    out = []

    if owner_doc:
        out.append({
            "membership_id": None,
            "user": clean_user_doc(owner_doc),
            "role": "owner",
            "permissions": ["*"],
            "status": "active",
            "is_owner": True,
        })

    for member in members:
        member_user = users_by_id.get(member["user_id"])
        if not member_user:
            continue

        out.append({
            "membership_id": member["id"],
            "user": member_user,
            "role": member.get("role", "viewer"),
            "permissions": member.get("permissions", []),
            "status": member.get("status", "active"),
            "is_owner": False,
        })

    return out


@bands_router.post("/me/users")
async def add_creator_user(
    payload: CreatorMemberCreate,
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db
    band = await get_creator_account_for_user(db, user, permission="manage_members")

    validate_creator_member_role(payload.role)
    validate_creator_member_permissions(payload.permissions)

    email = normalize_email(payload.email)
    if not email:
        raise HTTPException(status_code=400, detail="Email is required")

    existing_user = await db.users.find_one({"email": email}, {"_id": 0})

    if not existing_user:
        if not payload.password:
            raise HTTPException(status_code=400, detail="Password required when creating a new user")

        new_user = User(
            email=email,
            name=payload.name or email.split("@")[0],
            role="band",
            status="active",
        )

        doc = new_user.model_dump()
        doc["created_at"] = doc["created_at"].isoformat()
        doc["password_hash"] = hash_password(payload.password)

        await db.users.insert_one(doc)
        existing_user = doc
    else:
        if existing_user.get("role") == "buyer":
            await db.users.update_one({"id": existing_user["id"]}, {"$set": {"role": "band"}})
            existing_user["role"] = "band"

    if existing_user["id"] == band["user_id"]:
        raise HTTPException(status_code=400, detail="User is already the owner of this creator account")

    existing_member = await db.band_members.find_one({
        "band_id": band["id"],
        "user_id": existing_user["id"],
    })

    if existing_member:
        raise HTTPException(status_code=400, detail="User is already added to this creator account")

    member = {
        "id": uid(),
        "band_id": band["id"],
        "user_id": existing_user["id"],
        "role": payload.role,
        "permissions": payload.permissions,
        "status": "active",
        "created_at": utcnow().isoformat(),
    }

    await db.band_members.insert_one(member)

    return {
        "membership_id": member["id"],
        "user": clean_user_doc(existing_user),
        "role": member["role"],
        "permissions": member["permissions"],
        "status": member["status"],
        "is_owner": False,
    }


@bands_router.patch("/me/users/{member_user_id}")
async def update_creator_user(
    member_user_id: str,
    payload: CreatorMemberUpdate,
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db
    band = await get_creator_account_for_user(db, user, permission="manage_members")

    if member_user_id == band["user_id"]:
        raise HTTPException(status_code=400, detail="Owner permissions cannot be changed here")

    member = await db.band_members.find_one(
        {"band_id": band["id"], "user_id": member_user_id},
        {"_id": 0},
    )

    if not member:
        raise HTTPException(status_code=404, detail="Creator member not found")

    updates = payload.model_dump(exclude_none=True)

    if "role" in updates:
        validate_creator_member_role(updates["role"])

    if "status" in updates:
        validate_user_status(updates["status"])

    if "permissions" in updates:
        validate_creator_member_permissions(updates["permissions"])

    if not updates:
        raise HTTPException(status_code=400, detail="Nothing to update")

    await db.band_members.update_one(
        {"band_id": band["id"], "user_id": member_user_id},
        {"$set": updates},
    )

    updated = await db.band_members.find_one(
        {"band_id": band["id"], "user_id": member_user_id},
        {"_id": 0},
    )
    member_user = await db.users.find_one({"id": member_user_id}, {"_id": 0})

    return {
        "membership_id": updated["id"],
        "user": clean_user_doc(member_user),
        "role": updated.get("role", "viewer"),
        "permissions": updated.get("permissions", []),
        "status": updated.get("status", "active"),
        "is_owner": False,
    }


