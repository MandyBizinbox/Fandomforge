            "variations": [
                ProductVariation(size="M", color="Black"),
                ProductVariation(size="L", color="Black"),
                ProductVariation(size="XL", color="Black"),
            ],
        })

    product = Product(
        **payload.model_dump(),
        band_id=band["id"],
        slug=slug,
        assigned_printer_id=default_printer["id"] if default_printer else None,
    )

