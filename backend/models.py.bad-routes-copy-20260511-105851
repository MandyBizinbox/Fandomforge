@admin_router.patch("/product-templates/{template_id}", response_model=ProductTemplate)
async def admin_update_product_template(
    template_id: str,
    payload: ProductTemplateUpdate,
    request: Request,
    user: User = Depends(require_role("super_admin")),
):
    db = request.app.state.db
    existing = await db.product_templates.find_one({"id": template_id}, {"_id": 0})

    if not existing:
        raise HTTPException(status_code=404, detail="Product template not found")

    updates = payload.model_dump(exclude_none=True)

    if not updates:
        raise HTTPException(status_code=400, detail="Nothing to update")

    merged = {**existing, **updates}
    normalized = normalize_template_payload(merged)
    normalized["updated_at"] = utcnow().isoformat()

    slug_owner = await db.product_templates.find_one(
        {"slug": normalized["slug"], "id": {"$ne": template_id}},
        {"_id": 0},
    )
    if slug_owner:
        raise HTTPException(status_code=400, detail="Another product template already uses this slug")

    await db.product_templates.update_one({"id": template_id}, {"$set": normalized})
    doc = await db.product_templates.find_one({"id": template_id}, {"_id": 0})
    return ProductTemplate(**doc)


