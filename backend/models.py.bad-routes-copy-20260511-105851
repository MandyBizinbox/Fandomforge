@bands_router.post("", response_model=Band)
async def create_band(
    payload: BandCreate,
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db

    existing = await db.bands.find_one({"user_id": user.id}, {"_id": 0})
    if existing:
        raise HTTPException(status_code=400, detail="You already have a creator profile")

    slug = slugify(payload.slug or payload.name)
    if await db.bands.find_one({"slug": slug}, {"_id": 0}):
