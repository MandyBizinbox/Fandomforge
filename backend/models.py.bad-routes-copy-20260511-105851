async def _build_order_items(db, items: List[CartItem]) -> tuple[List[OrderItem], float]:
    out: List[OrderItem] = []
    subtotal = 0.0
    settings_doc = await db.settings.find_one({"id": "platform"}, {"_id": 0})
    default_rate = (settings_doc or {}).get("default_commission_rate", 0.15)

    for ci in items:
        product = await db.products.find_one({"id": ci.product_id}, {"_id": 0})
        if not product:
            raise HTTPException(status_code=400, detail=f"Product not found: {ci.product_id}")

        band = await db.bands.find_one({"id": product["band_id"]}, {"_id": 0})
        rate = (band or {}).get("commission_rate", default_rate)

        unit_price = float(product["selling_price"])
        for v in product.get("variations", []) or []:
            if v.get("id") == ci.variation_id and v.get("price_override") is not None:
                unit_price = float(v["price_override"])
                break

        print_cost = float(product["print_cost"])
        commission_amount = round(unit_price * rate, 2)
        band_earnings = round(unit_price - print_cost - commission_amount, 2)
        printer_payout = round(print_cost, 2)

        oi = OrderItem(
            product_id=product["id"],
            product_title=product["title"],
            band_id=product["band_id"],
            printer_id=product.get("assigned_printer_id"),
            variation_id=ci.variation_id,
            size=ci.size,
            color=ci.color,
            quantity=ci.quantity,
            unit_price=unit_price,
            print_cost_unit=print_cost,
            commission_rate=rate,
            commission_amount=commission_amount * ci.quantity,
            band_earnings=band_earnings * ci.quantity,
            printer_payout=printer_payout * ci.quantity,
            customization=ci.customization,
            artwork_file_url=None,
        )

        art = await db.artworks.find_one(
            {"product_id": product["id"], "status": "approved"},
            {"_id": 0},
        )

        if art:
            oi.artwork_file_url = art["file_url"]

        subtotal += unit_price * ci.quantity
        out.append(oi)

    return out, round(subtotal, 2)


@orders_router.post("/checkout", response_model=dict)
async def checkout(
    payload: CheckoutRequest,
    request: Request,
    user: User = Depends(optional_user),
):
    db = request.app.state.db

    if not payload.items:
        raise HTTPException(status_code=400, detail="Cart is empty")

    order_items, subtotal = await _build_order_items(db, payload.items)

    order = Order(
        buyer_id=user.id if user else None,
        buyer_email=payload.shipping_address.email,
        items=order_items,
        subtotal=subtotal,
        total=subtotal,
        shipping_address=payload.shipping_address,
        payment_provider=payload.payment_provider,
    )

    doc = order.model_dump()
    doc["created_at"] = doc["created_at"].isoformat()
    doc["updated_at"] = doc["updated_at"].isoformat()
    await db.orders.insert_one(doc)

    ref = new_reference()
    provider = get_provider(payload.payment_provider)
    base = str(request.base_url).rstrip("/")

    init = provider.initiate(
        amount=order.total,
        description=f"MerchForge Order {order.order_number}",
        reference=ref,
        return_url=f"{base}/order-confirmation/{order.id}",
        cancel_url=f"{base}/cart",
        notify_url=f"{base}/api/payments/webhook?provider={payload.payment_provider}",
        email=order.buyer_email,
    )

    payment = Payment(
        order_id=order.id,
        user_id=user.id if user else None,
        amount=order.total,
        provider=init["provider"],
        provider_reference=ref,
        status="pending",
        kind="order",
    )

    await db.payments.insert_one(iso_dates(payment.model_dump()))
    await db.orders.update_one({"id": order.id}, {"$set": {"payment_id": payment.id}})

    return {
        "order_id": order.id,
        "order_number": order.order_number,
        "payment_url": init["payment_url"],
        "provider": init["provider"],
        "reference": ref,
        "total": order.total,
    }


@orders_router.post("/{order_id}/mock-complete", response_model=Order)
async def mock_complete(
    order_id: str,
    request: Request,
):
    """MVP helper - simulates a successful payment. Replace with real webhook in production."""
    db = request.app.state.db

    order = await db.orders.find_one({"id": order_id}, {"_id": 0})
    if not order:
        raise HTTPException(status_code=404, detail="Order not found")

    if order["payment_status"] == "paid":
        return Order(**order)

    now = datetime.now(timezone.utc).isoformat()

    await db.orders.update_one(
        {"id": order_id},
        {"$set": {"payment_status": "paid", "status": "sent_to_printer", "updated_at": now}},
    )

    if order.get("payment_id"):
        await db.payments.update_one(
            {"id": order["payment_id"]},
            {"$set": {"status": "completed", "completed_at": now}},
        )

    for item in order["items"]:
        await db.commissions.insert_one(iso_dates(Commission(
            order_id=order_id,
            order_item_id=item["id"],
            band_id=item["band_id"],
            amount=item["commission_amount"],
            rate=item["commission_rate"],
        ).model_dump()))

        if item.get("printer_id"):
            await db.payouts.insert_one(iso_dates(Payout(
                printer_id=item["printer_id"],
                order_id=order_id,
                order_item_id=item["id"],
                amount=item["printer_payout"],
            ).model_dump()))

    doc = await db.orders.find_one({"id": order_id}, {"_id": 0})
    return Order(**doc)


