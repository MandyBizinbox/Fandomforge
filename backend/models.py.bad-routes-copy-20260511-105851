@products_router.patch("/{product_id}", response_model=Product)
async def update_product(
    product_id: str,
    payload: ProductUpdate,
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db
    product = await db.products.find_one({"id": product_id}, {"_id": 0})

    if not product:
        raise HTTPException(status_code=404, detail="Product not found")

    band = await get_band_for_product_access(db, user, product, permission="manage_products")
    if not band:
        raise HTTPException(status_code=403, detail="Not your product")

    updates = payload.model_dump(exclude_none=True)

    if updates.get("published"):
        if band.get("subscription_status") != "active" and user.role != "super_admin":
            raise HTTPException(status_code=400, detail="Active subscription required to publish")

        artwork = await db.artworks.find_one(
            {"product_id": product_id, "status": "approved"},
            {"_id": 0},
        )

        if not artwork and user.role != "super_admin":
            raise HTTPException(status_code=400, detail="Product needs approved artwork to publish")

    if "variations" in updates:
        updates["variations"] = [
            v if isinstance(v, dict) else v.model_dump()
            for v in updates["variations"]
        ]

    if not updates:
        raise HTTPException(status_code=400, detail="Nothing to update")

    await db.products.update_one({"id": product_id}, {"$set": updates})
    doc = await db.products.find_one({"id": product_id}, {"_id": 0})
    return Product(**doc)


@products_router.delete("/{product_id}")
async def delete_product(
    product_id: str,
    request: Request,
    user: User = Depends(get_current_user),
):
    db = request.app.state.db
    product = await db.products.find_one({"id": product_id}, {"_id": 0})

    if not product:
        raise HTTPException(status_code=404, detail="Not found")

    allowed = await user_can_access_band(db, user, product["band_id"], permission="manage_products")
    if not allowed:
        raise HTTPException(status_code=403, detail="Not your product")

    await db.products.delete_one({"id": product_id})
    await db.artworks.delete_many({"product_id": product_id})

    return {"status": "deleted"}


