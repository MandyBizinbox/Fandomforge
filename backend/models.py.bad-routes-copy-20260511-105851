print_options_router = APIRouter(prefix="/print-options")


def normalize_print_option_payload(data: dict) -> dict:
    data = dict(data)
    method = (data.get("print_method") or "").strip()
    size = (data.get("print_size") or "").strip()

    if not method:
        raise HTTPException(status_code=400, detail="Print method is required")

    if not size:
        raise HTTPException(status_code=400, detail="Print size is required")

    data["print_method"] = method
    data["print_size"] = size
    data["print_positions"] = [
        str(position).strip()
        for position in data.get("print_positions", [])
        if str(position).strip()
    ]
    data["print_cost_max"] = float(data.get("print_cost_max") or 0)
    data["slug"] = slugify(f"{method}-{size}")
    return data


@print_options_router.get("", response_model=List[PrintOption])
async def list_print_options(
    request: Request,
    status: Optional[str] = None,
):
    db = request.app.state.db
    q: Dict = {}

    if status:
        q["status"] = status

    docs = await db.print_options.find(q, {"_id": 0}).sort("print_method", 1).to_list(500)
    return [PrintOption(**d) for d in docs]


@print_options_router.post("", response_model=PrintOption)
async def create_print_option(
    payload: PrintOptionCreate,
    request: Request,
    user: User = Depends(require_role("super_admin")),
):
    db = request.app.state.db
    data = normalize_print_option_payload(payload.model_dump())
    now = utcnow()

    existing = await db.print_options.find_one({"slug": data["slug"]}, {"_id": 0})
    if existing:
        raise HTTPException(status_code=400, detail="Print option already exists")

    option = PrintOption(**data, created_at=now, updated_at=now)
    await db.print_options.insert_one(iso_dates(option.model_dump()))
    return option


@print_options_router.patch("/{option_id}", response_model=PrintOption)
async def update_print_option(
    option_id: str,
    payload: PrintOptionUpdate,
    request: Request,
    user: User = Depends(require_role("super_admin")),
):
    db = request.app.state.db
    existing = await db.print_options.find_one({"id": option_id}, {"_id": 0})

    if not existing:
        raise HTTPException(status_code=404, detail="Print option not found")

    updates = payload.model_dump(exclude_none=True)
    if not updates:
        raise HTTPException(status_code=400, detail="Nothing to update")

    merged = {**existing, **updates}
    normalized = normalize_print_option_payload(merged)
    normalized["updated_at"] = utcnow().isoformat()

    slug_owner = await db.print_options.find_one(
        {"slug": normalized["slug"], "id": {"$ne": option_id}},
        {"_id": 0},
    )
    if slug_owner:
        raise HTTPException(status_code=400, detail="Another print option already uses this method/size")

    await db.print_options.update_one({"id": option_id}, {"$set": normalized})
    doc = await db.print_options.find_one({"id": option_id}, {"_id": 0})
    return PrintOption(**doc)


@print_options_router.delete("/{option_id}")
async def delete_print_option(
    option_id: str,
    request: Request,
    force: bool = False,
    user: User = Depends(require_role("super_admin")),
):
    db = request.app.state.db
    linked_templates = await db.product_templates.count_documents({"print_option_ids": option_id})

    if linked_templates and not force:
        await db.print_options.update_one(
            {"id": option_id},
            {"$set": {"status": "archived", "updated_at": utcnow().isoformat()}},
        )
        return {"status": "archived", "linked_templates": linked_templates}

    await db.print_options.delete_one({"id": option_id})
    return {"status": "deleted", "linked_templates": linked_templates}


